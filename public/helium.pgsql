26	page	Projects Gallery	学生项目	Projects Gallery	学生项目	projects	{"root":{"props":{"title":"Projects Gallery"},"type":"root"},"content":[{"type":"HeroConfig","props":{"title":"Projects Gallery","backgroundColor":"#103c74","lightText":true,"topPadding":true,"id":"HeroConfig-5831f321-5294-4ec4-9f67-9c6548e5c224","resolvedImage":{"id":65,"sha1":"29587e370b2cc9463b8858e7c81b0f51418f5759","name":"Student Projects","altText":"BAID students' ocean protection project","width":1920,"height":1039,"sizeKB":102,"uploaderId":3406762,"createdAt":"2025-12-22T13:31:36.244Z"},"resolvedUploadPrefix":"/uploads","image":"65"}},{"type":"SpacerConfig","props":{"height":"5rem","id":"SpacerConfig-697e4e11-ab96-4d9e-a5e5-4e26367a50d3"}},{"type":"TopTextConfig","props":{"title":"A better world starts here","text":"At BAID, our students bring their passions to life through projects that solve real problems and make the world a little better—one innovation at a time.","to":"","linkText":"","id":"TopTextConfig-f072224a-cf31-407d-aca3-1a815ce8a02b"}},{"type":"SpacerConfig","props":{"height":"5rem","id":"SpacerConfig-03bf3f6b-f182-4c62-a252-36bd66a8a1bb"}},{"type":"FeaturedProjectsConfig","props":{"title":"Featured Project","id":"FeaturedProjectsConfig-ca1bbb91-09dd-4e65-aa47-b97659aafc20","resolvedProjects":[{"quote":"It was at that point when I realized that they are human too. They deserve to be treated with the same dignity as I treat my peers. I thought I was helping them, but I was really just looking down on them.","name":"Someone, Class of 2027","link":"","linkText":"Learn about a transformed perspective","image":{"id":13,"sha1":"3deaf54f489a33abc0c47cfbc989afdc5645caf0","name":"test","altText":"test","width":2117,"height":2823,"sizeKB":456,"uploaderId":3406762,"createdAt":"2025-10-14T05:24:36.595Z"}}],"resolvedUploadPrefix":"/uploads","projects":[{"project":{"id":3,"title":"奥里导航","createdAt":{},"slug":"orinav"},"quote":"It was at that point when I realized that they are human too. They deserve to be treated with the same dignity as I treat my peers. I thought I was helping them, but I was really just looking down on them.","name":"Someone, Class of 2027","image":"13","linkText":"Learn about a transformed perspective"}]}},{"type":"ProjectCategoryConfig","props":{"id":"ProjectCategoryConfig-2ad2175f-ff0b-4edf-9522-8f482e3c5174","resolvedProjectsInit":[{"categoryEN":"Agriculture","categoryZH":"农业","projects":{"items":[{"id":6,"type":"project","titlePublishedEN":"PestaCheck","titlePublishedZH":"PestaCheck","titleDraftEN":"PestaCheck","titleDraftZH":"PestaCheck","shortContentPublishedEN":null,"shortContentPublishedZH":null,"shortContentDraftEN":null,"shortContentDraftZH":null,"slug":"pestacheck","categoryEN":"Agriculture","categoryZH":"农业","coverImagePublished":{"id":1,"sha1":"f40b221f579b431b8af177ca929b5c3200e0aa22","name":"Test","altText":"Test","width":5616,"height":3744,"sizeKB":615,"uploaderId":3406762,"createdAt":"2025-10-09T00:29:57.861Z"},"coverImageDraft":{"id":1,"sha1":"f40b221f579b431b8af177ca929b5c3200e0aa22","name":"Test","altText":"Test","width":5616,"height":3744,"sizeKB":615,"uploaderId":3406762,"createdAt":"2025-10-09T00:29:57.861Z"},"creator":{"id":3406762,"name":"蔺东来 Lin","pinyin":"Lin Donglai","roles":["admin","writer","editor"],"type":"student","gender":"male","createdAt":"2025-10-09T00:27:24.124Z","updatedAt":"2025-12-22T12:22:16.336Z"},"createdAt":"2025-10-14T02:57:15.037Z","updatedAt":"2025-10-14T02:57:32.996Z"}],"page":0,"pages":1}},{"categoryEN":"Science, Technology, and Society","categoryZH":"科技与社会","projects":{"items":[{"id":3,"type":"project","titlePublishedEN":"Orinav","titlePublishedZH":"奥里导航","titleDraftEN":"Orinav","titleDraftZH":"奥里导航","shortContentPublishedEN":null,"shortContentPublishedZH":"","shortContentDraftEN":null,"shortContentDraftZH":"","slug":"orinav","categoryEN":"Science, Technology, and Society","categoryZH":"科技与社会","coverImagePublished":{"id":1,"sha1":"f40b221f579b431b8af177ca929b5c3200e0aa22","name":"Test","