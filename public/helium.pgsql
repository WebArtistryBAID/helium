2T13:31:36.244Z"},"resolvedUploadPrefix":"/uploads","image":"65"}},{"type":"SpacerConfig","props":{"height":"5rem","id":"SpacerConfig-697e4e11-ab96-4d9e-a5e5-4e26367a50d3"}},{"type":"TopTextConfig","props":{"title":"世界因我更美好","text":"在 BAID，我们的学生用真实项目解决生活中的实际问题，让世界从一点一滴的创新中愈发美好。","to":"","linkText":"","id":"TopTextConfig-f072224a-cf31-407d-aca3-1a815ce8a02b"}},{"type":"SpacerConfig","props":{"height":"5rem","id":"SpacerConfig-03bf3f6b-f182-4c62-a252-36bd66a8a1bb"}},{"type":"FeaturedProjectsConfig","props":{"title":"精选项目","id":"FeaturedProjectsConfig-ca1bbb91-09dd-4e65-aa47-b97659aafc20","resolvedProjects":[{"quote":"那时候，我意识到，原来他们也是人。我对他们应该像对待自己的同学一样尊重。我以为我是在帮助他们；其实，我是在居高临下。","name":"Someone, 2027 届","link":"","linkText":"了解他的新视角","image":{"id":13,"sha1":"3deaf54f489a33abc0c47cfbc989afdc5645caf0","name":"test","altText":"test","width":2117,"height":2823,"sizeKB":456,"uploaderId":3406762,"createdAt":"2025-10-14T05:24:36.595Z"}}],"resolvedUploadPrefix":"/uploads","projects":[{"project":{"id":3,"title":"奥里导航","createdAt":{},"slug":"orinav"},"quote":"那时候，我意识到，原来他们也是人。我对他们应该像对待自己的同学一样尊重。我以为我是在帮助他们；其实，我是在居高临下。","name":"Someone, 2027 届","image":"13","linkText":"了解他的新视角"}]}},{"type":"ProjectCategoryConfig","props":{"id":"ProjectCategoryConfig-2ad2175f-ff0b-4edf-9522-8f482e3c5174","resolvedProjectsInit":[{"categoryEN":"Agriculture","categoryZH":"农业","projects":{"items":[{"id":6,"type":"project","titlePublishedEN":"PestaCheck","titlePublishedZH":"PestaCheck","titleDraftEN":"PestaCheck","titleDraftZH":"PestaCheck","shortContentPublishedEN":null,"shortContentPublishedZH":null,"shortContentDraftEN":null,"shortContentDraftZH":null,"slug":"pestacheck","categoryEN":"Agriculture","categoryZH":"农业","coverImagePublished":{"id":1,"sha1":"f40b221f579b431b8af177ca929b5c3200e0aa22","name":"Test","altText":"Test","width":5616,"height":3744,"sizeKB":615,"uploaderId":3406762,"createdAt":"2025-10-09T00:29:57.861Z"},"coverImageDraft":{"id":1,"sha1":"f40b221f579b431b8af177ca929b5c3200e0aa22","nam