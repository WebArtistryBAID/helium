d":57,"sha1":"703fad80fa70a720ce00cf5a6ea5483f4203ea41","name":"微信导入","altText":"由微信文章导入","width":886,"height":886,"sizeKB":73,"uploaderId":3406762,"createdAt":"2025-10-14T09:25:35.537Z"},"coverImageDraft":{"id":57,"sha1":"703fad80fa70a720ce00cf5a6ea5483f4203ea41","name":"微信导入","altText":"由微信文章导入","width":886,"height":886,"sizeKB":73,"uploaderId":3406762,"createdAt":"2025-10-14T09:25:35.537Z"},"creator":{"id":3406762,"name":"蔺东来 Lin","pinyin":"Lin Donglai","roles":["admin","writer","editor"],"type":"student","gender":"male","createdAt":"2025-10-09T00:27:24.124Z","updatedAt":"2025-12-22T12:22:16.336Z"},"createdAt":"2025-08-29T00:00:00.000Z","updatedAt":"2025-10-14T09:26:10.757Z"}]}},{"type":"BentoBoxConfig","props":{"title":"一览 BAID","motto":"世界因我更美好","mottoText":"我们的校训，也是我们一切行动的指南","admissionsTitle":"优异的升学结果","admissionsText":"自 2017 年成立以来，北京中学国际部的学生已被哈佛、斯坦福、牛津、剑桥、麦吉尔、香港大学、东京大学等世界顶尖大学录取。","facultyTitle":"优秀师资队伍","facultyText":"93% 具有硕博学位","countriesTitle":"来自北京 面向世界","countriesText":"今年，北京中学国际部的毕业生将前往六个国家和地区继续深造。","academicsTitle":"学术卓越","academicsText":"北京中学国际部提供二十多门 AP 课程、本科级别课程、MFP 科研项目和项目式学习，全面支持学生为大学和未来发展做好准备。","lifeText":"享受人生的青葱年华","diversityText":"来自七个国家的教师团队","id":"BentoBoxConfig-a3c5ddf4-6ac8-469d-b36e-69959beef1a2"}},{"type":"SpacerConfig","props":{"height":"4rem","id":"SpacerConfig-0f0439aa-93e4-4eef-8db7-d988fb85bab6"}},{"type":"HighlightsConfig","props":{"id":"HighlightsConfig-7c988f0a-b782-45f3-bf3e-b8645e433648","resolvedHighlights":[{"title":"初中项目","text":"初中项目以剑桥课程体系为基础，注重学科基础与探究学习，帮助学生建立清晰的知识结构与学习方法。","image":{"id":67,"sha1":"97e9fc13e8bc414ec93c58b64d599ba5ca85b7df","name":"Buldng of Dongba Campus","altText":"Buldng of Dongba Campus","width":3840,"height":2560,"sizeKB":1108,"uploaderId":3406762,"createdAt":"2025-12-22T13:57:44.403Z"},"link":"/academics/middle-school","linkText":"初中项目"},{"title":"高中项目","text":"高中阶段以 AP 课程为主，为学生提供丰富、多元、有挑战性的课程选择，支持学生根据兴趣与方向开展深入学习。\\n","image":{"id":58,"sha1":"bf11bcc1a751cd8727e990649683c7963fffb0ca","name":"Academics Hero","altText":"People studying around a table","width":3000,"height":2000,"sizeKB":172,"uploaderId":3406762,"createdAt":"2025-12-22T12:44:30.095Z"},"link":"/academics/high-school","linkText":"高中项目"},{"title":"项目式学习","text":"多维素养的项目式学习课程支持学生不断拓宽视野、发掘兴趣、发展潜能，实现全面而有个性的成长。\\n","image":{"id":65,"sha1":"29587e370b2cc9463b8858e7c81b0f51418f5759","name":"Student Projects","altText":"BAID students' ocean protection project","width":1920,"height":1039,"sizeKB":102,"uploaderId":3406762,"createdAt":"2025-12-22T13:31:36.244Z"},"link":"/academics/pbl","linkText":"项目式学习"}],"resolvedUploadPrefix":"/uploads","highlights":[{"title":"初中项目","text":"初中项目以剑桥课程体系为基础，注重学科基础与探究学习，帮助学生建立清晰的知识结构与学习方法。","image":"67","link":"/academics/middle-school","linkText":"初中项目"},{"title":"高中项目","text":"高中阶段以 AP 课程为主，为学生提供丰富、多元、有挑战性的课程选择，支持学生根据兴趣与方向开展深入学习。\\n","image":"58","linkText":"高中项目","link":"/academics/high-school"},{"title":"项目式学习","text":"多维素养的项目式学习课程支持学生不断拓宽视野、发掘兴趣、发展潜能，实现全面而有个性的成长。\\n","image":"65","link":"/academics/pbl","linkText":"项目式学习"}]}},{"type":"SpacerConfig","props":{"height":"5rem","id":"SpacerConfig-78ae2799-2648-46e5-9971-5250503341c1"}},{"type":"ImageTextLayoutConfig","props":{"lightText":false,"inverseOrder":false,"id":"ImageTextLayoutConfig-f9c3e298-2163-4d5f-8de5-b3ad3288ad9a","resolvedImage":{"id":64,"sha1":"15f6901d80775583c340abba2d020f0ce28fbeb6","name":"Life at BAID","altText":"People playing football on the playground","width":3976,"height":2652,"sizeKB":431,"uploaderId":3406762,"createdAt":"2025-12-22T13:05:12.808Z"},"resolvedUploadPrefix":"/uploads","image":"64","topText":"智渊勇毅 似鲲鹏展其翼","title":"以严谨治学培育卓越的学术素养","link":"/academics","linkText":"了解我们的初中与高中项目","text":"BAID 建立了中国国家课程、AP 课程与特色项目相结合的课程体系。通过与世界知名学府合作的科研项目，每一位学生都能够从零到一完成自己的学术成果。"}},{"type":"ImageTextLayoutConfig","props":{"id":"ImageTextLayoutConfig-6d98b2f6-795d-471f-ad0f-8a245cb1c7ce","resolvedImage":{"id":58,"sha1":"bf11bcc1a751cd8727e990649683c7963fffb0ca","name":"Academics Hero","altText":"People studying around a table","width":3000,"height":2000,"sizeKB":172,"uploaderId":3406762,"createdAt":"2025-12-22T12:44:30.095Z"},"resolvedUploadPrefix":"/uploads","image":"58","topText":"终成中华砥柱 永作万方津梁","title":"在中西融通的教育中建立文化自信与世界视野","text":"校园汇聚来自世界各地的教师与学生，在多元文化的交流中激发思考、拓展眼界。以中国课程为根基，在北京文化探究项目与中华文化寻根之旅中，学生走入真实文化场景，理解传统、认识当代，在广阔世界中坚定文化认同。\\n","link":"/academics/pbl","linkText":"了解中西融通的多元素养课程","lightText":true,"inverseOrder":true,"backgroundColor":"#9f0612"}},{"type":"ImageTextLayoutConfig","props":{"lightText":true,"inverseOrder":false,"id":"ImageTextLayoutConfig-4399dfff-68b2-4c0c-98d8-f877e1d9aa77","resolvedImage":{"id":67,"sha1":"97e9fc13e8bc414ec93c58b64d599ba5ca85b7df","name":"Buldng of Dongba Campus","altText":"Buldng of Dongba Campus","width":3840,"height":2560,"sizeKB":1108,"uploaderId":3406762,"createdAt":"2025-12-22T13:57:44.403Z"},"resolvedUploadPrefix":"/uploads","image":"67","title":"让每一段校园经历都成为成长的养分","topText":"十一楼阁 聚紫气而纳千祥","text":"丰富多样的学生社团与选修课程，覆盖竞赛、学科、艺术、体育等各种方向。北中小舞台、北中小讲师等活动持续开展，为学生提供展示自我、表达观点的舞台，让每一次参与都成为成长的积淀。","link":"/life","linkText":"了解 BAID 的校园生活","backgroundColor":"#103c74"}},{"type":"ImageTextLayoutConfig","props":{"lightText":false,"inverseOrder":true,"id":"ImageTextLayoutConfig-0626afed-bac3-47ad-b37f-711559270077","resolvedImage":{"id":59,"sha1":"dfdbae4816a16dd1a41563aac9cf52ecfdf204ee","name":"BA Lectures","altText":"olympics gold medalist Yang Yang at an event","width":1080,"height":720,"sizeKB":68,"uploaderId":3406762,"createdAt":"2025-12-22T12:49:50.419Z"},"resolvedUploadPrefix":"/uploads","image":"59","topText":"德胜永定 学子怀寰宇之望","title":"在关怀他人中培养改变世界的能力","text":"我们的社区成员从身边问题出发，主动发起项目，将关怀落实为行动: 面向视障人士的导航软件、不羞耻卫生巾倡议、可持续发展社团等不断推进。在持续实践中，学生学会承担责任，也逐步形成影响他人与社会的能力。","link":"/projects","linkText":"了解 BAID 学子的自主项目"}},{"type":"ImageTextLayoutConfig","props":{"lightText":true,"inverseOrder":false,"id":"ImageTextLayoutConfig-3e3ad3af-f992-4adb-9ea8-90c96a816239","resolvedImage":{"id":11,"sha1":"c3362d9dcace9926f10970230152d0d4869e1448","name":"Test","altText":"Test","width":3840,"height":2563,"sizeKB":2517,"uploaderId":3406762,"createdAt":"2025-10-14T05:01:29.874Z"},"resolvedUploadPrefix":"/uploads","image":"11","title":"让每一位学生走向更高的平台","topText":"一方沃土 育四海之玲琅","text":"自 2017 年成立以来，BAID 学生持续收获亮眼升学成果，走向哈佛、斯坦福、牛津、剑桥、麦吉尔、香港大学、东京大学等世界一流学府，在更高的平台上继续探索与成长。","link":"/academics/college-counseling","linkText":"了解 BAID 的大学升学指导","backgroundColor":"#9f0612"}},{"type":"QuoteConfig","props":{"text":"我们会让校园成为师生的精神家园，让校园成为师生的学习中心，让校园成为师生的创新沃土，进而让孩子们能爱别人、帮助别人、尊重别人。","source":"北京中学校长 夏青峰","id":"QuoteConfig-291a5a3d-2df5-4f05-8cf1-64bc75987ff4","resolvedImage":{"id":10,"sha1":"b32b8acdc3a560f8264489a45ab7ee48d8a4a68b","name":"xqf","altText":"xqf","width":1920,"height":2880,"sizeKB":130,"uploaderId":3406762,"createdAt":"2025-10-14T03:25:23.284Z"},"resolvedUploadPrefix":"/uploads","image":"10"}}],"zones":{}}	{"root":{"props":{"title":"Home"},"type":"root"},"content":[{"type":"InFocusProjectsConfig","props":{"title":"Better Me, Better World","description":"\\"Better me, better world.\\" At Beijing Academy, our talented students and dedicated faculty embark on a journey of discovery, growth, and excellence, transforming the world for the better every step of the way.","link":"/projects","linkText":"Learn about how our students make a difference","startTopText":"Every Step, Every Change","startMainText":"It all starts at BAID.","id":"InFocusProjectsConfig-d955f31c-35c8-4bd3-a322-11926abc80e9","resolvedHeroBg":{"id":6,"sha1":"9942a41c5b79b01ed07566182c6e54e34b3079b7","name":"Test","altText":"Test","width":6016,"height":3384,"sizeKB":1204,"uploaderId":3406762,"createdAt":"2025-10-14T03:02:23.332Z"},"resolvedProjects":[{"project":{"id":3,"type":"project","titlePublishedEN":"Orinav","titlePublishedZH":"奥里导航","titleDraftEN":"Orinav","titleDraftZH":"奥里导航","shortContentPublishedEN":null,"shortContentPublishedZH":"","shortContentDraftEN":null,"shortContentDraftZH":"","slug":"orinav","categoryEN":"Science, Technology, and Society","categoryZH":"科