le","createdAt":{},"updatedAt":{}},"createdAt":{},"updatedAt":{}}},"title":"Some Teacher"},{"person":{"id":35,"title":"苑笑阳","createdAt":{},"slug":"yuan-xiaoyang","data":{"id":35,"type":"faculty","titlePublishedEN":"Yuan Xiaoyang","titlePublishedZH":"苑笑阳","titleDraftEN":"Yuan Xiaoyang","titleDraftZH":"苑笑阳","shortContentPublishedEN":"Who is Yuan Xiaoyang","shortContentPublishedZH":"苑笑阳是谁","shortContentDraftEN":"Who is Yuan Xiaoyang","shortContentDraftZH":"苑笑阳是谁","slug":"yuan-xiaoyang","categoryEN":null,"categoryZH":null,"coverImagePublished":{"id":10,"sha1":"b32b8acdc3a560f8264489a45ab7ee48d8a4a68b","name":"xqf","altText":"xqf","width":1920,"height":2880,"sizeKB":130,"uploaderId":3406762,"createdAt":{}},"coverImageDraft":{"id":10,"sha1":"b32b8acdc3a560f8264489a45ab7ee48d8a4a68b","name":"xqf","altText":"xqf","width":1920,"height":2880,"sizeKB":130,"uploaderId":3406762,"createdAt":{}},"creator":{"id":3406762,"name":"蔺东来 Lin","pinyin":"Lin Donglai","roles":["admin","writer","editor"],"type":"student","gender":"male","createdAt":{},"updatedAt":{}},"createdAt":{},"updatedAt":{}}},"title":"Some Teacher"},{"person":{"id":35,"title":"苑笑阳","createdAt":{},"slug":"yuan-xiaoyang","data":{"id":35,"type":"faculty","titlePublishedEN":"Yuan Xiaoyang","titlePublishedZH":"苑笑阳","titleDraftEN":"Yuan Xiaoyang","titleDraftZH":"苑笑阳","shortContentPublishedEN":"Who is Yuan Xiaoyang","shortContentPublishedZH":"苑笑阳是谁","shortContentDraftEN":"Who is Yuan Xiaoyang","shortContentDraftZH":"苑笑阳是谁","slug":"yuan-xiaoyang","categoryEN":null,"categoryZH":null,"coverImagePublished":{"id":10,"sha1":"b32b8acdc3a560f8264489a45ab7ee48d8a4a68b","name":"xqf","altText":"xqf","width":1920,"height":2880,"sizeKB":130,"uploaderId":3406762,"createdAt":{}},"coverImageDraft":{"id":10,"sha1":"b32b8acdc3a560f8264489a45ab7ee48d8a4a68b","name":"xqf","altText":"xqf","width":1920,"height":2880,"sizeKB":130,"uploaderId":3406762,"createdAt":{}},"creator":{"id":3406762,"name":"蔺东来 Lin","pinyin":"Lin Donglai","roles":["admin","writer","editor"],"type":"student","gender":"male","createdAt":{},"updatedAt":{}},"createdAt":{},"updatedAt":{}}},"title":"Some Teacher"}]}}],"contentWidth":true,"id":"ContainerConfig-6662057a-5709-4639-84a8-6083467da430"}},{"type":"SpacerConfig","props":{"height":"64px","id":"SpacerConfig-673557ea-0d76-4658-8ba9-0fbeaf628235"}},{"type":"ImageTextLayoutConfig","props":{"lightText":true,"inverseOrder":false,"id":"ImageTextLayoutConfig-40df52cf-e9ff-46bc-aa36-13ae4601821b","resolvedImage":{"id":64,"sha1":"15f6901d80775583c340abba2d020f0ce28fbeb6","name":"Life at BAID","altText":"People playing football on the playground","width":3976,"height":2652,"sizeKB":431,"uploaderId":3406762,"createdAt":"2025-12-22T13:05:12.808Z"},"resolvedUploadPrefix":"/uploads","image":"64","backgroundColor":"#103c74","topText":"Grade 9 - Grade 11","title":"College Counseling Seminars","text":"Starting in Grade 9, BAID offers weekly college counseling seminars led by each class's designated counselor. Topics include application systems, academic and activity planning, major exploration, and essay writing. BAID also invites admissions officers of top universities and experienced counselors to campus, while parent sessions help families better understand the admissions process."}},{"type":"ImageTextLayoutConfig","props":{"lightText":true,"inverseOrder":true,"id":"ImageTextLayoutConfig-6324bef1-dc1a-4b53-ae99-c642fcb0d0be","resolvedImage":{"id":58,"sha1":"bf11bcc1a751cd8727e990649683c7963fffb0ca","name":"Academics Hero","altText":"People studying around a table","width":3000,"height":2000,"sizeKB":172,"uploaderId":3406762,"createdAt":"2025-12-22T12:44:30.095Z"},"resolvedUploadPrefix":"/uploads","backgroundColor":"#9f0612","image":"58","topText":"Grade 9 - Grade 11","title":"One-on-One Counseling","text":"Each semester, counselors meet individually with every family to review academics, activities, interests, and goals. Through ongoing, personalized guidance, students prepare themselves for the next stage of college admissions."}},{"type":"ImageTextLayoutConfig","props":{"lightText":false,"inverseOrder":false,"id":"ImageTextLayoutConfig-29eb1175-bb2e-4878-9528-efe3d87a788b","resolvedImage":{"id":63,"sha1":"eca52c9f86f2410f111503f970426e6a0c2bd94b","name":"Bejng Culture Exploration Program","altText":"Test","width":1280,"height":853,"sizeKB":85,"uploaderId":3406762,"createdAt":"2025-12-22T12:50:56.539Z"},"resolvedUploadPrefix":"/uploads","topText":"Grade 9 - Grade 11","image":"63","title":"Standardized Testing Prep","text":"All students at BAID can take Integrated English, a course designed to support preparation for the TOEFL, SAT, and ACT. With guidance from experienced teachers, students build language skills and prepare efficiently for standardized testing right on campus.\\n"}},{"type":"ImageTextLayoutConfig","props":{"lightText":true,"inverseOrder":true,"id":"ImageTextLayoutConfig-fa2d46b7-6e29-456d-af64-42814af46374","resolvedImage":{"id":63,"sha1":"eca52c9f86f2410f111503f970426e6a0c2bd94b","name":"Bejng Culture Exploration Program","altText":"Test","width":1280,"height":853,"sizeKB":85,"uploaderId":3406762,"createdAt":"2025-12-22T12:50:56.539Z"},"resolvedUploadPrefix":"/uploads","backgroundColor":"#103c74","topText":"Grade 9 - Grade 11","title":"Rich Opportunities","image":"63","linkText":"Learn more about project opportunities at BAID","link":"/academics/pbl","text":"With more than 40 electives, over 50 student-led clubs, and project-based learning programs in collaboration with top universities in China, students have many ways to explore their interests in depth and build a distinctive profile highlighting what they love."}},{"type":"ImageTextLayoutConfig","props":{"lightText":true,"inverseOrder":false,"id":"ImageTextLayoutConfig-ea698bb2-93bf-4f30-aea2-8a00f1d95f63","resolvedImage":{"id":62,"sha1":"073e82273837daeeaeec0f2e8a4603b962cbb875","name":"BA World School","altText":"Test","width":1280,"height":960,"sizeKB":316,"uploaderId":3406762,"createdAt":"2025-12-22T12:50:43.209Z"},"resolvedUploadPrefix":"/uploads","topText":"Grade 11 - Grade 12","image":"62","backgroundColor":"#4f5b74","title":"Application Support","text":"Beginning in May of the application year, each student is matched with a college counselor and enter a more focused stage of preparation. Throughout the season, students meet multiple times a week with counselors to finalize college lists, improve essays, and refine application materials, with thoughtful guidance throughout the process."}},{"type":"SpacerConfig","props":{"height":"5rem","id":"SpacerConfig-91fb83f5-ad12-4d59-87a6-02c10fa90d53"}},{"type":"ContainerConfig","props":{"children":[{"type":"HeadingConfig","props":{"level":1,"size":"4xl","align":"center","bold":true,"italic":false,"color":"#000000","id":"HeadingConfig-89310637-f500-428b-9a37-028ba0d292d1","text":"College Counseling Activities"}}],"contentWidth":true,"id":"ContainerConfig-9c58a57c-57c3-42d1-8983-1ad04cf73b23"}},{"type":"NewsListConfig","props":{"id":"NewsListConfig-2b68c040-da2d-4ecc-9550-a8f599c80bb1","resolvedEntitiesInit":{"items":[],"page":0,"pages":0},"resolvedUploadPrefix":"/uploads","category":"college-admissions"}},{"type":"SpacerConfig","props":{"height":"5rem","id":"SpacerConfig-9cf58df2-64e7-45bc-839a-85c7ce3a5cfd"}}],"zones":{}}	{"root":{"props":{"title":"大学升学指导"},"type":"root"},"content":[{"type":"SpacerConfig","props":{"height":"5rem","id":"SpacerConfig-c575365b-c13f-41e1-b31a-c716a6308cc5"}},{"type":"HorizontalTopTextConfig","props":{"title":"发现最适合自己的大学","text":"在专业、兴趣与未来方向的交汇处，走向更适合自己的成长道路。","id":"HorizontalTopTextConfig-5aabc7eb-d8d8-4fc4-8569-2bba5c8e11b1"}},{"type":"SpacerConfig","props":{"height":"5rem","id":"SpacerConfig-174ad903-b58b-4fcf-b74f-285bb36697df"}},{"type":"HeroConfig","props":{"title":"College Counseling","backgroundColor":"#ffffff","lightText":false,"topPadding":false,"id":"HeroConfig-753790ff-6e87-41b9-976a-ece0e306b6f1","resolvedImage":{"id":59,"sha1":"dfdbae4816a16dd1a41563aac9cf52ecfdf204ee","name":"BA Lectures","altText":"olympics gold medalist Yang Yang at an event","width":1080,"height":720,"sizeKB":68,"uploaderId":3406762,"createdAt":"2025-12-22T12:49:50.419Z"},"resolvedUploadPrefix":"/uploads","image":"59"}},{"type":"SpacerConfig","props":{"height":"64px","id":"SpacerConfig-30b4144f-2819-4caf-b975-be3d4f4088e3"}},{"type":"TopTextConfig","props":{"title":"在最适合自己的大学逐梦远方","text":"自 2017 年建校以来，BAID 学生已陆续收获哈佛、斯坦福、宾夕法尼亚大学、加州理工大学、康奈尔大学、布朗大学、牛津大学、剑桥大学、墨尔本大学、香港大学、东京大学、多伦多大学等世界知名高校录取。\\n","to":"/temporary","linkText":"2026 届毕业生录取结果","id":"TopTextConfig-79a410b4-09b2-4f60-942c-4ae8a6cb737b"}},{"type":"SpacerConfig","props":{"height":"64px","id":"SpacerConfig-8947d4d0-6bea-4ace-a86f-c24867555a39"}},{"type":"ContainerConfig","props":{"children":[{"type":"HeadingConfig","props":{"level":1,"size":"4xl","align":"center","bold":true,"italic":false,"color":"#000000","id":"HeadingConfig-0c07340f-1146-4979-a4cc-78221964224c","text":"升学指导办公室"}},{"type":"SpacerConfig","props":{"height":"1.5rem","id":"SpacerConfig-c04ce276-199b-41ee-9183-544478b9aaeb"}},{"type":"PeopleConfig","props":{"id":"PeopleConfig-3980d602-7cc4-4e9f-b2cd-dcb5a2cc2b45","resolvedPeople":[{"id":35,"nameEN":"Yuan Xiaoyang","nameZH":"苑笑阳","title":"某一位教师","descriptionEN":"Who is Yuan Xiaoyang","descriptionZH":"苑笑阳是谁","link":"","image":{"id":10,"sha1":"b32b8acdc3a560f8264489a45ab7ee48d8a4a68b","name":"xqf","altText":"xqf","width":1920,"height":2880,"sizeKB":130,"uploaderId":3406762,"createdAt":{}}},{"id":35,"nameEN":"Yuan Xiaoyang","nameZH":"苑笑阳","title":"某一位教师","descriptionEN":"Who is Yuan Xiaoyang","descriptionZH":"苑笑阳是谁","link":"","image":{"id":10,"sha1":"b32b8acdc3a560f8264489a45ab7ee48d8a4a68b","name":"xqf","altText":"xqf","width":1920,"height":2880,"sizeKB":130,"uploaderId":3406762,"createdAt":{}}},{"id":35,"nameEN":"Yuan Xiaoyang","nameZH":"苑笑阳","title":"某一位教师","descriptionEN":"Who is Yuan Xiaoyang","descriptionZH":"苑笑阳是谁","link":"","image":{"id":10,"sha1":"b32b8acdc3a560f8264489a45ab7