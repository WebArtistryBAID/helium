:"测试","shortContentPublishedEN":null,"shortContentPublishedZH":null,"shortContentDraftEN":null,"shortContentDraftZH":null,"slug":"test","categoryEN":null,"categoryZH":null,"coverImagePublished":{"id":41,"sha1":"ee2e1d84dfb38564ce055978b58c9241d3cfeac8","name":"微信导入","altText":"由微信文章导入","width":1080,"height":1527,"sizeKB":112,"uploaderId":3406762,"createdAt":"2025-10-14T05:46:37.617Z"},"coverImageDraft":{"id":41,"sha1":"ee2e1d84dfb38564ce055978b58c9241d3cfeac8","name":"微信导入","altText":"由微信文章导入","width":1080,"height":1527,"sizeKB":112,"uploaderId":3406762,"createdAt":"2025-10-14T05:46:37.617Z"},"creator":{"id":3406762,"name":"蔺东来 Lin","pinyin":"Lin Donglai","roles":["admin","writer","editor"],"type":"student","gender":"male","createdAt":"2025-10-09T00:27:24.124Z","updatedAt":"2025-12-22T12:22:16.336Z"},"createdAt":"2025-10-14T09:10:44.512Z","updatedAt":"2025-10-14T09:11:00.015Z"}],"page":0,"pages":1},"resolvedUploadPrefix":"/uploads"}}],"zones":{}}	\N	\N	3406762	2026-03-23 05:33:11.356	2026-04-05 03:55:20.242	\N	\N	\N	\N	\N	\N
27	page	High School Admissions	高中项目招生	High School Admissions	高中项目招生	admissions/baid	{"root":{"props":{"title":"High School Admissions"},"type":"root"},"content":[{"type":"SpacerConfig","props":{"height":"5rem","id":"SpacerConfig-481f72a4-5baa-4cd9-8301-e50dd7a1a513"}},{"type":"HorizontalTopTextConfig","props":{"title":"Join us at BAID","text":"Rooted in strong academic training, BAID's high school program fosters critical thinking, research ability, and global citizenship, empowering students to keep growing through challenge and step into a bigger future.\\n","id":"HorizontalTopTextConfig-465de51b-1dfc-4557-8c5d-4cd8a7043b9d"}},{"type":"SpacerConfig","props":{"height":"5rem","id":"SpacerConfig-07a03e25-b738-46ac-9390-dc8a1382e4c5"}},{"type":"HeroConfig","props":{"title":"Admissions: BAID","backgroundColor":"#ffffff","lightText":false,"topPadding":false,"id":"HeroConfig-8efcdbe9-14f5-4225-ae9e-421095397d42","resolvedImage":{"id":66,"sha1":"7a822d9377fc189c33d4b60980ca3cf841c646b8","name":"Admssons","altText":"ppl plang basketball","width":4000,"height":2667,"sizeKB":321,"uploaderId":3406762,"createdAt":"2025-12-22T13:52:58.599Z"},"resolvedUploadPrefix":"/uploads","image":"66"}},{"type":"SpacerConfig","props":{"height":"64px","id":"SpacerConfig-bf83b0bb-6106-4d6b-85b5-108435bfdf56"}},{"type":"TopTextConfig","props":{"title":"Become who you want to be","text":"At BAID, learning and growth mark the beginning of something bigger. By bringing together China's national curriculum and the Advanced Placement (AP) program, BAID offers a richer way to learn. Students aim high, think deeply, and look ahead. They discover their strengths, engage with the world around them, and grow in a dynamic, diverse community full of possibility.","to":"","linkText":"","id":"TopTextConfig-50514fe6-5edc-436d-8a11-f88140004533"}},{"type":"StatisticsConfig","props":{"title":"BAID in Numbers","content":[{"name":"teacher-student ratio","value":"1:7"},{"name":"postgraduate faculty","value":"93%"},{"name":"average homeroom size","value":"~20"},{"name":"Advanced Placement (AP) courses","value":"22"},{"name":"academic courses","value":"72"},{"name":"freshmen join AP courses","value":"100%"}],"id":"StatisticsConfig-c6177e1b-07c9-4591-b776-b84576d8afc7"}},{"type":"HighlightsConfig","props":{"id":"HighlightsConfig-ff922a33-e28e-4cf6-94b2-f79be928f2fd","resolvedHighlights":[{"title":"Academic Rigor","text":"BAID combines China's national curriculum with the Advanced Placement (AP) program, creating an academic experience with both breadth and depth,  giving students the freedom to learn widely, deeply, and well.","image":{"id":58,"sha1":"bf11bcc1a751cd8727e990649683c7963fffb0ca","name":"Academics Hero","altText":"People studying around a table","width":3000,"height":2000,"sizeKB":172,"uploaderId":3406762,"createdAt":"2025-12-22T12:44:30.095Z"},"link":"/academics/high-school","linkText":"Discover academics at BAID"},{"title":"Rich Opportunities","text":"Through long-term partnerships with leading institutions including the Communication University of China, Tsinghua University, and Beijing Normal University, BAID opens the door to broader academic opportunities.","image":{"id":62,"sha1":"073e82273837daeeaeec0f2e8a4603b962cbb875","name":"BA World School","altText":"Test","width":1280,"height":960,"sizeKB":316,"uploaderId":3406762,"createdAt":"2025-12-22T12:50:43.209Z"},"link":"/academics/pbl","linkText":"Discover opportunities at BAID"},{"title":"Outstanding Outcomes","text":"BAID students have been accepted to world-renowned universities including Harvard, Stanford, Oxford, Cambridge, the University of Hong Kong, the University of Tokyo, and the University of Toronto.","image":{"id":6,"sha1":"9942a41c5b79b01ed07566182c6e54e34b3079b7","name":"Test","altText":"Test","width":6016,"height":3384,"sizeKB":1204,"uploaderId":3406762,"createdAt":"2025-10-14T03:02:23.332Z"},"link":"/academics/college-counseling","linkText":"Discover college outcomes at BAID"}],"resolvedUploadPrefix":"/uploads","highlights":[{"title":"Academic Rigor","text":"BAID combines China's national curriculum with the Advanced Placement (AP) program, creating an academic experience with both breadth and depth,  giving students the freedom to learn widely, deeply, and well.","link":"/academics/high-school","linkText":"Discover academics at BAID","image":"58"},{"title":"Rich Opportunities","text":"Through long-term partnerships with leading institutions including the Communication University of China, Tsinghua University, and Beijing Normal University, BAID opens the door to broader academic opportunities.","link":"/academics/pbl","linkText":"Discover opportunities at BAID","image":"62"},{"title":"Outstanding Outcomes","text":"BAID students have been accepted to world-renowned universities including Harvard, Stanford, Oxford, Cambridge, the University of Hong Kong, the University of Tokyo, and the University of Toronto.","link":"/academics/college-counseling","linkText":"Discover college outcomes at BAID","image":"6"}]}},{"type":"SpacerConfig","props":{"height":"5rem","id":"SpacerConfig-8eb23079-dc8c-4d75-964c-a62da689ae8d"}},{"type":"ContainerConfig","props":{"children":[{"type":"ButtonConfig","props":{"text":"Discover our high school program","link":"/academics/high-school","blank":false,"color":"blue","size":"md","align":"center","id":"ButtonConfig-6f638abb-ad49-4cf9-be4e-b4766e9d0525"}}],"contentWidth":true,"id":"ContainerConfig-0f0d1f0e-2e55-4f82-8286-545b127c8981"}},{"type":"GridTextConfig","props":{"title":"Admissions Overview","texts":[{"text":"The Beijing Academy Sino-Foreign Cooperative Education Program (Beijing Academy International Department, BAID) enrolls 100 students from across Beijing each year, including middle school graduates with Beijing hukou and other eligible students qualified for admission to Beijing regular high schools (普通高中)."},{"text":"This program is part of Beijing's standard high school admissions process and follows the admission schedule and procedures established by the Beijing Municipal Education Commission. BAID admits students based on a comprehensive evaluation of Zhongkao (中考) results and entrance assessment performance. Students who wish to take part in the entrance assessment must submit an application form."},{"text":"In accordance with the standards set by the education authorities, tuition is CN¥50,000 per semester, not including boarding, textbooks, meals, uniforms, and other related expenses."},{"text":"BAID offers an international curriculum that integrates China's national curriculum with the Advanced Placement (AP) program, providing students with academic choices that combine both breadth and depth."},{"text":"Each BAID homeroom enrolls approximately 20 students, with a teacher-student ratio of 1:7. BAID also offers a wide range of academic programs, extracurricular opportunities, and excellent campus facilities. Further details are available on other pages of the website."},{"text":"Beginning in the 2025 - 2026 academic year, the program is based at the main campus of Beijing Academy. This is a non-boarding program. Limited boarding is available for students with strong Zhongkao results who live far from campus. The program also provides free, optional evening study sessions."}],"id":"GridTextConfig-5331c736-49b2-4273-b1c2-152abc7f27e8"}},{"type":"ProgramEligibilityConfig","props":{"id":"ProgramEligibilityConfig-d52cf58e-dde0-4db1-8615-eb3a04c1b847"}},{"type":"ContainerConfig","props":{"children":[{"type":"HeadingConfig","props":{"id":"HeadingConfig-ebe6f1be-6107-4468-950b-149500a3e8fc","level":1,"size":"4xl","align":"center","bold":false,"italic":false,"color":"#000000","text":"Admissions has concluded for Spring 2026."}},{"type":"HeadingConfig","props":{"id":"HeadingConfig-4a01d096-0e2c-4b41-8d20-e6abae59a035","level":1,"size":"4xl","align":"center","bold":true,"italic":false,"color":"#000000","text":"Application for Fall 2026 entry is now open."}},{"type":"SpacerConfig","props":{"height":"3rem","id":"SpacerConfig-0e048c56-b3ca-4103-903a-7bd8c946c9e5"}},{"type":"ButtonConfig","props":{"text":"Start Applying","link":"https://beijingacademy.feishu.cn/share/base/form/shrcnF6HWL0DtfWkxF60l9yIJRh","blank":false,"color":"blue","size":"xl","align":"center","id":"ButtonConfig-e03dd89e-d0a7-4c17-85d9-3c414629bcc5"}}],"contentWidth":true,"id":"ContainerConfig-ba2f10f7-2a29-4858-a489-b04d95a05cb6","mb":"3rem","mt":"3rem"}},{"type":"ContactsConfig","props":{"title":"Contact Us","description":"We're always ready to help.","emailText":"Email:","emails":[{"text":"baid@bjacademy.com.cn"}],"phoneText":"Phone:","phones":[{"text":"+86 (10) 5095 1283"},{"text":"+86 (10) 5095 1292"},{"text":"+86 159 1052 4064 (also on WeChat)"}],"id":"ContactsConfig-a9b43102-b35a-44bb-97fb-a1a1c5ce1817","resolvedBackgroundImage":{"id":67,"sha1":"97e9fc13e8bc414ec93c58b64d599ba5ca85b7df","name":"Buldng of Dongba Campus","altText":"Buldng of Dongba Campus","width":3840,"height":2560,"sizeKB":1108,"uploaderId":3406762,"createdAt":"2025-12-22T13:57:44.403Z"},"resolvedUploadPrefix":"/uploads","backgroundImage":"67"}}],"zones":{}}	{"root":{"props":{"title":"高中项目招生"},"type":"root"},"content":[{"type":"SpacerConfig","props":{"height":"5rem","id":"SpacerConfig-481f72a4-5baa-4cd9-8301-e50dd7a1a513"}},{"type":"HorizontalTopTextConfig","props":{"title":"加入 BAID","text":"高中课程体系以扎实的学术训练为核心，兼顾思辨能力、研究素养与国际视野，支持学生在挑战中不断拓展潜能，迈向更广阔的未来。","id":"HorizontalTopTextConfig-465de51b-1dfc-4557-8c5d-4cd8a7043b9d"}},{"type":"SpacerConfig","props":{"height":"5rem","id":"SpacerConfig-07a03e25-b738-46ac-9390-dc8a1382e4c5"}},{"type":"HeroConfig","props":{"title":"Admissions: BAID","backgroundColor":"#ffffff","lightText":false,"topPadding":false,"id":"HeroConfig-8efcdbe9-14f5-4225-ae9e-421095397d42","resolvedImage":{"id":66,"sha1":"7a822d9377fc189c33d4b60980ca3cf841c646b8","name":"Admssons","altText":"ppl plang basketball","width":4000,"height":2667,"sizeKB":321,"uploaderId":3406762,"createdAt":"2025-12-22T13:52:58.599Z"},"resolvedUploadPrefix":"/uploads","image":"66"}},{"type":"SpacerConfig","props":{"height":"64px","id":"SpacerConfig-bf83b0bb-6106-4d6b-85b5-108435bfdf56"}},{"type":"TopTextConfig","props":{"title":"成为理想中的自己","text":"在 BAID 的学习与成长经历，将成为学生人生中的重要新起点。我们结合了中国国家课程与美国大学先修 (AP) 课程，创造了一种更开阔、更充实的学习生活方式。这里的学生追求优异的学术表现，也怀抱长远目标；他们积极探索自身潜能，关注真实世界，期待在充满活力的多元社区中不断成长，并为未来创造更多可能。","to":"","linkText":"","id":"TopTextConfig-50514fe6-5edc-436d-8a11-f88140004533"}},{"type":"StatisticsConfig","props":{"title":"从数字看 BAID","content":[{"name":"师生比","value":"1:7"},{"name":"硕博教师比","value":"93%"},{"name":"平均班级人数","value":"~20"},{"name":"美国大学先修 (AP) 课程","value":"22"},{"name":"学术课程","value":"72"},{"name":"新生第一年即参加 AP 课程","value":"100%"}],"id":"StatisticsConfig-c6177e1b-07c9-4591-b776-b84576d8afc7"}},{"type":"HighlightsConfig","props":{"id":"HighlightsConfig-ff922a33-e28e-4cf6-94b2-f79be928f2fd","resolvedHighlights":[{"title":"博采中西的课程体系","text":"BAID 构建了融合中国国家课程与美国大学先修课程 (AP 课程) 的国际化课程体系，为学生提供兼具广度与深度的学术选择。","image":{"id":58,"sha1":"bf11bcc1a751cd8727e990649683c7963fffb0ca","name":"Academics Hero","altText":"People studying around a table","width":3000,"height":2000,"sizeKB":172,"uploaderId":3406762,"createdAt":"2025-12-22T12:44:30.095Z"},"link":"/academics/high-school","linkText":"了解 BAID 的课程"},{"title":"丰富的校内外项目资源","text":"BAID 与中国传媒大学、清华大学无障碍发展研究院合作、北京师范大学等众多高校开展长期合作，为学生提供更加广阔的学术实践平台。","image":{"id":62,"sha1":"073e82273837daeeaeec0f2e8a4603b962cbb875","name":"BA World School","altText":"Test","width":1280,"height":960,"sizeKB":316,"uploaderId":3406762,"createdAt":"2025-12-22T12:50:43.209Z"},"link":"/academics/pbl","linkText":"了解 BAID 的项目资源"},{"title":"优异的升学结果","text":"BAID 学生已陆续收获哈佛、斯坦福、牛津、剑桥、香港大学、东京大学、多伦多大学等世界知名高校录取。","image":{"id":6,"sha1":"9942a41c5b79b01ed07566182c6e54e34b3079b7","name":"Test","altText":"Test","width":6016,"height":3384,"sizeKB":1204,"uploaderId":3406762,"createdAt":"2025-10-14T03:02:23.332Z"},"link":"/academics/college-counseling","linkText":"了解 BAID 的升学指导"}],"resolvedUploadPrefix":"/uploads","highlights":[{"title":"博采中西的课程体系","text":"BAID 构建了融合中国国家课程与美国大学先修课程 (AP 课程) 的国际化课程体系，为学生提供兼具广度与深度的学术选择。","link":"/academics/high-school","linkText":"了解 BAID 的课程","image":"58"},{"title":"丰富的校内外项目资源","text":"BAID 与中国传媒大学、清华大学无障碍发展研究院合作、北京师范大学等众多高校开展长期合作，为学生提供更加广阔的学术实践平台。","link":"/academics/pbl","linkText":"了解 BAID 的项目资源","image":"62"},{"title":"优异的升学结果","text":"BAID 学生已陆续收获哈佛、斯坦福、牛津、剑桥、香港大学、东京大学、多伦多大学等世界知名高校录取。","link":"/academics/college-counseling","linkText":"了解 BAID 的升学指导","image":"6"}]}},{"type":"SpacerConfig","props":{"height":"5rem","id":"SpacerConfig-8eb23079-dc8c-4d75-964c-a62da689ae8d"}},{"type":"ContainerConfig","props":{"children":[{"type":"ButtonConfig","props":{"text":"详细了解我们的高中项目","link":"/academics/high-school","blank":false,"color":"blue","size":"md","align":"center","id":"ButtonConfig-6f638abb-ad49-4cf9-be4e-b4766e9d0525"}}],"contentWidth":true,"id":"ContainerConfig-0f0d1f0e-2e55-4f82-8286-545b127c8981"}},{"type":"GridTextConfig","props":{"title":"招生介绍","texts":[{"text":"北京中学中外合作办学项目班 (北京中学国际部，BAID) 面向北京市招收京籍初中毕业生及拥有北京市普通高中升学资格的适龄学生共 100人。"},{"text":"本项目属于中招普通招生录取批次，录取工作依据北京市教委安排有序进行。北京中学国际部根据学生中考成绩及加试成绩择优录取，参加加试需要提交申请表格 (\\"简历\\")。"},{"text":"北京中学国际部按照教委标准，确定学费为每学期 5 万元人民币 (不含住宿费、教材费、伙食费、校服费等)。"},{"text":"北京中学国际部采用融合中国国家课程与美国大学先修课程 (AP 课程) 的国际化课程体系，为学生提供兼具广度与深度的学术选择。"},{"text":"北京中学国际部每个班级约有 20 人，师生比为 1:7。同时，北京中学国际部提供丰富的项目资源、课外活动和优越的校园设施。详情请参阅其他页面。"},{"text":"从 2025 - 2026 学年起，本项目在北京中学本部办学。本项目为非住宿项目，但可为中考成绩优异、离校较远的同学提供有限的住宿，也为学生提供免费、自愿的晚自习服务。"}],"id":"GridTextConfig-5331c736-49b2-4273-b1c2-152abc7f27e8"}},{"type":"ProgramEligibilityConfig","props":{"id":"ProgramEligibilityConfig-d52cf58e-dde0-4db1-8615-eb3a04c1b847"}},{"type":"ContainerConfig","props":{"children":[{"type":"HeadingConfig","props":{"id":"HeadingConfig-ebe6f1be-6107-4468-950b-149500a3e8fc","level":1,"size":"4xl","align":"center","bold":false,"italic":false,"color":"#000000","text":"2026 年春季录取工作现已结束。"}},{"type":"HeadingConfig","props":{"id":"HeadingConfig-4a01d096-0e2c-4b41-8d20-e6abae59a035","level":1,"size":"4xl","align":"center","bold":true,"italic":false,"color":"#000000","text":"2026 年秋季入学的申请现正进行中。"}},{"type":"SpacerConfig","props":{"height":"3rem","id":"SpacerConfig-0497b9e0-72c5-43d1-aae9-0ad502a48794"}},{"type":"ButtonConfig","props":{"text":"开始申请","link":"https://beijingacademy.feishu.cn/share/base/form/shrcnF6HWL0DtfWkxF60l9yIJRh","blank":false,"color":"blue","size":"xl","align":"center","id":"ButtonConfig-248f3238-bb7a-4c63-a5da-f96535e25fea"}}],"contentWidth":true,"id":"ContainerConfig-ba2f10f7-2a29-4858-a489-b04d95a05cb6","mb":"3rem","mt":"3rem"}},{"type":"ContactsConfig","props":{"title":"联系我们","description":"如有任何疑问，欢迎随时与我们联系。","emailText":"邮箱:","emails":[{"text":"baid@bjacademy.com.cn"}],"phoneText":"电话:","phones":[{"text":"+86 (10) 5095 1283"},{"text":"+86 (10) 5095 1292"},{"text":"+86 159 1052 4064 (微信同号)"}],"id":"ContactsConfig-a9b43102-b35a-44bb-97fb-a1a1c5ce1817","resolvedBackgroundImage":{"id":67,"sha1":"97e9fc13e8bc414ec93c58b64d599ba5ca85b7df","name":"Buldng of Dongba Campus","altText":"Buldng of Dongba Campus","width":3840,"height":2560,"sizeKB":1108,"uploaderId":3406762,"createdAt":"2025-12-22T13:57:44.403Z"},"resolvedUploadPrefix":"/uploads","backgroundImage":"67"}}],"zones":{}}	{"root":{"props":{"title":"High School Admissions"},"type":"root"},"content":[{"type":"SpacerConfig","props":{"height":"5rem","id":"SpacerConfig-481f72a4-5baa-4cd9-8301-e50dd7a1a513"}},{"type":"HorizontalTopTextConfig","props":{"title":"Join us at BAID","text":"Rooted in strong academic training, BAID's high school program fosters critical thinking, research ability, and global citizenship, empowering students to keep growing through challenge and step into a bigger future.\\n","id":"HorizontalTopTextConfig-465de51b-1dfc-4557-8c5d-4cd8a7043b9d"}},{"type":"SpacerConfig","props":{"height":"5rem","id":"SpacerConfig-07a03e25-b738-46ac-9390-dc8a1382e4c5"}},{"type":"HeroConfig","props":{"title":"Admissions: BAID","backgroundColor":"#ffffff","lightText":false,"topPadding":false,"id":"HeroConfig-8efcdbe9-14f5-4225-ae9e-421095397d42","resolvedImage":{"id":66,"sha1":"7a822d9377fc189c33d4b60980ca3cf841c646b8","name":"Admssons","altText":"ppl plang basketball","width":4000,"height":2667,"sizeKB":321,"uploaderId":3406762,"createdAt":"2025-12-22T13:52:58.599Z"},"resolvedUploadPrefix":"/uploads","image":"66"}},{"type":"SpacerConfig","props":{"height":"64px","id":"SpacerConfig-bf83b0bb-6106-4d6b-85b5-108435bfdf56"}},{"type":"TopTextConfig","props":{"title":"Become who you want to be","text":"At BAID, learning and growth mark the beginning of something bigger. By bringing together China's national curriculum and the Advanced Placement (AP) program, BAID offers a richer way to learn. Students aim high, think deeply, and look ahead. They discover their strengths, engage with the world around them, and grow in a dynamic, diverse community full of possibility.","to":"","linkText":"","id":"TopTextConfig-50514fe6-5edc-436d-8a11-f88140004533"}},{"type":"StatisticsConfig","props":{"title":"BAID in Numbers","content":[{"name":"teacher-student ratio","value":"1:7"},{"name":"postgraduate faculty","value":"93%"},{"name":"average homeroom size","value":"~20"},{"name":"Advanced Placement (AP) courses","value":"22"},{"name":"academic courses","value":"72"},{"name":"freshmen join AP courses","value":"100%"}],"id":"StatisticsConfig-c6177e1b-07c9-4591-b776-b84576d8afc7"}},{"type":"HighlightsConfig","props":{"id":"HighlightsConfig-ff922a33-e28e-4cf6-94b2-f79be928f2fd","resolvedHighlights":[{"title":"Academic Rigor","text":"BAID combines China's national curriculum with the Advanced Placement (AP) program, creating an academic experience with both breadth and depth,  giving students the freedom to learn widely, deeply, and well.","image":{"id":58,"sha1":"bf11bcc1a751cd8727e990649683c7963fffb0ca","name":"Academics Hero","altText":"People studying around a table","width":3000,"height":2000,"sizeKB":172,"uploaderId":3406762,"createdAt":"2025-12-22T12:44:30.095Z"},"link":"/academics/high-school","linkText":"Discover academics at BAID"},{"title":"Rich Opportunities","text":"Through long-term partnerships with leading institutions including the Communication University of China, Tsinghua University, and Beijing Normal University, BAID opens the door to broader academic opportunities.","image":{"id":62,"sha1":"073e82273837daeeaeec0f2e8a4603b962cbb875","name":"BA World School","altText":"Test","width":1280,"height":960,"sizeKB":316,"uploaderId":3406762,"createdAt":"2025-12-22T12:50:43.209Z"},"link":"/academics/pbl","linkText":"Discover opportunities at BAID"},{"title":"Outstanding Outcomes","text":"BAID students have been accepted to world-renowned universities including Harvard, Stanford, Oxford, Cambridge, the University of Hong Kong, the University of Tokyo, and the University of Toronto.","image":{"id":6,"sha1":"9942a41c5b79b01ed07566182c6e54e34b3079b7","name":"Test","altText":"Test","width":6016,"height":3384,"sizeKB":1204,"uploaderId":3406762,"createdAt":"2025-10-14T03:02:23.332Z"},"link":"/academics/college-counseling","linkText":"Discover college outcomes at BAID"}],"resolvedUploadPrefix":"/uploads","highlights":[{"title":"Academic Rigor","text":"BAID combines China's national curriculum with the Advanced Placement (AP) program, creating an academic experience with both breadth and depth,  giving students the freedom to learn widely, deeply, and well.","link":"/academics/high-school","linkText":"Discover academics at BAID","image":"58"},{"title":"Rich Opportunities","text":"Through long-term partnerships with leading institutions including the Communication University of China, Tsinghua University, and Beijing Normal University, BAID opens the door to broader academic opportunities.","link":"/academics/pbl","linkText":"Discover opportunities at BAID","image":"62"},{"title":"Outstanding Outcomes","text":"BAID students have been accepted to world-renowned universities including Harvard, Stanford, Oxford, Cambridge, the University of Hong Kong, the University of Tokyo, and the University of Toronto.","link":"/academics/college-counseling","linkText":"Discover college outcomes at BAID","image":"6"}]}},{"type":"SpacerConfig","props":{"height":"5rem","id":"SpacerConfig-8eb23079-dc8c-4d75-964c-a62da689ae8d"}},{"type":"ContainerConfig","props":{"children":[{"type":"ButtonConfig","props":{"text":"Discover our high school program","link":"/academics/high-school","blank":false,"color":"blue","size":"md","align":"center","id":"ButtonConfig-6f638abb-ad49-4cf9-be4e-b4766e9d0525"}}],"contentWidth":true,"id":"ContainerConfig-0f0d1f0e-2e55-4f82-8286-545b127c8981"}},{"type":"GridTextConfig","props":{"title":"Admissions Overview","texts":[{"text":"The Beijing Academy Sino-Foreign Cooperative Education Program (Beijing Academy International Department, BAID) enrolls 100 students from across Beijing each year, including middle school graduates with Beijing hukou and other eligible students qualified for admission to Beijing regular high schools (普通高中)."},{"text":"This program is part of Beijing's standard high school admissions process and follows the admission schedule and procedures established by the Beijing Municipal Education Commission. BAID admits students based on a comprehensive evaluation of Zhongkao (中考) results and entrance assessment performance. Students who wish to take part in the entrance assessment must submit an application form."},{"text":"In accordance with the standards set by the education authorities, tuition is CN¥50,000 per semester, not including boarding, textbooks, meals, uniforms, and other related expenses."},{"text":"BAID offers an international curriculum that integrates China's national curriculum with the Advanced Placement (AP) program, providing students with academic choices that combine both breadth and depth."},{"text":"Each BAID homeroom enrolls approximately 20 students, with a teacher-student ratio of 1:7. BAID also offers a wide range of academic programs, extracurricular opportunities, and excellent campus facilities. Further details are available on other pages of the website."},{"text":"Beginning in the 2025 - 2026 academic year, the program is based at the main campus of Beijing Academy. This is a non-boarding program. Limited boarding is available for students with strong Zhongkao results who live far from campus. The program also provides free, optional evening study sessions."}],"id":"GridTextConfig-5331c736-49b2-4273-b1c2-152abc7f27e8"}},{"type":"ProgramEligibilityConfig","props":{"id":"ProgramEligibilityConfig-d52cf58e-dde0-4db1-8615-eb3a04c1b847"}},{"type":"ContainerConfig","props":{"children":[{"type":"HeadingConfig","props":{"id":"HeadingConfig-ebe6f1be-6107-4468-950b-149500a3e8fc","level":1,"size":"4xl","align":"center","bold":false,"italic":false,"color":"#000000","text":"Admissions has concluded for Spring 2026."}},{"type":"HeadingConfig","props":{"id":"HeadingConfig-4a01d096-0e2c-4b41-8d20-e6abae59a035","level":1,"size":"4xl","align":"center","bold":true,"italic":false,"color":"#000000","text":"Application for Fall 2026 entry is now open."}},{"type":"SpacerConfig","props":{"height":"3rem","id":"SpacerConfig-0e048c56-b3ca-4103-903a-7bd8c946c9e5"}},{"type":"ButtonConfig","props":{"text":"Start Applying","link":"https://beijingacademy.feishu.cn/share/base/form/shrcnF6HWL0DtfWkxF60l9yIJRh","blank":false,"color":"blue","size":"xl","align":"center","id":"ButtonConfig-e03dd89e-d0a7-4c17-85d9-3c414629bcc5"}}],"contentWidth":true,"id":"ContainerConfig-ba2f10f7-2a29-4858-a489-b04d95a05cb6","mb":"3rem","mt":"3rem"}},{"type":"ContactsConfig","props":{"title":"Contact Us","description":"We're always ready to help.","emailText":"Email:","emails":[{"text":"baid@bjacademy.com.cn"}],"phoneText":"Phone:","phones":[{"text":"+86 (10) 5095 1283"},{"text":"+86 (10) 5095 1292"},{"text":"+86 159 1052 4064 (also on WeChat)"}],"id":"ContactsConfig-a9b43102-b35a-44bb-97fb-a1a1c5ce1817","resolvedBackgroundImage":{"id":67,"sha1":"97e9fc13e8bc414ec93c58b64d599ba5ca85b7df","name":"Buldng of Dongba Campus","altText":"Buldng of Dongba Campus","width":3840,"height":2560,"sizeKB":1108,"uploaderId":3406762,"createdAt":"2025-12-22T13:57:44.403Z"},"resolvedUploadPrefix":"/uploads","backgroundImage":"67"}}],"zones":{}}	{"root":{"props":{"title":"高中项目招生"},"type":"root"},"content":[{"type":"SpacerConfig","props":{"height":"5rem","id":"SpacerConfig-481f72a4-5baa-4cd9-8301-e50dd7a1a513"}},{"type":"HorizontalTopTextConfig","props":{"title":"加入 BAID","text":"高中课程体系以扎实的学术训练为核心，兼顾思辨能力、研究素养与国际视野，支持学生在挑战中不断拓展潜能，迈向更广阔的未来。","id":"HorizontalTopTextConfig-465de51b-1dfc-4557-8c5d-4cd8a7043b9d"}},{"type":"SpacerConfig","props":{"height":"5rem","id":"SpacerConfig-07a03e25-b738-46ac-9390-dc8a1382e4c5"}},{"type":"HeroConfig","props":{"title":"Admissions: BAID","backgroundColor":"#ffffff","lightText":false,"topPadding":false,"id":"HeroConfig-8efcdbe9-14f5-4225-ae9e-421095397d42","resolvedImage":{"id":66,"sha1":"7a822d9377fc189c33d4b60980ca3cf841c646b8","name":"Admssons","altText":"ppl plang basketball","width":4000,"height":2667,"sizeKB":321,"uploaderId":3406762,"createdAt":"2025-12-22T13:52:58.599Z"},"resolvedUploadPrefix":"/uploads","image":"66"}},{"type":"SpacerConfig","props":{"height":"64px","id":"SpacerConfig-bf83b0bb-6106-4d6b-85b5-108435bfdf56"}},{"type":"TopTextConfig","props":{"title":"成为理想中的自己","text":"在 BAID 的学习与成长经历，将成为学生人生中的重要新起点。我们结合了中国国家课程与美国大学先修 (AP) 课程，创造了一种更开阔、更充实的学习生活方式。这里的学生追求优异的学术表现，也怀抱长远目标；他们积极探索自身潜能，关注真实世界，期待在充满活力的多元社区中不断成长，并为未来创造更多可能。","to":"","linkText":"","id":"TopTextConfig-50514fe6-5edc-436d-8a11-f88140004533"}},{"type":"StatisticsConfig","props":{"title":"从数字看 BAID","content":[{"name":"师生比","value":"1:7"},{"name":"硕博教师比","value":"93%"},{"name":"平均班级人数","value":"~20"},{"name":"美国大学先修 (AP) 课程","value":"22"},{"name":"学术课程","value":"72"},{"name":"新生第一年即参加 AP 课程","value":"100%"}],"id":"StatisticsConfig-c6177e1b-07c9-4591-b776-b84576d8afc7"}},{"type":"HighlightsConfig","props":{"id":"HighlightsConfig-ff922a33-e28e-4cf6-94b2-f79be928f2fd","resolvedHighlights":[{"title":"博采中西的课程体系","text":"BAID 构建了融合中国国家课程与美国大学先修课程 (AP 课程) 的国际化课程体系，为学生提供兼具广度与深度的学术选择。","image":{"id":58,"sha1":"bf11bcc1a751cd8727e990649683c7963fffb0ca","name":"Academics Hero","altText":"People studying around a table","width":3000,"height":2000,"sizeKB":172,"uploaderId":3406762,"createdAt":"2025-12-22T12:44:30.095Z"},"link":"/academics/high-school","linkText":"了解 BAID 的课程"},{"title":"丰富的校内外项目资源","text":"BAID 与中国传媒大学、清华大学无障碍发展研究院合作、北京师范大学等众多高校开展长期合作，为学生提供更加广阔的学术实践平台。","image":{"id":62,"sha1":"073e82273837daeeaeec0f2e8a4603b962cbb875","name":"BA World School","altText":"Test","width":1280,"height":960,"sizeKB":316,"uploaderId":3406762,"createdAt":"2025-12-22T12:50:43.209Z"},"link":"/academics/pbl","linkText":"了解 BAID 的项目资源"},{"title":"优异的升学结果","text":"BAID 学生已陆续收获哈佛、斯坦福、牛津、剑桥、香港大学、东京大学、多伦多大学等世界知名高校录取。","image":{"id":6,"sha1":"9942a41c5b79b01ed07566182c6e54e34b3079b7","name":"Test","altText":"Test","width":6016,"height":3384,"sizeKB":1204,"uploaderId":3406762,"createdAt":"2025-10-14T03:02:23.332Z"},"link":"/academics/college-counseling","linkText":"了解 BAID 的升学指导"}],"resolvedUploadPrefix":"/uploads","highlights":[{"title":"博采中西的课程体系","text":"BAID 构建了融合中国国家课程与美国大学先修课程 (AP 课程) 的国际化课程体系，为学生提供兼具广度与深度的学术选择。","link":"/academics/high-school","linkText":"了解 BAID 的课程","image":"58"},{"title":"丰富的校内外项目资源","text":"BAID 与中国传媒大学、清华大学无障碍发展研究院合作、北京师范大学等众多高校开展长期合作，为学生提供更加广阔的学术实践平台。","link":"/academics/pbl","linkText":"了解 BAID 的项目资源","image":"62"},{"title":"优异的升学结果","text":"BAID 学生已陆续收获哈佛、斯坦福、牛津、剑桥、香港大学、东京大学、多伦多大学等世界知名高校录取。","link":"/academics/college-counseling","linkText":"了解 BAID 的升学指导","image":"6"}]}},{"type":"SpacerConfig","props":{"height":"5rem","id":"SpacerConfig-8eb23079-dc8c-4d75-964c-a62da689ae8d"}},{"type":"ContainerConfig","props":{"children":[{"type":"ButtonConfig","props":{"text":"详细了解我们的高中项目","link":"/academics/high-school","blank":false,"color":"blue","size":"md","align":"center","id":"ButtonConfig-6f638abb-ad49-4cf9-be4e-b4766e9d0525"}}],"contentWidth":true,"id":"ContainerConfig-0f0d1f0e-2e55-4f82-8286-545b127c8981"}},{"type":"GridTextConfig","props":{"title":"招生介绍","texts":[{"text":"北京中学中外合作办学项目班 (北京中学国际部，BAID) 面向北京市招收京籍初中毕业生及拥有北京市普通高中升学资格的适龄学生共 100人。"},{"text":"本项目属于中招普通招生录取批次，录取工作依据北京市教委安排有序进行。北京中学国际部根据学生中考成绩及加试成绩择优录取，参加加试需要提交申请表格 (\\"简历\\")。"},{"text":"北京中学国际部按照教委标准，确定学费为每学期 5 万元人民币 (不含住宿费、教材费、伙食费、校服费等)。"},{"text":"北京中学国际部采用融合中国国家课程与美国大学先修课程 (AP 课程) 的国际化课程体系，为学生提供兼具广度与深度的学术选择。"},{"text":"北京中学国际部每个班级约有 20 人，师生比为 1:7。同时，北京中学国际部提供丰富的项目资源、课外活动和优越的校园设施。详情请参阅其他页面。"},{"text":"从 2025 - 2026 学年起，本项目在北京中学本部办学。本项目为非住宿项目，但可为中考成绩优异、离校较远的同学提供有限的住宿，也为学生提供免费、自愿的晚自习服务。"}],"id":"GridTextConfig-5331c736-49b2-4273-b1c2-152abc7f27e8"}},{"type":"ProgramEligibilityConfig","props":{"id":"ProgramEligibilityConfig-d52cf58e-dde0-4db1-8615-eb3a04c1b847"}},{"type":"ContainerConfig","props":{"children":[{"type":"HeadingConfig","props":{"id":"HeadingConfig-ebe6f1be-6107-4468-950b-149500a3e8fc","level":1,"size":"4xl","align":"center","bold":false,"italic":false,"color":"#000000","text":"2026 年春季录取工作现已结束。"}},{"type":"HeadingConfig","props":{"id":"HeadingConfig-4a01d096-0e2c-4b41-8d20-e6abae59a035","level":1,"size":"4xl","align":"center","bold":true,"italic":false,"color":"#000000","text":"2026 年秋季入学的申请现正进行中。"}},{"type":"SpacerConfig","props":{"height":"3rem","id":"SpacerConfig-0497b9e0-72c5-43d1-aae9-0ad502a48794"}},{"type":"ButtonConfig","props":{"text":"开始申请","link":"https://beijingacademy.feishu.cn/share/base/form/shrcnF6HWL0DtfWkxF60l9yIJRh","blank":false,"color":"blue","size":"xl","align":"center","id":"ButtonConfig-248f3238-bb7a-4c63-a5da-f96535e25fea"}}],"contentWidth":true,"id":"ContainerConfig-ba2f10f7-2a29-4858-a489-b04d95a05cb6","mb":"3rem","mt":"3rem"}},{"type":"ContactsConfig","props":{"title":"联系我们","description":"如有任何疑问，欢迎随时与我们联系。","emailText":"邮箱:","emails":[{"text":"baid@bjacademy.com.cn"}],"phoneText":"电话:","phones":[{"text":"+86 (10) 5095 1283"},{"text":"+86 (10) 5095 1292"},{"text":"+86 159 1052 4064 (微信同号)"}],"id":"ContactsConfig-a9b43102-b35a-44bb-97fb-a1a1c5ce1817","resolvedBackgroundImage":{"id":67,"sha1":"97e9fc13e8bc414ec93c58b64d599ba5ca85b7df","name":"Buldng of Dongba Campus","altText":"Buldng of Dongba Campus","width":3840,"height":2560,"sizeKB":1108,"uploaderId":3406762,"createdAt":"2025-12-22T13:57:44.403Z"},"resolvedUploadPrefix":"/uploads","backgroundImage":"67"}}],"zones":{}}	\N	\N	3406762	2025-12-22 13:51:51.158	2026-04-05 03:55:18.626	\N	\N	\N	\N	\N	\N
