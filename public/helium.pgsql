a4a68b","name":"xqf","altText":"xqf","width":1920,"height":2880,"sizeKB":130,"uploaderId":3406762,"createdAt":{}},"coverImageDraft":{"id":10,"sha1":"b32b8acdc3a560f8264489a45ab7ee48d8a4a68b","name":"xqf","altText":"xqf","width":1920,"height":2880,"sizeKB":130,"uploaderId":3406762,"createdAt":{}},"creator":{"id":3406762,"name":"蔺东来 Lin","pinyin":"Lin Donglai","roles":["admin","writer","editor"],"type":"student","gender":"male","createdAt":{},"updatedAt":{}},"createdAt":{},"updatedAt":{}}},"title":"某一位教师"},{"person":{"id":35,"title":"苑笑阳","createdAt":{},"slug":"yuan-xiaoyang","data":{"id":35,"type":"faculty","titlePublishedEN":"Yuan Xiaoyang","titlePublishedZH":"苑笑阳","titleDraftEN":"Yuan Xiaoyang","titleDraftZH":"苑笑阳","shortContentPublishedEN":"Who is Yuan Xiaoyang","shortContentPublishedZH":"苑笑阳是谁","shortContentDraftEN":"Who is Yuan Xiaoyang","shortContentDraftZH":"苑笑阳是谁","slug":"yuan-xiaoyang","categoryEN":null,"categoryZH":null,"coverImagePublished":{"id":10,"sha1":"b32b8acdc3a560f8264489a45ab7ee48d8a4a68b","name":"xqf","altText":"xqf","width":1920,"height":2880,"sizeKB":130,"uploaderId":3406762,"createdAt":{}},"coverImageDraft":{"id":10,"sha1":"b32b8acdc3a560f8264489a45ab7ee48d8a4a68b","name":"xqf","altText":"xqf","width":1920,"height":2880,"sizeKB":130,"uploaderId":3406762,"createdAt":{}},"creator":{"id":3406762,"name":"蔺东来 Lin","pinyin":"Lin Donglai","roles":["admin","writer","editor"],"type":"student","gender":"male","createdAt":{},"updatedAt":{}},"createdAt":{},"updatedAt":{}}},"title":"某一位教师"},{"person":{"id":35,"title":"苑笑阳","createdAt":{},"slug":"yuan-xiaoyang","data":{"id":35,"type":"faculty","titlePublishedEN":"Yuan Xiaoyang","titlePublishedZH":"苑笑阳","titleDraftEN":"Yuan Xiaoyang","titleDraftZH":"苑笑阳","shortContentPublishedEN":"Who is Yuan Xiaoyang","shortContentPublishedZH":"苑笑阳是谁","shortContentDraftEN":"Who is Yuan Xiaoyang","shortContentDraftZH":"苑笑阳是谁","slug":"yuan-xiaoyang","categoryEN":null,"categoryZH":null,"coverImagePublished":{"id":10,"sha1":"b32b8acdc3a560f8264489a45ab7ee48d8a4a68b","name":"xqf","altText":"xqf","width":1920,"height":2880,"sizeKB":130,"uploaderId":3406762,"createdAt":{}},"coverImageDraft":{"id":10,"sha1":"b32b8acdc3a560f8264489a45ab7ee48d8a4a68b","name":"xqf","altText":"xqf","width":1920,"height":2880,"sizeKB":130,"uploaderId":3406762,"createdAt":{}},"creator":{"id":3406762,"name":"蔺东来 Lin","pinyin":"Lin Donglai","roles":["admin","writer","editor"],"type":"student","gender":"male","createdAt":{},"updatedAt":{}},"createdAt":{},"updatedAt":{}}},"title":"某一位教师"}]}}],"contentWidth":true,"id":"ContainerConfig-6662057a-5709-4639-84a8-6083467da430"}},{"type":"SpacerConfig","props":{"height":"64px","id":"SpacerConfig-673557ea-0d76-4658-8ba9-0fbeaf628235"}},{"type":"ImageTextLayoutConfig","props":{"lightText":true,"inverseOrder":false,"id":"ImageTextLayoutConfig-40df52cf-e9ff-46bc-aa36-13ae4601821b","resolvedImage":{"id":64,"sha1":"15f6901d80775583c340abba2d020f0ce28fbeb6","name":"Life at BAID","altText":"People playing football on the playground","width":3976,"height":2652,"sizeKB":431,"uploaderId":3406762,"createdAt":"2025-12-22T13:05:12.808Z"},"resolvedUploadPrefix":"/uploads","image":"64","backgroundColor":"#103c74","topText":"9 年级至 11 年级","title":"大学升学讲座","text":"从 9 年级起，BAID 为学生系统开设大学升学讲座，由各班指定的升学指导老师每周开展，讲座内容涵盖大学申请制度、课程与活动规划、专业探索、文书写作等多个方面，支持学生在不同阶段做好充分准备。学校也定期邀请知名大学招生官和资深升学指导老师走进校园，举办家长课堂，帮助家庭更全面地理解升学过程。"}},{"type":"ImageTextLayoutConfig","props":{"lightText":true,"inverseOrder":true,"id":"ImageTextLayoutConfig-6324bef1-dc1a-4b53-ae99-c642fcb0d0be","resolvedImage":{"id":58,"sha1":"bf11bcc1a751cd8727e990649683c7963fffb0ca","name":"Academics Hero","altText":"People studying around a table","width":3000,"height":2000,"sizeKB":172,"uploaderId":3406762,"createdAt":"2025-12-22T12:44:30.095Z"},"resolvedUploadPrefix":"/uploads","backgroundColor":"#9f0612","image":"58","topText":"9 年级至 11 年级","title":"一对一升学约谈","text":"每学期，升学指导老师都会与每一个家庭进行一对一约谈，结合学生的学业表现、活动经历、兴趣方向与发展目标，细致分析申请资料的特点与提升空间。通过持续、个性化的沟通，帮助学生明确下一阶段的规划重点，更有针对性地完善申请准备。"}},{"type":"ImageTextLayoutConfig","props":{"lightText":false,"inverseOrder":false,"id":"ImageTextLayoutConfig-29eb1175-bb2e-4878-9528-efe3d87a788b","resolvedImage":{"id":63,"sha1":"eca52c9f86f2410f111503f970426e6a0c2bd94b","name":"Bejng Culture Exploration Program","altText":"Test","width":1280,"height":853,"sizeKB":85,"uploaderId":3406762,"createdAt":"2025-12-22T12:50:56.539Z"},"resolvedUploadPrefix":"/uploads","topText":"9 年级至 11 年级","image":"63","title":"标准化考试支持","text":"每位同学都可参加「综合英语」课程，在专业教师指导下有针对性地备考托福、SAT 与 ACT 考试。课程将语言能力提升与考试训练有机结合，帮助学生在校内高效备考，更从容地迎接各项标准化考试。"}},{"type":"ImageTextLayoutConfig","props":{"lightText":true,"inverseOrder":true,"id":"ImageTextLayoutConfig-fa2d46b7-6e29-456d-af64-42814af46374","resolvedImage":{"id":63,"sha1":"eca52c9f86f2410f111503f970426e6a0c2bd94b","name":"Bejng Culture Exploration Program","altText":"Test","width":1280,"height":853,"sizeKB":85,"uploaderId":3406762,"createdAt":"2025-12-22T12:50:56.539Z"},"resolvedUploadPrefix":"/uploads","backgroundColor":"#103c74","topText":"9 年级至 11 年级","title":"丰富的活动资源","image":"63","linkText":"了解 BAID 的活动资源","link":"/academics/pbl","text":"学校开设 40 余门选修课、50 余个学生社团，并通过项目式学习、学科周、阅历课程、北京文化探究、英才学者、无障碍发展 \\"未来星\\" 培养计划等多样平台，为学生创造深入探索的机会。学生也可在学委会、班级、社团和公益项目中承担责任，在持续参与中丰富个人经历，向大学展示自己独特的一面。"}},{"type":"ImageTextLayoutConfig","props":{"lightText":true,"inverseOrder":false,"id":"ImageTextLayoutConfig-ea698bb2-93bf-4f30-aea2-8a00f1d95f63","resolvedImage":{"id":62,"sha1":"073e82273837daeeaeec0f2e8a4603b962cbb875","name":"BA World School","altText":"Test","width":1280,"height":960,"sizeKB":316,"uploaderId":3406762,"createdAt":"2025-12-22T12:50:43.209Z"},"resolvedUploadPrefix":"/uploads","topText":"11 年级至 12 年级","image":"62","backgroundColor":"#4f5b74","title":"申请季集中支持","text":"从申请年份 5 月起，每位学生都可与升学指导老师进行双向选择，进入更有针对性的申请准备阶段。在整个申请季中，学生可每周灵活约谈，与老师共同确定最终选校名单，持续完善申请文书与相关材料。升学指导老师也会在充分了解学生成长经历与个人特点的基础上，提供细致、专业的建议，并诚实地向大学推荐学生，为学生的大学申请提供有力支持。"}},{"type":"SpacerConfig","props":{"height":"5rem","id":"SpacerConfig-91fb83f5-ad12-4d59-87a6-02c10fa90d53"}},{"type":"ContainerConfig","props":{"children":[{"type":"HeadingConfig","props":{"level":1,"size":"4xl","align":"center","bold":true,"italic":false,"color":"#000000","id":"HeadingConfig-89310637-f500-428b-9a37-028ba0d292d1","text":"大学申请活动"}}],"contentWidth":true,"id":"ContainerConfig-9c58a57c-57c3-42d1-8983-1ad04cf73b23"}},{"type":"NewsListConfig","props":{"id":"NewsListConfig-2b68c040-da2d-4ecc-9550-a8f599c80bb1","resolvedEntitiesInit":{"items":[],"page":0,"pages":0},"resolvedUploadPrefix":"/uploads","category":"college-admissions"}},{"type":"SpacerConfig","props":{"height":"5rem","id":"SpacerConfig-9cf58df2-64e7-45bc-839a-85c7ce3a5cfd"}}],"zones":{}}	\N	\N	3406762	2026-03-21 07:31:55.233	2026-04-05 03:55:20.703	\N	\N	\N	\N	\N	\N
9	page	About Us	关于我们	About Us	关于我们	about	{"root":{"props":{"title":"About Us"},"type":"root"},"content":[{"type":"SpacerConfig","props":{"height":"5rem","id":"SpacerConfig-36255b24-aa8d-4db7-af7d-03d2a8f64652"}},{"type":"HorizontalTopTextConfig","props":{"title":"Our Mission","text":"Cultivate well-rounded, forward-thinking leaders of the future with a modern education rooted in Chinese values and global perspectives.\\n","id":"HorizontalTopTextConfig-9b48f545-0734-4fbd-9c9f-1f918d26d29c"}},{"type":"SpacerConfig","props":{"height":"5rem","id":"SpacerConfig-89485068-6657-4376-9f52-f668114d671d"}},{"type":"HeroConfig","props":{"title":"About Us","backgroundColor":"#ffffff","lightText":false,"id":"HeroConfig-0b5efe89-2da0-4c19-a034-06bfb195d64c","resolvedImage":{"id":11,"sha1":"c3362d9dcace9926f10970230152d0d4869e1448","name":"Test","altText":"Test","width":3840,"height":2563,"sizeKB":2517,"uploaderId":3406762,"createdAt":"2025-10-14T05:01:29.874Z"},"resolvedUploadPrefix":"/uploads","image":"11"}},{"type":"GridTextConfig","props":{"title":"Overview","texts":[{"text":"Beijing Academy was established in September 2013. We are a 12-year public school approved by the Beijing Municipal Government and funded by the Chaoyang District Government. Our school is built to become a modern community with a unique Beijing style, a distinctive Chinese character and a global perspective."},{"text":"In 2020, BAID was approved by the Beijing Municipal Education Commission as a sino-foreign cooperative high school education program. We are an authorized AP school, a CIS member school, an ACT testing center, and a Cambridge International Curriculum school."},{"text":"Beijing Academy promotes students' comprehensive personal growth. We believe that through the efforts of both our students and teachers, we can realize our motto: \\"Better me, better world,\\" and that all of us will make the world a better place."}],"id":"GridTextConfig-719ecbf3-37cb-4242-911f-ecf9f798912d"}},{"type":"BentoBoxConfig","props":{"title":"At a Glance","motto":"Better Me, Better World","mottoText":"The motto that sits at the heart of everything we do at Beijing Academy\\n","admissionsTitle":"Outstanding college outcomes","admissionsText":"Students and graduates from Beijing Academy have been accepted to Harvard, Stanford, Imperial, McGill, HKU, University of Tokyo, and more.\\n","facultyTitle":"World-class faculty","facultyText":"93% postgraduate","countriesTitle":"From Beijing to the world","countriesText":"This year, BAID graduates will study in six countries/regions around the globe.\\n","academicsTitle":"Academic Excellence","academicsText":"With over 20 AP courses and undergraduate-level courses, the MFP research program, project-based learning and more, BAID prepares students for success in college and beyond.","lifeText":"Live the best years of your life","diversityText":"Faculty from 7 countries","id":"BentoBoxConfig-92282cb8-5517-4601-8929-7efaba06dd59"}},{"type":"StatisticsConfig","props":{"title":"BAID in Numbers","content":[{"name":"teacher-student ratio","value":"1:7"},{"name":"postgraduate faculty","value":"93%"},{"name":"average homeroom size","value":"~20"},{"name":"students","value":"375"},{"name":"academic courses","value":"72"},{"name":"Advanced Placement (AP) courses","value":"22"}],"id":"StatisticsConfig-7a8423bf-1c05-40dd-936e-72aac5c875a1"}},{"type":"ImageTextLayoutConfig","props":{"lightText":false,"inverseOrder":false,"id":"ImageTextLayoutConfig-b432d44f-c557-4913-a39d-560c12c56e93","resolvedImage":{"id":59,"sha1":"dfdbae4816a16dd1a41563aac9cf52ecfdf204ee","name":"BA Lectures","altText":"olympics gold medalist Yang Yang at an event","width":1080,"height":720,"sizeKB":68,"uploaderId":3406762,"createdAt":"2025-12-22T12:49:50.419Z"},"resolvedUploadPrefix":"/uploads","title":"Better Me, Better World","image":"59","text":"\\"Better me, better world\\" is the direction that guides every Beijing Academy student. It begins with attention to the people and needs around us, and grows through real service and real action. Through experience, reflection, and effort, students come to understand responsibility, learn to contribute, and make a true difference in the lives of others.","topText":"Our Motto"}},{"type":"ImageTextLayoutConfig","props":{"lightText":true,"inverseOrder":true,"id":"ImageTextLayoutConfig-f64bfcee-fe7e-4ec1-b357-fa846d964485","resolvedImage":{"id":62,"sha1":"073e82273837daeeaeec0f2e8a4603b962cbb875","name":"BA World School","altText":"Test","width":1280,"height":960,"sizeKB":316,"uploaderId":3406762,"createdAt":"2025-12-22T12:50:43.209Z"},"resolvedUploadPrefix":"/uploads","backgroundColor":"#9f0612","topText":"Our Spirit","title":"Harmony in Diversity, Joy in Learning","text":"BAID is a community that welcomes many voices, values differences, and grows through connection and collaboration. Students with different backgrounds and different interests learn from one another, inspire one another, and thrive together. Here, curiosity is encouraged, individuality is respected, and school life is filled with energy, warmth, and purpose.","image":"62"}},{"type":"ImageTextLayoutConfig","props":{"lightText":true,"inverseOrder":false,"id":"ImageTextLayoutConfig-5cc73a56-79ef-4ee4-8b93-c762b2ce4ef6","resolvedImage":{"id":67,"sha1":"97e9fc13e8bc414ec93c58b64d599ba5ca85b7df","name":"Buldng of Dongba Campus","altText":"Buldng of Dongba Campus","width":3840,"height":2560,"sizeKB":1108,"uploaderId":3406762,"createdAt":"2025-12-22T13:57:44.403Z"},"resolvedUploadPrefix":"/uploads","backgroundColor":"#103c74","topText":"Our Educational Vision","title":"Live Well, Stand Tall","text":"Rooted in China and open to the world, BAID students grow with both confidence and perspective. They deepen their understanding of their own culture even as they step onto a broader global stage. They pursue personal growth, respond to the needs of their time, and find their place at the meeting point of China and the world—ready to take responsibility and aim higher.","image":"67"}},{"type":"ImageTextLayoutConfig","props":{"lightText":false,"inverseOrder":true,"id":"ImageTextLayoutConfig-096e7d65-8544-4ba8-b7b0-b42c9a7acd35","resolvedImage":{"id":66,"sha1":"7a822d9377fc189c33d4b60980ca3cf841c646b8","name":"Admssons","altText":"ppl plang basketball","width":4000,"height":2667,"sizeKB":321,"uploaderId":3406762,"createdAt":"2025-12-22T13:52:58.599Z"},"resolvedUploadPrefix":"/uploads","topText":"Our Core Values","title":"Compassion, Wisdom, Courage, Joy","text":"These four values run through every part of life at BAID. Compassion means caring for others with respect and empathy. Wisdom means thinking independently and judging thoughtfully. Courage means stepping forward to meet challenge with resolve. Joy means engaging fully, exploring widely, and finding meaning in the process. Together, they express the kind of growth BAID hopes to nurture in every student.","image":"66"}},{"type":"SpacerConfig","props":{"height":"5rem","id":"SpacerConfig-7b269e49-af93-4fec-bb1e-35e227238fe9"}},{"type":"HighlightsConfig","props":{"id":"HighlightsConfig-cfc87e3d-818e-44ce-923b-f9835ef3c61d","resolvedHighlights":[{"title":"Middle School","text":"Our middle school program is based on the Cambridge Lower Secondary curriculum, building strong foundations and inquiry skills.","image":{"id":67,"sha1":"97e9fc13e8bc414ec93c58b64d599ba5ca85b7df","name":"Buldng of Dongba Campus","altText":"Buldng of Dongba Campus","width":3840,"height":2560,"sizeKB":1108,"uploaderId":3406762,"createdAt":"2025-12-22T13:57:44.403Z"},"link":"/academics/middle-school","linkText":"Middle School Program"},{"title":"High School","text":"Our high school program centers on AP courses, offering rigorous courses and focused academic pathways.","image":{"id":58,"sha1":"bf11bcc1a751cd8727e990649683c7963fffb0ca","name":"Academics Hero","altText":"People studying around a table","width":3000,"height":2000,"sizeKB":172,"uploaderId":3406762,"createdAt":"2025-12-22T12:44:30.095Z"},"link":"/academics/high-school","linkText":"High School Program"},{"title":"Project-Based Learning","text":"At BAID, education is more than grades. Through our project-based learning curriculum, students develop their individual strengths beyond the classroom.\\n","image":{"id":65,"sha1":"29587e370b2cc9463b8858e7c81b0f51418f5759","name":"Student Projects","altText":"BAID students' ocean protection project","width":1920,"height":1039,"sizeKB":102,"uploaderId":3406762,"createdAt":"2025-12-22T13:31:36.244Z"},"link":"/academics/pbl","linkText":"Project-Based Learning"}],"resolvedUploadPrefix":"/uploads","highlights":[{"title":"Middle School","text":"Our middle school program is based on the Cambridge Lower Secondary curriculum, building strong foundations and inquiry skills.","image":"67","link":"/academics/middle-school","linkText":"Middle School Program"},{"title":"High School","text":"Our high school program centers on AP courses, offering rigorous courses and focused academic pathways.","image":"58","link":"/academics/high-school","linkText":"High School Program"},{"title":"Project-Based Learning","text":"At BAID, education is more than grades. Through our project-based learning curriculum, students develop their individual strengths beyond the classroom.\\n","image":"65","link":"/academics/pbl","linkText":"Project-Based Learning"}]}},{"type":"AccreditationsConfig","props":{"title":"Accreditation","text":"BAID is authorized as an AP curriculum school by the College Board. We are the first public high school in China to receive CIS accreditation, and an authorized global ACT-GAC official teaching and testing center. We are authorized with the Cambridge international curriculum, and has been designated as an \\"Apple Distinguished School.\\"\\n","id":"AccreditationsConfig-30fca930-d13b-41b0-8e5d-267c052ad8bf","resolvedUploadPrefix":"/uploads","resolvedAccreditations":[{"name":"AP authorized","image":{"id":12,"sha1":"ef21dd367573676f30b19b6685110b0b9423b7ea","name":"AP","altText":"AP","width":2485,"height":2047,"sizeKB":24,"uploaderId":3406762,"createdAt":"2025-10-14T05:22:28.035Z"}}],"accreditations":[{"name":"AP authorized","image":"12"}]}},{"type":"AlumniConfig","props":{"title":"Alumni Words","alumni":[{"name":"Ms. Tian","quote":"Here is the beginning, the stage, a space of trust bestowed. Here, I learned to grow whole — to seek myself, to understand others, to hold the world in my heart. BAID has shaped my youth, and it will shape every BAIDer, too.","image":"13"},{"name":"Mr. Wang","quote":"Over my years at Beijing Academy, I've gained an inclusive way of thinking, learning to cultivate self-driven initiative fueled by passion. Along the way, I've developed lifelong interests and friendships.","image":"14"},{"name":"Ms. Yang","quote":"To me, my seven years at Beijing Academy have been a tender, lingering dream — where I grew, transformed, and became someone I love, each memory a quiet force that sends me forward.","image":"15"}],"id":"AlumniConfig-dfb0d2dd-0764-44c4-8e29-2c405ef2e02d","resolvedAlumni":[{"name":"Ms. Tian","quote":"Here is the beginning, the stage, a space of trust bestowed. Here, I learned to grow whole — to seek myself, to understand others, to hold the world in my heart. BAID has shaped my youth, and it will shape every BAIDer, too.","image":{"id":13,"sha1":"3deaf54f489a33abc0c47cfbc989afdc5645caf0","name":"test","altText":"test","width":2117,"height":2823,"sizeKB":456,"uploaderId":3406762,"createdAt":"2025-10-14T05:24:36.595Z"}},{"name":"Mr. Wang","quote":"Over my years at Beijing Academy, I've gained an inclusive way of thinking, learning to cultivate self-driven initiative fueled by passion. Along the way, I've developed lifelong interests and friendships.","image":{"id":14,"sha1":"e1e2b77aa65ff98f6a88142aabfa47d15a322ee5","name":"test","altText":"test","width":1280,"height":1920,"sizeKB":118,"uploaderId":3406762,"createdAt":"2025-10-14T05:24:45.417Z"}},{"name":"Ms. Yang","quote":"To me, my seven years at Beijing Academy have been a tender, lingering dream — where I grew, transformed, and became someone I love, each memory a quiet force that sends me forward.","image":{"id":15,"sha1":"97c3ed00e738280bd2dcf2e7c71cd1686c238d83","name":"test","altText":"test","width":3024,"height":4032,"sizeKB":725,"uploaderId":3406762,"createdAt":"2025-10-14T05:25:32.779Z"}}],"resolvedUploadPrefix":"/uploads"}},{"type":"QuoteConfig","props":{"text":"We will make our campus a spiritual home, a center of learning, and a fertile ground for innovation for both students and teachers — a place where they can learn to love others, help others, and respect others.","source":"Xia Qingfeng, Principal of Beijing Academy","id":"QuoteConfig-62b5a687-262c-4487-a4cf-596ae73c0c69","resolvedImage":{"id":10,"sha1":"b32b8acdc3a560f8264489a45ab7ee48d8a4a68b","name":"xqf","altText":"xqf","width":1920,"height":2880,"sizeKB":130,"uploaderId":3406762,"createdAt":"2025-10-14T03:25:23.284Z"},"resolvedUploadPrefix":"/uploads","image":"10"}},{"type":"ButtonConfig","props":{"text":"Learn more about admissions at BAID","link":"/admissions","blank":false,"color":"blue","size":"md","align":"center","id":"ButtonConfig-49bd81e0-2564-44b4-b26f-7f87ac5ecec8"}},{"type":"SpacerConfig","props":{"height":"64px","id":"SpacerConfig-3970e5e5-0670-41e1-a6f7-77c69516f84b"}}],"zones":{}}	{"root":{"props":{"title":"关于我们"},"type":"root"},"content":[{"type":"SpacerConfig","props":{"height":"5rem","id":"SpacerConfig-36255b24-aa8d-4db7-af7d-03d2a8f64652"}},{"type":"HorizontalTopTextConfig","props":{"title":"我们的使命","text":"以立足北京、植根中国、面向世界的现代教育，培养全面发展的未来领袖。","id":"HorizontalTopTextConfig-9b48f545-0734-4fbd-9c9f-1f918d26d29c"}},{"type":"SpacerConfig","props":{"height":"5rem","id":"SpacerConfig-89485068-6657-4376-9f52-f668114d671d"}},{"type":"HeroConfig","props":{"title":"About Us","backgroundColor":"#ffffff","lightText":false,"id":"HeroConfig-0b5efe89-2da0-4c19-a034-06bfb195d64c","resolvedImage":{"id":11,"sha1":"c3362d9dcace9926f10970230152d0d4869e1448","name":"Test","altText":"Test","width":3840,"height":2563,"sizeKB":2517,"uploaderId":3406762,"createdAt":"2025-10-14T05:01:29.874Z"},"resolvedUploadPrefix":"/uploads","image":"11"}},{"type":"GridTextConfig","props":{"title":"总览","texts":[{"text":"北京中学成立于 2013 年 9 月，是经北京市政府批准，由朝阳区政府创办的一所十二年一贯制的公办学校，致力于办成一所具有北京风格、中国气质与世界胸怀的现代学校。"},{"text":"2020 年，北京中学中外合作办学项目 (北京中学国际部) 获北京市教委批准。我们是 AP 授权校、CIS 认证成员学校、ACT 考试中心与剑桥国际课程学校。北京中学国际部提供中国高中课程、AP 课程与特色课程融合的课程体系。"},{"text":"北京中学始终致力于学生的全面与自由成长。我们相信，在全体师生的努力下，“世界因我更美好”的校训将真正照进现实。"}],"id":"GridTextConfig-719ecbf3-37cb-4242-911f-ecf9f798912d"}},{"type":"BentoBoxConfig","props":{"title":"一览 BAID","motto":"世界因我更美好","mottoText":"我们的校训，也是我们一切行动的指南","admissionsTitle":"优异的升学结果","admissionsText":"自 2017 年成立以来，北京中学国际部的学生已被哈佛、斯坦福、牛津、剑桥、麦吉尔、香港大学、东京大学等世界顶尖大学录取。","facultyTitle":"优秀师资队伍","facultyText":"93% 具有硕博学位","countriesTitle":"来自北京 面向世界","countriesText":"今年，北京中学国际部的毕业生将前往六个国家和地区继续深造。","academicsTitle":"学术卓越","academicsText":"北京中学国际部提供二十多门 AP 课程、本科级别课程、MFP 科研项目和项目式学习，全面支持学生为大学和未来发展做好准备。","lifeText":"享受人生的青葱年华","diversityText":"来自七个国家的教师团队","id":"BentoBoxConfig-92282cb8-5517-4601-8929-7efaba06dd59"}},{"type":"StatisticsConfig","props":{"title":"从数字看 BAID","content":[{"name":"师生比","value":"1:7"},{"name":"硕博教师比","value":"93%"},{"name":"班额","value":"~20"},{"name":"学生","value":"375"},{"name":"学术课程","value":"72"},{"name":"AP 课程","value":"22"}],"id":"StatisticsConfig-7a8423bf-1c05-40dd-936e-72aac5c875a1"}},{"type":"ImageTextLayoutConfig","props":{"lightText":false,"inverseOrder":false,"id":"ImageTextLayoutConfig-b432d44f-c557-4913-a39d-560c12c56e93","resolvedImage":{"id":59,"sha1":"dfdbae4816a16dd1a41563aac9cf52ecfdf204ee","name":"BA Lectures","altText":"olympics gold medalist Yang Yang at an event","width":1080,"height":720,"sizeKB":68,"uploaderId":3406762,"createdAt":"2025-12-22T12:49:50.419Z"},"resolvedUploadPrefix":"/uploads","title":"世界因我更美好","image":"59","text":"“世界因我更美好” 是北京中学每一位学生的行动方向。从关注身边的人与事出发，在一次次真实的服务与实践中，理解责任、学会付出。我们的学生在不断尝试与反思中，逐步形成面向社会的担当意识，用具体行动为他人带来改变。","topText":"我们的校训"}},{"type":"ImageTextLayoutConfig","props":{"lightText":true,"inverseOrder":true,"id":"ImageTextLayoutConfig-f64bfcee-fe7e-4ec1-b357-fa846d964485","resolvedImage":{"id":62,"sha1":"073e82273837daeeaeec0f2e8a4603b962cbb875","name":"BA World School","altText":"Test","width":1280,"height":960,"sizeKB":316,"uploaderId":3406762,"createdAt":"2025-12-22T12:50:43.209Z"},"resolvedUploadPrefix":"/uploads","backgroundColor":"#9f0612","topText":"我们的校风","title":"和而不同，乐在其中","text":"BAID 的社区热爱多元表达，尊重差异，在交流与合作中形成了开放、包容的氛围。不同背景、不同兴趣的学生在同一空间中相互理解、彼此激发，在参与中找到热情，在探索中获得乐趣，形成积极而有温度的校园环境。\\n","image":"62"}},{"type":"ImageTextLayoutConfig","props":{"lightText":true,"inverseOrder":false,"id":"ImageTextLayoutConfig-5cc73a56-79ef-4ee4-8b93-c762b2ce4ef6","resolvedImage":{"id":67,"sha1":"97e9fc13e8bc414ec93c58b64d599ba5ca85b7df","name":"Buldng of Dongba Campus","altText":"Buldng of Dongba Campus","width":3840,"height":2560,"sizeKB":1108,"uploaderId":3406762,"createdAt":"2025-12-22T13:57:44.403Z"},"resolvedUploadPrefix":"/uploads","backgroundColor":"#103c74","topText":"我们的培养目标","title":"享幸福人生，做中华栋梁","text":"我们的学生以中国为根基，在更广阔的世界中不断拓展认知与边界，在理解自身文化的基础上走向国际舞台，既关注个人发展，也回应时代需求，在中国与世界的交汇中明确方向，承担责任，走向更高的人生目标。","image":"67"}},{"type":"ImageTextLayoutConfig","props":{"lightText":false,"inverseOrder":true,"id":"ImageTextLayoutConfig-096e7d65-8544-4ba8-b7b0-b42c9a7acd35","resolvedImage":{"id":66,"sha1":"7a822d9377fc189c33d4b60980ca3cf841c646b8","name":"Admssons","altText":"ppl plang basketball","width":4000,"height":2667,"sizeKB":321,"uploaderId":3406762,"createdAt":"2025-12-22T13:52:58.599Z"},"resolvedUploadPrefix":"/uploads","topText":"我们的核心素养","title":"仁、智、勇、乐","text":"\\"仁、智、勇、乐\\" 的核心素养贯穿 BAID 学习与生活的各个方面。仁，体现在对他人的关怀与尊重；智，体现在独立思考与理性判断；勇，体现在面对挑战的主动选择；乐，体现在积极投入与持续探索。四者相互支撑，共同构成我们对学生发展的追求。","image":"66"}},{"type":"SpacerConfig","props":{"height":"5rem","id":"SpacerConfig-7b269e49-af93-4fec-bb1e-35e227238fe9"}},{"type":"HighlightsConfig","props":{"id":"HighlightsConfig-cfc87e3d-818e-44ce-923b-f9835ef3c61d","resolvedHighlights":[{"title":"初中项目","text":"初中项目以剑桥课程体系为基础，注重学科基础与探究学习，帮助学生建立清晰的知识结构与学习方法。\\n","image":{"id":67,"sha1":"97e9fc13e8bc414ec93c58b64d599ba5ca85b7df","name":"Buldng of Dongba Campus","altText":"Buldng of Dongba Campus","width":3840,"height":2560,"sizeKB":1108,"uploaderId":3406762,"createdAt":"2025-12-22T13:57:44.403Z"},"link":"/academics/middle-school","linkText":"初中项目"},{"title":"高中项目","text":"高中阶段以 AP 课程为主，为学生提供丰富、多元、有挑战性的课程选择，支持学生根据兴趣与方向开展深入学习。","image":{"id":58,"sha1":"bf11bcc1a751cd8727e990649683c7963fffb0ca","name":"Academics Hero","altText":"People studying around a table","width":3000,"height":2000,"sizeKB":172,"uploaderId":3406762,"createdAt":"2025-12-22T12:44:30.095Z"},"link":"/academics/high-school","linkText":"高中项目"},{"title":"项目式学习","text":"多维素养的项目式学习课程支持学生不断拓宽视野、发掘兴趣、发展潜能，实现全面而有个性的成长。","image":{"id":65,"sha1":"29587e370b2cc9463b8858e7c81b0f51418f5759","name":"Student Projects","altText":"BAID students' ocean protection project","width":1920,"height":1039,"sizeKB":102,"uploaderId":3406762,"createdAt":"2025-12-22T13:31:36.244Z"},"link":"/academics/pbl","linkText":"项目式学习"}],"resolvedUploadPrefix":"/uploads","highlights":[{"title":"初中项目","text":"初中项目以剑桥课程体系为基础，注重学科基础与探究学习，帮助学生建立清晰的知识结构与学习方法。\\n","image":"67","link":"/academics/middle-school","linkText":"初中项目"},{"title":"高中项目","text":"高中阶段以 AP 课程为主，为学生提供丰富、多元、有挑战性的课程选择，支持学生根据兴趣与方向开展深入学习。","image":"58","link":"/academics/high-school","linkText":"高中项目"},{"title":"项目式学习","text":"多维素养的项目式学习课程支持学生不断拓宽视野、发掘兴趣、发展潜能，实现全面而有个性的成长。","image":"65","link":"/academics/pbl","linkText":"项目式学习"}]}},{"type":"AccreditationsConfig","props":{"title":"认证","text":"北京中学国际部获美国 College Board 认证，成为 AP 课程学校；是中国首家获得 CIS 认证的公立中学；同时获授权开设 ACT-GAC 和剑桥课程，并被评为“Apple 杰出学校”。","id":"AccreditationsConfig-30fca930-d13b-41b0-8e5d-267c052ad8bf","resolvedUploadPrefix":"/uploads","resolvedAccreditations":[{"name":"AP 认证","image":{"id":12,"sha1":"ef21dd367573676f30b19b6685110b0b9423b7ea","name":"AP","altText":"AP","width":2485,"height":2047,"sizeKB":24,"uploaderId":3406762,"createdAt":"2025-10-14T05:22:28.035Z"}}],"accreditations":[{"name":"AP 认证","image":"12"}]}},{"type":"AlumniConfig","props":{"title":"校友寄语","alumni":[{"name":"田学姐","quote":"这里是起点，是舞台，是被给予信任的空间。我在这里学会了成为一个全面发展的人，探索自我、理解他人、心怀社会。这里成就了中学的我，也会成就每一位北中人。","image":"13"},{"name":"王学长","quote":"我十分感谢北中对于学生个性化发展的支持和包容。在北京中学的这几年，我获得了兼收并蓄的思考方式、学会了如何培养以热情为导向的自主能动性、也发展了可以伴随我一生的兴趣和友谊。","image":"14"},{"name":"杨学姐","quote":"在我心中，北中的七年像一场温柔缱绻的梦。我在这里成长、蜕变，变成了我喜欢的模样。我永远珍视这里的每一段回忆；每每回首时，它们都能成为我继续前行的力量。","image":"15"}],"id":"AlumniConfig-dfb0d2dd-0764-44c4-8e29-2c405ef2e02d","resolvedAlumni":[{"name":"田学姐","quote":"这里是起点，是舞台，是被给予信任的空间。我在这里学会了成为一个全面发展的人，探索自我、理解他人、心怀社会。这里成就了中学的我，也会成就每一位北中人。","image":{"id":13,"sha1":"3deaf54f489a33abc0c47cfbc989afdc5645caf0","name":"test","altText":"test","width":2117,"height":2823,"sizeKB":456,"uploaderId":3406762,"createdAt":"2025-10-14T05:24:36.595Z"}},{"name":"王学长","quote":"我十分感谢北中对于学生个性化发展的支持和包容。在北京中学的这几年，我获得了兼收并蓄的思考方式、学会了如何培养以热情为导向的自主能动性、也发展了可以伴随我一生的兴趣和友谊。","image":{"id":14,"sha1":"e1e2b77aa65ff98f6a88142aabfa47d15a322ee5","name":"test","altText":"test","width":1280,"height":1920,"sizeKB":118,"uploaderId":3406762,"createdAt":"2025-10-14T05:24:45.417Z"}},{"name":"杨学姐","quote":"在我心中，北中的七年像一场温柔缱绻的梦。我在这里成长、蜕变，变成了我喜欢的模样。我永远珍视这里的每一段回忆；每每回首时，它们都能成为我继续前行的力量。","image":{"id":15,"sha1":"97c3ed00e738280bd2dcf2e7c71cd1686c238d83","name":"test","altText":"test","width":3024,"height":4032,"sizeKB":725,"uploaderId":3406762,"createdAt":"2025-10-14T05:25:32.779Z"}}],"resolvedUploadPrefix":"/uploads"}},{"type":"QuoteConfig","props":{"text":"我们会让校园成为师生的精神家园，让校园成为师生的学习中心，让校园成为师生的创新沃土，进而让孩子们能爱别人、帮助别人、尊重别人。","source":"北京中学校长 夏青峰","id":"QuoteConfig-62b5a687-262c-4487-a4cf-596ae73c0c69","resolvedImage":{"id":10,"sha1":"b32b8acdc3a560f8264489a45ab7ee48d8a4a68b","name":"xqf","altText":"xqf","width":1920,"height":2880,"sizeKB":130,"uploaderId":3406762,"createdAt":"2025-10-14T03:25:23.284Z"},"resolvedUploadPrefix":"/uploads","image":"10"}},{"type":"ButtonConfig","props":{"text":"了解 BAID 的招生项目","link":"/admissions","blank":false,"color":"blue","size":"md","align":"center","id":"ButtonConfig-49bd81e0-2564-44b4-b26f-7f87ac5ecec8"}},{"type":"SpacerConfig","props":{"height":"64px","id":"SpacerConfig-3970e5e5-0670-41e1-a6f7-77c69516f84b"}}],"zones":{}}	{"root":{"props":{"title":"About Us"},"type":"root"},"content":[{"type":"SpacerConfig","props":{"height":"5rem","id":"SpacerConfig-36255b24-aa8d-4db7-af7d-03d2a8f64652"}},{"type":"HorizontalTopTextConfig","props":{"title":"Our Mission","text":"Cultivate well-rounded, forward-thinking leaders of the future with a modern education rooted in Chinese values and global perspectives.\\n","id":"HorizontalTopTextConfig-9b48f545-0734-4fbd-9c9f-1f918d26d29c"}},{"type":"SpacerConfig","props":{"height":"5rem","id":"SpacerConfig-89485068-6657-4376-9f52-f668114d671d"}},{"type":"HeroConfig","props":{"title":"About Us","backgroundColor":"#ffffff","lightText":false,"id":"HeroConfig-0b5efe89-2da0-4c19-a034-06bfb195d64c","resolvedImage":{"id":11,"sha1":"c3362d9dcace9926f10970230152d0d4869e1448","name":"Test","altText":"Test","width":3840,"height":2563,"sizeKB":2517,"uploaderId":3406762,"createdAt":"2025-10-14T05:01:29.874Z"},"resolvedUploadPrefix":"/uploads","image":"11"}},{"type":"GridTextConfig","props":{"title":"Overview","texts":[{"text":"Beijing Academy was established in September 2013. We are a 12-year public school approved by the Beijing Municipal Government and funded by the Chaoyang District Government. Our school is built to become a modern community with a unique Beijing style, a distinctive Chinese character and a global perspective."},{"text":"In 2020, BAID was approved by the Beijing Municipal Education Commission as a sino-foreign cooperative high school education program. We are an authorized AP school, a CIS member school, an ACT testing center, and a Cambridge International Curriculum school."},{"text":"Beijing Academy promotes students' comprehensive personal growth. We believe that through the efforts of both our students and teachers, we can realize our motto: \\"Better me, better world,\\" and that all of us will make the world a better place."}],"id":"GridTextConfig-719ecbf3-37cb-4242-911f-ecf9f798912d"}},{"type":"BentoBoxConfig","props":{"title":"At a Glance","motto":"Better Me, Better World","mottoText":"The motto that sits at the heart of everything we do at Beijing Academy\\n","admissionsTitle":"Outstanding college outcomes","admissionsText":"Students and graduates from Beijing Academy have been accepted to Harvard, Stanford, Imperial, McGill, HKU, University of Tokyo, and more.\\n","facultyTitle":"World-class faculty","facultyText":"93% postgraduate","countriesTitle":"From Beijing to the world","countriesText":"This year, BAID graduates will study in six countries/regions around the globe.\\n","academicsTitle":"Academic Excellence","academicsText":"With over 20 AP courses and undergraduate-level courses, the MFP research program, project-based learning and more, BAID prepares students for success in college and beyond.","lifeText":"Live the best years of your life","diversityText":"Faculty from 7 countries","id":"BentoBoxConfig-92282cb8-5517-4601-8929-7efaba06dd59"}},{"type":"StatisticsConfig","props":{"title":"BAID in Numbers","content":[{"name":"teacher-student ratio","value":"1:7"},{"name":"postgraduate faculty","value":"93%"},{"name":"average homeroom size","value":"~20"},{"name":"students","value":"375"},{"name":"academic courses","value":"72"},{"name":"Advanced Placement (AP) courses","value":"22"}],"id":"StatisticsConfig-7a8423bf-1c05-40dd-936e-72aac5c875a1"}},{"type":"ImageTextLayoutConfig","props":{"lightText":false,"inverseOrder":false,"id":"ImageTextLayoutConfig-b432d44f-c557-4913-a39d-560c12c56e93","resolvedImage":{"id":59,"sha1":"dfdbae4816a16dd1a41563aac9cf52ecfdf204ee","name":"BA Lectures","altText":"olympics gold medalist Yang Yang at an event","width":1080,"height":720,"sizeKB":68,"uploaderId":3406762,"createdAt":"2025-12-22T12:49:50.419Z"},"resolvedUploadPrefix":"/uploads","title":"Better Me, Better World","image":"59","text":"\\"Better me, better world\\" is the direction that guides every Beijing Academy student. It begins with attention to the people and needs around us, and grows through real service and real action. Through experience, reflection, and effort, students come to understand responsibility, learn to contribute, and make a true difference in the lives of others.","topText":"Our Motto"}},{"type":"ImageTextLayoutConfig","props":{"lightText":true,"inverseOrder":true,"id":"ImageTextLayoutConfig-f64bfcee-fe7e-4ec1-b357-fa846d964485","resolvedImage":{"id":62,"sha1":"073e82273837daeeaeec0f2e8a4603b962cbb875","name":"BA World School","altText":"Test","width":1280,"height":960,"sizeKB":316,"uploaderId":3406762,"createdAt":"2025-12-22T12:50:43.209Z"},"resolvedUploadPrefix":"/uploads","backgroundColor":"#9f0612","topText":"Our Spirit","title":"Harmony in Diversity, Joy in Learning","text":"BAID is a community that welcomes many voices, values differences, and grows through connection and collaboration. Students with different backgrounds and different interests learn from one another, inspire one another, and thrive together. Here, curiosity is encouraged, individuality is respected, and school life is filled with energy, warmth, and purpose.","image":"62"}},{"type":"ImageTextLayoutConfig","props":{"lightText":true,"inverseOrder":false,"id":"ImageTextLayoutConfig-5cc73a56-79ef-4ee4-8b93-c762b2ce4ef6","resolvedImage":{"id":67,"sha1":"97e9fc13e8bc414ec93c58b64d599ba5ca85b7df","name":"Buldng of Dongba Campus","altText":"Buldng of Dongba Campus","width":3840,"height":2560,"sizeKB":1108,"uploaderId":3406762,"createdAt":"2025-12-22T13:57:44.403Z"},"resolvedUploadPrefix":"/uploads","backgroundColor":"#103c74","topText":"Our Educational Vision","title":"Live Well, Stand Tall","text":"Rooted in China and open to the world, BAID students grow with both confidence and perspective. They deepen their understanding of their own culture even as they step onto a broader global stage. They pursue personal growth, respond to the needs of their time, and find their place at the meeting point of China and the world—ready to take responsibility and aim higher.","image":"67"}},{"type":"ImageTextLayoutConfig","props":{"lightText":false,"inverseOrder":true,"id":"ImageTextLayoutConfig-096e7d65-8544-4ba8-b7b0-b42c9a7acd35","resolvedImage":{"id":66,"sha1":"7a822d9377fc189c33d4b60980ca3cf841c646b8","name":"Admssons","altText":"ppl plang basketball","width":4000,"height":2667,"sizeKB":321,"uploaderId":3406762,"createdAt":"2025-12-22T13:52:58.599Z"},"resolvedUploadPrefix":"/uploads","topText":"Our Core Values","title":"Compassion, Wisdom, Courage, Joy","text":"These four values run through every part of life at BAID. Compassion means caring for others with respect and empathy. Wisdom means thinking independently and judging thoughtfully. Courage means stepping forward to meet challenge with resolve. Joy means engaging fully, exploring widely, and finding meaning in the process. Together, they express the kind of growth BAID hopes to nurture in every student.","image":"66"}},{"type":"SpacerConfig","props":{"height":"5rem","id":"SpacerConfig-7b269e49-af93-4fec-bb1e-35e227238fe9"}},{"type":"HighlightsConfig","props":{"id":"HighlightsConfig-cfc87e3d-818e-44ce-923b-f9835ef3c61d","resolvedHighlights":[{"title":"Middle School","text":"Our middle school program is based on the Cambridge Lower Secondary curriculum, building strong foundations and inquiry skills.","image":{"id":67,"sha1":"97e9fc13e8bc414ec93c58b64d599ba5ca85b7df","name":"Buldng of Dongba Campus","altText":"Buldng of Dongba Campus","width":3840,"height":2560,"sizeKB":1108,"uploaderId":3406762,"createdAt":"2025-12-22T13:57:44.403Z"},"link":"/academics/middle-school","linkText":"Middle School Program"},{"title":"High School","text":"Our high school program centers on AP courses, offering rigorous courses and focused academic pathways.","image":{"id":58,"sha1":"bf11bcc1a751cd8727e990649683c7963fffb0ca","name":"Academics Hero","altText":"People studying around a table","width":3000,"height":2000,"sizeKB":172,"uploaderId":3406762,"createdAt":"2025-12-22T12:44:30.095Z"},"link":"/academics/high-school","linkText":"High School Program"},{"title":"Project-Based Learning","text":"At BAID, education is more than grades. Through our project-based learning curriculum, students develop their individual strengths beyond the classroom.\\n","image":{"id":65,"sha1":"29587e370b2cc9463b8858e7c81b0f51418f5759","name":"Student Projects","altText":"BAID students' ocean protection project","width":1920,"height":1039,"sizeKB":102,"uploaderId":3406762,"createdAt":"2025-12-22T13:31:36.244Z"},"link":"/academics/pbl","linkText":"Project-Based Learning"}],"resolvedUploadPrefix":"/uploads","highlights":[{"title":"Middle School","text":"Our middle school program is based on the Cambridge Lower Secondary curriculum, building strong foundations and inquiry skills.","image":"67","link":"/academics/middle-school","linkText":"Middle School Program"},{"title":"High School","text":"Our high school program centers on AP courses, offering rigorous courses and focused academic pathways.","image":"58","link":"/academics/high-school","linkText":"High School Program"},{"title":"Project-Based Learning","text":"At BAID, education is more than grades. Through our project-based learning curriculum, students develop their individual strengths beyond the classroom.\\n","image":"65","link":"/academics/pbl","linkText":"Project-Based Learning"}]}},{"type":"AccreditationsConfig","props":{"title":"Accreditation","text":"BAID is authorized as an AP curriculum school by the College Board. We are the first public high school in China to receive CIS accreditation, and an authorized global ACT-GAC official teaching and testing center. We are authorized with the Cambridge international curriculum, and has been designated as an \\"Apple Distinguished School.\\"\\n","id":"AccreditationsConfig-30fca930-d13b-41b0-8e5d-267c052ad8bf","resolvedUploadPrefix":"/uploads","resolvedAccreditations":[{"name":"AP authorized","image":{"id":12,"sha1":"ef21dd367573676f30b19b6685110b0b9423b7ea","name":"AP","altText":"AP","width":2485,"height":2047,"sizeKB":24,"uploaderId":3406762,"createdAt":"2025-10-14T05:22:28.035Z"}}],"accreditations":[{"name":"AP authorized","image":"12"}]}},{"type":"AlumniConfig","props":{"title":"Alumni Words","alumni":[{"name":"Ms. Tian","quote":"Here is the beginning, the stage, a space of trust bestowed. Here, I learned to grow whole — to seek myself, to understand others, to hold the world in my heart. BAID has shaped my youth, and it will shape every BAIDer, too.","image":"13"},{"name":"Mr. Wang","quote":"Over my years at Beijing Academy, I've gained an inclusive way of thinking, learning to cultivate self-driven initiative fueled by passion. Along the way, I've developed lifelong interests and friendships.","image":"14"},{"name":"Ms. Yang","quote":"To me, my seven years at Beijing Academy have been a tender, lingering dream — where I grew, transformed, and became someone I love, each memory a quiet force that sends me forward.","image":"15"}],"id":"AlumniConfig-dfb0d2dd-0764-44c4-8e29-2c405ef2e02d","resolvedAlumni":[{"name":"Ms. Tian","quote":"Here is the beginning, the stage, a space of trust bestowed. Here, I learned to grow whole — to seek myself, to understand others, to hold the world in my heart. BAID has shaped my youth, and it will shape every BAIDer, too.","image":{"id":13,"sha1":"3deaf54f489a33abc0c47cfbc989afdc5645caf0","name":"test","altText":"test","width":2117,"height":2823,"sizeKB":456,"uploaderId":3406762,"createdAt":"2025-10-14T05:24:36.595Z"}},{"name":"Mr. Wang","quote":"Over my years at Beijing Academy, I've gained an inclusive way of thinking, learning to cultivate self-driven initiative fueled by passion. Along the way, I've developed lifelong interests and friendships.","image":{"id":14,"sha1":"e1e2b77aa65ff98f6a88142aabfa47d15a322ee5","name":"test","altText":"test","width":1280,"height":1920,"sizeKB":118,"uploaderId":3406762,"createdAt":"2025-10-14T05:24:45.417Z"}},{"name":"Ms. Yang","quote":"To me, my seven years at Beijing Academy have been a tender, lingering dream — where I grew, transformed, and became someone I love, each memory a quiet force that sends me forward.","image":{"id":15,"sha1":"97c3ed00e738280bd2dcf2e7c71cd1686c238d83","name":"test","altText":"test","width":3024,"height":4032,"sizeKB":725,"uploaderId":3406762,"createdAt":"2025-10-14T05:25:32.779Z"}}],"resolvedUploadPrefix":"/uploads"}},{"type":"QuoteConfig","props":{"text":"We will make our campus a spiritual home, a center of learning, and a fertile ground for innovation for both students and teachers — a place where they can learn to love others, help others, and respect others.","source":"Xia Qingfeng, Principal of Beijing Academy","id":"QuoteConfig-62b5a687-262c-4487-a4cf-596ae73c0c69","resolvedImage":{"id":10,"sha1":"b32b8acdc3a560f8264489a45ab7ee48d8a4a68b","name":"xqf","altText":"xqf","width":1920,"height":2880,"sizeKB":130,"uploaderId":3406762,"createdAt":"2025-10-14T03:25:23.284Z"},"resolvedUploadPrefix":"/uploads","image":"10"}},{"type":"ButtonConfig","props":{"text":"Learn more about admissions at BAID","link":"/admissions","blank":false,"color":"blue","size":"md","align":"center","id":"ButtonConfig-49bd81e0-2564-44b4-b26f-7f87ac5ecec8"}},{"type":"SpacerConfig","props":{"height":"64px","id":"SpacerConfig-3970e5e5-0670-41e1-a6f7-77c69516f84b"}}],"zones":{}}	{"root":{"props":{"title":"关于我们"},"type":"root"},"content":[{"type":"SpacerConfig","props":{"height":"5rem","id":"SpacerConfig-36255b24-aa8d-4db7-af7d-03d2a8f64652"}},{"type":"HorizontalTopTextConfig","props":{"title":"我们的使命","text":"以立足北京、植根中国、面向世界的现代教育，培养全面发展的未来领袖。","id":"HorizontalTopTextConfig-9b48f545-0734-4fbd-9c9f-1f918d26d29c"}},{"type":"SpacerConfig","props":{"height":"5rem","id":"SpacerConfig-89485068-6657-4376-9f52-f668114d671d"}},{"type":"HeroConfig","props":{"title":"About Us","backgroundColor":"#ffffff","lightText":false,"id":"HeroConfig-0b5efe89-2da0-4c19-a034-06bfb195d64c","resolvedImage":{"id":11,"sha1":"c3362d9dcace9926f10970230152d0d4869e1448","name":"Test","altText":"Test","width":3840,"height":2563,"sizeKB":2517,"uploaderId":3406762,"createdAt":"2025-10-14T05:01:29.874Z"},"resolvedUploadPrefix":"/uploads","image":"11"}},{"type":"GridTextConfig","props":{"title":"总览","texts":[{"text":"北京中学成立于 2013 年 9 月，是经北京市政府批准，由朝阳区政府创办的一所十二年一贯制的公办学校，致力于办成一所具有北京风格、中国气质与世界胸怀的现代学校。"},{"text":"2020 年，北京中学中外合作办学项目 (北京中学国际部) 获北京市教委批准。我们是 AP 授权校、CIS 认证成员学校、ACT 考试中心与剑桥国际课程学校。北京中学国际部提供中国高中课程、AP 课程与特色课程融合的课程体系。"},{"text":"北京中学始终致力于学生的全面与自由成长。我们相信，在全体师生的努力下，“世界因我更美好”的校训将真正照进现实。"}],"id":"GridTextConfig-719ecbf3-37cb-4242-911f-ecf9f798912d"}},{"type":"BentoBoxConfig","props":{"title":"一览 BAID","motto":"世界因我更美好","mottoText":"我们的校训，也是我们一切行动的指南","admissionsTitle":"优异的升学结果","admissionsText":"自 2017 年成立以来，北京中学国际部的学生已被哈佛、斯坦福、牛津、剑桥、麦吉尔、香港大学、东京大学等世界顶尖大学录取。","facultyTitle":"优秀师资队伍","facultyText":"93% 具有硕博学位","countriesTitle":"来自北京 面向世界","countriesText":"今年，北京中学国际部的毕业生将前往六个国家和地区继续深造。","academicsTitle":"学术卓越","academicsText":"北京中学国际部提供二十多门 AP 课程、本科级别课程、MFP 科研项目和项目式学习，全面支持学生为大学和未来发展做好准备。","lifeText":"享受人生的青葱年华","diversityText":"来自七个国家的教师团队","id":"BentoBoxConfig-92282cb8-5517-4601-8929-7efaba06dd59"}},{"type":"StatisticsConfig","props":{"title":"从数字看 BAID","content":[{"name":"师生比","value":"1:7"},{"name":"硕博教师比","value":"93%"},{"name":"班额","value":"~20"},{"name":"学生","value":"375"},{"name":"学术课程","value":"72"},{"name":"AP 课程","value":"22"}],"id":"StatisticsConfig-7a8423bf-1c05-40dd-936e-72aac5c875a1"}},{"type":"ImageTextLayoutConfig","props":{"lightText":false,"inverseOrder":false,"id":"ImageTextLayoutConfig-b432d44f-c557-4913-a39d-560c12c56e93","resolvedImage":{"id":59,"sha1":"dfdbae4816a16dd1a41563aac9cf52ecfdf204ee","name":"BA Lectures","altText":"olympics gold medalist Yang Yang at an event","width":1080,"height":720,"sizeKB":68,"uploaderId":3406762,"createdAt":"2025-12-22T12:49:50.419Z"},"resolvedUploadPrefix":"/uploads","title":"世界因我更美好","image":"59","text":"“世界因我更美好” 是北京中学每一位学生的行动方向。从关注身边的人与事出发，在一次次真实的服务与实践中，理解责任、学会付出。我们的学生在不断尝试与反思中，逐步形成面向社会的担当意识，用具体行动为他人带来改变。","topText":"我们的校训"}},{"type":"ImageTextLayoutConfig","props":{"lightText":true,"inverseOrder":true,"id":"ImageTextLayoutConfig-f64bfcee-fe7e-4ec1-b357-fa846d964485","resolvedImage":{"id":62,"sha1":"073e82273837daeeaeec0f2e8a4603b962cbb875","name":"BA World School","altText":"Test","width":1280,"height":960,"sizeKB":316,"uploaderId":3406762,"createdAt":"2025-12-22T12:50:43.209Z"},"resolvedUploadPrefix":"/uploads","backgroundColor":"#9f0612","topText":"我们的校风","title":"和而不同，乐在其中","text":"BAID 的社区热爱多元表达，尊重差异，在交流与合作中形成了开放、包容的氛围。不同背景、不同兴趣的学生在同一空间中相互理解、彼此激发，在参与中找到热情，在探索中获得乐趣，形成积极而有温度的校园环境。\\n","image":"62"}},{"type":"ImageTextLayoutConfig","props":{"lightText":true,"inverseOrder":false,"id":"ImageTextLayoutConfig-5cc73a56-79ef-4ee4-8b93-c762b2ce4ef6","resolvedImage":{"id":67,"sha1":"97e9fc13e8bc414ec93c58b64d599ba5ca85b7df","name":"Buldng of Dongba Campus","altText":"Buldng of Dongba Campus","width":3840,"height":2560,"sizeKB":1108,"uploaderId":3406762,"createdAt":"2025-12-22T13:57:44.403Z"},"resolvedUploadPrefix":"/uploads","backgroundColor":"#103c74","topText":"我们的培养目标","title":"享幸福人生，做中华栋梁","text":"我们的学生以中国为根基，在更广阔的世界中不断拓展认知与边界，在理解自身文化的基础上走向国际舞台，既关注个人发展，也回应时代需求，在中国与世界的交汇中明确方向，承担责任，走向更高的人生目标。","image":"67"}},{"type":"ImageTextLayoutConfig","props":{"lightText":false,"inverseOrder":true,"id":"ImageTextLayoutConfig-096e7d65-8544-4ba8-b7b0-b42c9a7acd35","resolvedImage":{"id":66,"sha1":"7a822d9377fc189c33d4b60980ca3cf841c646b8","name":"Admssons","altText":"ppl plang basketball","width":4000,"height":2667,"sizeKB":321,"uploaderId":3406762,"createdAt":"2025-12-22T13:52:58.599Z"},"resolvedUploadPrefix":"/uploads","topText":"我们的核心素养","title":"仁、智、勇、乐","text":"\\"仁、智、勇、乐\\" 的核心素养贯穿 BAID 学习与生活的各个方面。仁，体现在对他人的关怀与尊重；智，体现在独立思考与理性判断；勇，体现在面对挑战的主动选择；乐，体现在积极投入与持续探索。四者相互支撑，共同构成我们对学生发展的追求。","image":"66"}},{"type":"SpacerConfig","props":{"height":"5rem","id":"SpacerConfig-7b269e49-af93-4fec-bb1e-35e227238fe9"}},{"type":"HighlightsConfig","props":{"id":"HighlightsConfig-cfc87e3d-818e-44ce-923b-f9835ef3c61d","resolvedHighlights":[{"title":"初中项目","text":"初中项目以剑桥课程体系为基础，注重学科基础与探究学习，帮助学生建立清晰的知识结构与学习方法。\\n","image":{"id":67,"sha1":"97e9fc13e8bc414ec93c58b64d599ba5ca85b7df","name":"Buldng of Dongba Campus","altText":"Buldng of Dongba Campus","width":3840,"height":2560,"sizeKB":1108,"uploaderId":3406762,"createdAt":"2025-12-22T13:57:44.403Z"},"link":"/academics/middle-school","linkText":"初中项目"},{"title":"高中项目","text":"高中阶段以 AP 课程为主，为学生提供丰富、多元、有挑战性的课程选择，支持学生根据兴趣与方向开展深入学习。","image":{"id":58,"sha1":"bf11bcc1a751cd8727e990649683c7963fffb0ca","name":"Academics Hero","altText":"People studying around a table","width":3000,"height":2000,"sizeKB":172,"uploaderId":3406762,"createdAt":"2025-12-22T12:44:30.095Z"},"link":"/academics/high-school","linkText":"高中项目"},{"title":"项目式学习","text":"多维素养的项目式学习课程支持学生不断拓宽视野、发掘兴趣、发展潜能，实现全面而有个性的成长。","image":{"id":65,"sha1":"29587e370b2cc9463b8858e7c81b0f51418f5759","name":"Student Projects","altText":"BAID students' ocean protection project","width":1920,"height":1039,"sizeKB":102,"uploaderId":3406762,"createdAt":"2025-12-22T13:31:36.244Z"},"link":"/academics/pbl","linkText":"项目式学习"}],"resolvedUploadPrefix":"/uploads","highlights":[{"title":"初中项目","text":"初中项目以剑桥课程体系为基础，注重学科基础与探究学习，帮助学生建立清晰的知识结构与学习方法。\\n","image":"67","link":"/academics/middle-school","linkText":"初中项目"},{"title":"高中项目","text":"高中阶段以 AP 课程为主，为学生提供丰富、多元、有挑战性的课程选择，支持学生根据兴趣与方向开展深入学习。","image":"58","link":"/academics/high-school","linkText":"高中项目"},{"title":"项目式学习","text":"多维素养的项目式学习课程支持学生不断拓宽视野、发掘兴趣、发展潜能，实现全面而有个性的成长。","image":"65","link":"/academics/pbl","linkText":"项目式学习"}]}},{"type":"AccreditationsConfig","props":{"title":"认证","text":"北京中学国际部获美国 College Board 认证，成为 AP 课程学校；是中国首家获得 CIS 认证的公立中学；同时获授权开设 ACT-GAC 和剑桥课程，并被评为“Apple 杰出学校”。","id":"AccreditationsConfig-30fca930-d13b-41b0-8e5d-267c052ad8bf","resolvedUploadPrefix":"/uploads","resolvedAccreditations":[{"name":"AP 认证","image":{"id":12,"sha1":"ef21dd367573676f30b19b6685110b0b9423b7ea","name":"AP","altText":"AP","width":2485,"height":2047,"sizeKB":24,"uploaderId":3406762,"createdAt":"2025-10-14T05:22:28.035Z"}}],"accreditations":[{"name":"AP 认证","image":"12"}]}},{"type":"AlumniConfig","props":{"title":"校友寄语","alumni":[{"name":"田学姐","quote":"这里是起点，是舞台，是被给予信任的空间。我在这里学会了成为一个全面发展的人，探索自我、理解他人、心怀社会。这里成就了中学的我，也会成就每一位北中人。","image":"13"},{"name":"王学长","quote":"我十分感谢北中对于学生个性化发展的支持和包容。在北京中学的这几年，我获得了兼收并蓄的思考方式、学会了如何培养以热情为导向的自主能动性、也发展了可以伴随我一生的兴趣和友谊。","image":"14"},{"name":"杨学姐","quote":"在我心中，北中的七年像一场温柔缱绻的梦。我在这里成长、蜕变，变成了我喜欢的模样。我永远珍视这里的每一段回忆；每每回首时，它们都能成为我继续前行的力量。","image":"15"}],"id":"AlumniConfig-dfb0d2dd-0764-44c4-8e29-2c405ef2e02d","resolvedAlumni":[{"name":"田学姐","quote":"这里是起点，是舞台，是被给予信任的空间。我在这里学会了成为一个全面发展的人，探索自我、理解他人、心怀社会。这里成就了中学的我，也会成就每一位北中人。","image":{"id":13,"sha1":"3deaf54f489a33abc0c47cfbc989afdc5645caf0","name":"test","altText":"test","width":2117,"height":2823,"sizeKB":456,"uploaderId":3406762,"createdAt":"2025-10-14T05:24:36.595Z"}},{"name":"王学长","quote":"我十分感谢北中对于学生个性化发展的支持和包容。在北京中学的这几年，我获得了兼收并蓄的思考方式、学会了如何培养以热情为导向的自主能动性、也发展了可以伴随我一生的兴趣和友谊。","image":{"id":14,"sha1":"e1e2b77aa65ff98f6a88142aabfa47d15a322ee5","name":"test","altText":"test","width":1280,"height":1920,"sizeKB":118,"uploaderId":3406762,"createdAt":"2025-10-14T05:24:45.417Z"}},{"name":"杨学姐","quote":"在我心中，北中的七年像一场温柔缱绻的梦。我在这里成长、蜕变，变成了我喜欢的模样。我永远珍视这里的每一段回忆；每每回首时，它们都能成为我继续前行的力量。","image":{"id":15,"sha1":"97c3ed00e738280bd2dcf2e7c71cd1686c238d83","name":"test","altText":"test","width":3024,"height":4032,"sizeKB":725,"uploaderId":3406762,"createdAt":"2025-10-14T05:25:32.779Z"}}],"resolvedUploadPrefix":"/uploads"}},{"type":"QuoteConfig","props":{"text":"我们会让校园成为师生的精神家园，让校园成为师生的学习中心，让校园成为师生的创新沃土，进而让孩子们能爱别人、帮助别人、尊重别人。","source":"北京中学校长 夏青峰","id":"QuoteConfig-62b5a687-262c-4487-a4cf-596ae73c0c69","resolvedImage":{"id":10,"sha1":"b32b8acdc3a560f8264489a45ab7ee48d8a4a68b","name":"xqf","altText":"xqf","width":1920,"height":2880,"sizeKB":130,"uploaderId":3406762,"createdAt":"2025-10-14T03:25:23.284Z"},"resolvedUploadPrefix":"/uploads","image":"10"}},{"type":"ButtonConfig","props":{"text":"了解 BAID 的招生项目","link":"/admissions","blank":false,"color":"blue","size":"md","align":"center","id":"ButtonConfig-49bd81e0-2564-44b4-b26f-7f87ac5ecec8"}},{"type":"SpacerConfig","props":{"height":"64px","id":"SpacerConfig-3970e5e5-0670-41e1-a6f7-77c69516f84b"}}],"zones":{}}	\N	\N	3406762	2025-10-14 04:59:21.385	2026-04-05 03:55:20.378	\N	\N	\N	\N	\N	\N
24	course	AP Biology	AP 生物	AP Biology	AP 生物	ap-biology					\N	\N	3406762	2025-12-22 13:02:27.629	2025-12-22 13:02:46.782	AP	AP	\N	\N	\N	\N
21	post	#BAIDer | Exhibition Review: A Feast for the Other – From 'The Vegetarian' to Ecofeminism	BAIDer | 展览回顾——她者的盛宴：从《素食者》到生态女性主义	#BAIDer | Exhibition Review: A Feast for the Other – From 'The Vegetarian' to Ecofeminism	BAIDer | 展览回顾——她者的盛宴：从《素食者》到生态女性主义	baider-exhibition-review-a-feast-for-the-other-from-the-vegetarian-to-ecofeminism	## A Feast for the Other｜Exhibition Review\n\nFrom 'The Vegetarian' to Ecofeminism\n\n[IMAGE: 47]\n\n"She quietly took a breath and stared intently at the trees 'burning fiercely' by the roadside; they stood like countless beasts, emanating a green light. Her gaze was dark and resolute, as if waiting for an answer, or rather, more like expressing a protest."\n\nExcerpt from "The Vegetarian" by Han Kang\n\n[IMAGE: 51]\n\n"An exhibition is a language; like literature or film, it has rhythm, pauses, and climaxes." — Daniel Birnbaum\n\n## Preface\n\nThe 2024 Nobel Prize in Literature was awarded to South Korean author Han Kang. Her representative work, "The Vegetarian," depicts with striking intensity the story of a woman oppressed by a patriarchal society. Through extreme vegetarianism, she refuses to eat meat, ultimately transforming herself into a tree as an act of rebellion. This work has sparked widespread discussion on ecofeminism globally. Han Kang uses delicate language to portray many thought-provoking images, her words inevitably stirring in readers a desire for visual imagination and creation.\n\n[IMAGE: 57]\n\nThis exhibition aims to respond to this creative impulse through works by Beijing Academy students, CAFA graduates, and artists, telling the story of an "Other" who, after being marginalized by society, undergoes self-awakening, rejects injustice, and ultimately takes active resistance. The exhibition concludes by reflecting on societal and individual actions, prompting viewers to contemplate the causes behind the tragedies faced by marginalized groups in society.\n\nFrom the perspective of ecofeminism, this exhibition attempts, by drawing analogies between the oppression and exploitation faced by marginalized groups and the ecological environment, to guide the audience towards a deeper understanding of the injustices women face and to inspire reflection and empathy for their plight.\n\n[IMAGE: 49]\n\n## The Exhibition in Progress\n\nOn June 26, 2025, the exhibition officially opened, with Beijing Academy students and teachers enthusiastically participating in the opening ceremony. An interactive flower arrangement station, popular among students, was thoughtfully set up on site. The curators hoped that through flower arranging, everyone could more profoundly feel the potential connection between women and plants.\n\n[IMAGE: 48]\n\nDuring the opening ceremony, Vice Principal Zhou Hui of Beijing Academy delivered a speech, expressing positive expectations for the exhibition.\n\nThis exhibition is divided into three units:\n\n- **Germination: In Bud**\n- **Growth: Springing Up**\n- **Return: Intertwined Roots**\n\nThe artworks on display encompass a variety of forms, including painting, installation, and video.\n\n[IMAGE: 53]\n\n### Germination: In Bud\n\nThe flower within the bud is restricted, bound. Each fragile petal embraces the others, gazing inward, constantly engaging in self-examination, accumulating a strong desire to break free from confinement. Upon realizing this, the bud achieves self-awakening, begins to reach outward, rejects the inwardly closed environment, and takes the first step of resistance.\n\n[IMAGE: 55]\n\n### Growth: Springing Up\n\nRain can be a dramatic baptism or a reminder from heaven. After the rain, bamboo shoots break through the soil, encountering a崭新的 world anew. However, what awaits them might be being cruelly cut down by humans, or growing into a natural ecosystem where branches, leaves, and lifeblood are interconnected. Breaking through the soil, escaping the dark underground, rebuilding in the light—after resistance, will they achieve victory, continue in silence, or face an even crueler tragedy?\n\n[IMAGE: 56]\n\n### Return: Intertwined Roots\n\nWhen the self, the plant individual, finally achieves victory or meets tragedy, the exploration of the underlying reasons naturally unfolds. Returning to the plant's complex root system—does the entanglement of roots inadvertently implicate each other, or do they help one another? What truly happens out of sight? Can we clearly explain it?\n\n## Reading Club\n\n[IMAGE: 52]\n\nThe reason for the exhibition's English title, "Synesthesia," is the hope that through the fusion of the text from the book and the visual language of the exhibition, thoughts can deeply潜入 the discussion of the same topic, creating a "feast" of ideas through the碰撞 of understanding phenomena.\n\nTherefore, following the exhibition, the curators held a reading club centered on "The Vegetarian" to further explore feminist issues. The reading club was divided into three parts:\n\n1. Guest Sharing\n2. Free Discussion\n3. Collage Creation\n\n[IMAGE: 44]\n\nDuring the guest sharing session, participants compared the experiences of the protagonist in "The Vegetarian" with those in "Howl's Moving Castle," exploring the similarities and differences in the two protagonists' journeys of self-discovery. This was followed by discussions on themes such as binary oppositions and the boundaries of madness.\n\nIn the free discussion segment, the conversation revolved around the character portrayals and specific imagery in "The Vegetarian," and also touched upon social phenomena related to sexual minority groups.\n\n[IMAGE: 50]\n\n## Reflections\n\n### Curator Wang Yiyi\n\n[IMAGE: 45]\n\nFor me, the "A Feast for the Other" exhibition was an activity free from功利性 pressures after the college application season, a more mature collaboration compared to previous ones, and a deeper exploration of feminism. Throughout the process of organizing the exhibition, Zhang Ruochen and I continuously refined and expanded our initial rough ideas, read many related books and literature, and constantly optimized the outcome based on suggestions from Teacher Hu Jie and Teacher Ren Qiuming, ultimately arriving at a complete exhibition. I am very grateful to my fellow student Zhang Ruochen for providing me with such a curatorial experience, free from the pressures of the application season.\n\n### Curator Zhang Ruochen\n\n[IMAGE: 46]\n\nThis was my first attempt at curating using "narrative," no longer simply围绕 a theme, but letting the exhibition unfold like a storyline. This attempt gave me a new understanding and exploration of exhibition language. From the initial inspiration of "The Vegetarian," to reflections on ecofeminism, and then to the metaphor of "Germination—Growth—Return," each step was the crystallization of numerous brainstorming sessions. I hope these explorations not only deepened the theme but also allowed the artworks to gradually走近 the audience within the exhibition, generating more exchange and resonance.\n\nI was very fortunate to collaborate with Senior Wang Yiyi, from whom I learned valuable lessons about planning, design, and installation. The installation process, though accompanied by setbacks and uncertainties, was ultimately successful thanks to the continuous support and encouragement from the teachers, making the entire process very fulfilling and rewarding.\n\n### Participating Artist Lyu Jingwen\n\n[IMAGE: 42]\n\nI participated in the feminist-themed exhibition "A Feast for the Other" as a creator, exhibiting three pieces from a series. This group of works, through the成长 narrative of a girl, presents the双重凝视 (both the gaze projected from the outside world and the introspection stemming from within) brought about by the symbolization of gender, thereby exploring the phenomenon of self-objectification formed by contemporary women under social discipline. This exhibition constructed an extremely artistically charged dialogue scene. The震撼力-filled creations of other participating artists added extraordinary charm and depth to this aesthetic discussion on feminism.\n\n[IMAGE: 43]\n\n[IMAGE: 54]\n\n## Concluding Words\n\nThe successful holding of this exhibition离不开 the care and support of teachers and students. We would like to specially thank Principal Zhou Hui for her strong support; Teachers Hu Jie, Ren Qiuming, and Lin Xuejiao for their guidance in planning and implementation; Teacher Wang Pengyu for his assistance in thematic deepening; and the CAFA students for their active participation. We also extend our gratitude to Ju Dui for their assistance, and to all the teachers and students who participated in the exhibition and the reading club. It is precisely because of everyone's dedication and support that this exhibition was able to be presented successfully.	## 她者的盛宴｜展览回顾\n\n从《素食者》到生态女性主义\n\n[IMAGE: 47]\n\n"她安静地吸了一口气，紧盯着路边'熊熊燃烧'的树木，它们就像无数头站立起的野兽，散发着绿光。她的眼神幽暗而执着，像是在等待着回答，不，更像是在表达抗议。"\n\n摘录来自《素食者》【韩】韩江\n\n[IMAGE: 51]\n\n"展览是一种语言，它像文学或电影一样拥有节奏、停顿和高潮。" —— Daniel Birnbaum\n\n## 前言\n\n2024 年诺贝尔文学奖授予韩国作家韩江，其代表作《素食者》以极具冲击力的笔触，描绘了一位女性在父权制社会压迫下，通过极端素食主义拒绝吃肉，到最终将自己彻底异化为一棵树的反抗故事。这部作品引发了全球范围内对生态女性主义的广泛讨论。韩江利用细腻的语言描绘了许多引人深思的意象，她的文字不禁激起读者对画面想象和创作的欲望。\n\n[IMAGE: 57]\n\n本次展览旨在通过北京中学学生、央美毕业生和艺术家的作品回应这种创作欲望，去讲述一个"他者"被社会边缘化后，自我觉醒、拒绝不公、最终主动反抗的故事。展览最后还反思了社会和他人的行为，促使观众思考那些导致社会中边缘化群体悲剧的缘由。\n\n从生态女性主义的视角出发，本次展览试图通过类比边缘化群体与生态环境所遭遇的压迫与剥削，引导观众更深刻地理解女性所面临的不公境遇，并激发对其处境的反思与共鸣。\n\n[IMAGE: 49]\n\n## 展览进行时\n\n2025 年 6 月 26 日，展览正式开幕，北中学子和老师们热情地参与了本次展览开幕式。现场还精心布置了颇受同学们喜爱的插花互动点位，策展人希望通过插花可以让大家更加深刻地感受女性与植物的潜在联系。\n\n[IMAGE: 48]\n\n开幕式环节，北京中学周慧副校长进行了致辞，表达了对此次展览的美好期待。\n\n本次展览分为三个单元：\n\n- **萌芽：含苞待放**\n- **生长：雨后春笋**\n- **回归：盘根错节**\n\n展品的艺术形式多样，包括绘画、装置以及影像。\n\n[IMAGE: 53]\n\n### 萌芽：含苞待放\n\n花苞中的花朵，被限制、被束缚，每一片脆弱的花瓣相互拥抱，彼此注视，不断进行自我的审视，积蓄冲出桎梏的强烈渴求。当认识到这一点，花苞得以自我觉醒，开始向外发散，拒绝了内在封闭的环境，开始了反抗的第一步。\n\n[IMAGE: 55]\n\n### 生长：雨后春笋\n\n雨水或是一场充满戏剧性的洗礼，或是上天的提醒。雨后，春笋突破土壤，重新见到崭新的世界。然而面对他们的或许是被人类残忍地割去，或者是成长为一群枝叶相连血脉相生的自然生态。突破土壤，逃离阴暗的地下，重建光明——反抗后他们到底会赢得胜利、继续沉默，还是迎来更残忍的悲剧？\n\n[IMAGE: 56]\n\n### 回归：盘根错节\n\n当自我、植物个体终于赢得胜利或是迎来悲剧时，对背后原因的探讨便自发展开。回归到植物复杂的根系——根系间的缠绕是否在不经意间牵连了彼此，还是在互相帮助？在看不到的地方到底发生了什么？我们是否可以解释清楚？\n\n## 读书会\n\n[IMAGE: 52]\n\n展览英文名"Synesthesia 联觉"的缘由是希望可以通过书中的文字与展览的视觉语言的融合，让思想深刻地潜入同一个话题的探讨，对现象的理解碰撞出思想的"盛宴"。\n\n因此，展览结束后，策展人举办了以《素食者》为核心的读书会，进一步探讨女性主义议题。读书会共分为三部分：\n\n1. 嘉宾分享\n2. 自由讨论\n3. 拼贴创作\n\n[IMAGE: 44]\n\n在嘉宾分享环节，大家将《素食者》中主人公的经历与《哈尔的移动城堡》进行对照，探讨了两位主人公在寻找自我过程中的共性与差异，随后讨论了二元对立、疯狂边界等主题。\n\n在自由讨论环节，大家围绕《素食者》中的人物形象与特定意象展开讨论，同时也探讨了与性少数群体相关的社会现象等内容。\n\n[IMAGE: 50]\n\n## 感想\n\n### 策展人王依依\n\n[IMAGE: 45]\n\n本次"她者的盛宴"展览于我来说，是一次申请季结束后没什么功利性的活动，一次相比于以前都更成熟的合作、以及一次对女性主义更深的探索。整个办展的过程中我和张若宸不断细化和扩展最开始粗糙的想法，读了很多相关的书和文献，并且在胡洁老师和任秋明老师的建议下不断优化效果，最终来到了完整的展览。非常感谢张若宸同学给我一次这样摆脱了申请季压力的策展体验。\n\n### 策展人张若宸\n\n[IMAGE: 46]\n\n这是我第一次尝试用"叙事"来策展，不再只是单纯围绕一个主题，而是让展览像一条故事线一样展开。这样的尝试让我对展览语言有了新的理解与探索。从最初的《素食者》，到生态女性主义的思考，再到"萌芽—生长—回归"的比喻，每一步都是一次次头脑风暴的结晶。希望这些探索不仅是对主题的深化，也能让艺术作品在展览中一步步走近观众，产生更多交流与共鸣。\n\n我非常幸运能与王依依学姐合作，从她那里学到了许多关于策划、设计与布展的宝贵经验。布展的过程虽伴随着挫折与不确定性，但在老师们的持续支持和鼓励下，展览最终成功举办，也让整个过程非常充实并且富有成就感。\n\n### 参展艺术家吕婧文\n\n[IMAGE: 42]\n\n我以创作者身份参与"她者的盛宴"女性主义主题画展，展出了三幅系列作品。这组作品通过一个女孩的成长叙事，呈现了性别符号化所带来的双重凝视（既来自外界的目光投射，也源于内在的自我审视），由此探讨当代女性在社会规训下形成的自我客体化现象。本次展览构建了一个极具艺术张力的对话场景，其他参展艺术家充满震撼力的创作，更为这场关于女性主义的美学探讨增添非凡的魅力色彩。\n\n[IMAGE: 43]\n\n[IMAGE: 54]\n\n## 写在最后的话\n\n本次展览的顺利举办，离不开老师和同学们的关心与支持。在此特别鸣谢周慧校长的大力支持，胡捷老师、任秋明老师、林雪娇老师对策划和落地的辅导，王鹏宇老师在主题深化上的帮助，以及央美同学们的积极参与。同时感谢鞠队的协助，以及所有参与展览与读书会的老师和同学们。正因有大家的付出与支持，才使本次展览得以圆满呈现。	## A Feast for the Other｜Exhibition Review\n\nFrom 'The Vegetarian' to Ecofeminism\n\n[IMAGE: 47]\n\n"She quietly took a breath and stared intently at the trees 'burning fiercely' by the roadside; they stood like countless beasts, emanating a green light. Her gaze was dark and resolute, as if waiting for an answer, or rather, more like expressing a protest."\n\nExcerpt from "The Vegetarian" by Han Kang\n\n[IMAGE: 51]\n\n"An exhibition is a language; like literature or film, it has rhythm, pauses, and climaxes." — Daniel Birnbaum\n\n## Preface\n\nThe 2024 Nobel Prize in Literature was awarded to South Korean author Han Kang. Her representative work, "The Vegetarian," depicts with striking intensity the story of a woman oppressed by a patriarchal society. Through extreme vegetarianism, she refuses to eat meat, ultimately transforming herself into a tree as an act of rebellion. This work has sparked widespread discussion on ecofeminism globally. Han Kang uses delicate language to portray many thought-provoking images, her words inevitably stirring in readers a desire for visual imagination and creation.\n\n[IMAGE: 57]\n\nThis exhibition aims to respond to this creative impulse through works by Beijing Academy students, CAFA graduates, and artists, telling the story of an "Other" who, after being marginalized by society, undergoes self-awakening, rejects injustice, and ultimately takes active resistance. The exhibition concludes by reflecting on societal and individual actions, prompting viewers to contemplate the causes behind the tragedies faced by marginalized groups in society.\n\nFrom the perspective of ecofeminism, this exhibition attempts, by drawing analogies between the oppression and exploitation faced by marginalized groups and the ecological environment, to guide the audience towards a deeper understanding of the injustices women face and to inspire reflection and empathy for their plight.\n\n[IMAGE: 49]\n\n## The Exhibition in Progress\n\nOn June 26, 2025, the exhibition officially opened, with Beijing Academy students and teachers enthusiastically participating in the opening ceremony. An interactive flower arrangement station, popular among students, was thoughtfully set up on site. The curators hoped that through flower arranging, everyone could more profoundly feel the potential connection between women and plants.\n\n[IMAGE: 48]\n\nDuring the opening ceremony, Vice Principal Zhou Hui of Beijing Academy delivered a speech, expressing positive expectations for the exhibition.\n\nThis exhibition is divided into three units:\n\n- **Germination: In Bud**\n- **Growth: Springing Up**\n- **Return: Intertwined Roots**\n\nThe artworks on display encompass a variety of forms, including painting, installation, and video.\n\n[IMAGE: 53]\n\n### Germination: In Bud\n\nThe flower within the bud is restricted, bound. Each fragile petal embraces the others, gazing inward, constantly engaging in self-examination, accumulating a strong desire to break free from confinement. Upon realizing this, the bud achieves self-awakening, begins to reach outward, rejects the inwardly closed environment, and takes the first step of resistance.\n\n[IMAGE: 55]\n\n### Growth: Springing Up\n\nRain can be a dramatic baptism or a reminder from heaven. After the rain, bamboo shoots break through the soil, encountering a崭新的 world anew. However, what awaits them might be being cruelly cut down by humans, or growing into a natural ecosystem where branches, leaves, and lifeblood are interconnected. Breaking through the soil, escaping the dark underground, rebuilding in the light—after resistance, will they achieve victory, continue in silence, or face an even crueler tragedy?\n\n[IMAGE: 56]\n\n### Return: Intertwined Roots\n\nWhen the self, the plant individual, finally achieves victory or meets tragedy, the exploration of the underlying reasons naturally unfolds. Returning to the plant's complex root system—does the entanglement of roots inadvertently implicate each other, or do they help one another? What truly happens out of sight? Can we clearly explain it?\n\n## Reading Club\n\n[IMAGE: 52]\n\nThe reason for the exhibition's English title, "Synesthesia," is the hope that through the fusion of the text from the book and the visual language of the exhibition, thoughts can deeply潜入 the discussion of the same topic, creating a "feast" of ideas through the碰撞 of understanding phenomena.\n\nTherefore, following the exhibition, the curators held a reading club centered on "The Vegetarian" to further explore feminist issues. The reading club was divided into three parts:\n\n1. Guest Sharing\n2. Free Discussion\n3. Collage Creation\n\n[IMAGE: 44]\n\nDuring the guest sharing session, participants compared the experiences of the protagonist in "The Vegetarian" with those in "Howl's Moving Castle," exploring the similarities and differences in the two protagonists' journeys of self-discovery. This was followed by discussions on themes such as binary oppositions and the boundaries of madness.\n\nIn the free discussion segment, the conversation revolved around the character portrayals and specific imagery in "The Vegetarian," and also touched upon social phenomena related to sexual minority groups.\n\n[IMAGE: 50]\n\n## Reflections\n\n### Curator Wang Yiyi\n\n[IMAGE: 45]\n\nFor me, the "A Feast for the Other" exhibition was an activity free from功利性 pressures after the college application season, a more mature collaboration compared to previous ones, and a deeper exploration of feminism. Throughout the process of organizing the exhibition, Zhang Ruochen and I continuously refined and expanded our initial rough ideas, read many related books and literature, and constantly optimized the outcome based on suggestions from Teacher Hu Jie and Teacher Ren Qiuming, ultimately arriving at a complete exhibition. I am very grateful to my fellow student Zhang Ruochen for providing me with such a curatorial experience, free from the pressures of the application season.\n\n### Curator Zhang Ruochen\n\n[IMAGE: 46]\n\nThis was my first attempt at curating using "narrative," no longer simply围绕 a theme, but letting the exhibition unfold like a storyline. This attempt gave me a new understanding and exploration of exhibition language. From the initial inspiration of "The Vegetarian," to reflections on ecofeminism, and then to the metaphor of "Germination—Growth—Return," each step was the crystallization of numerous brainstorming sessions. I hope these explorations not only deepened the theme but also allowed the artworks to gradually走近 the audience within the exhibition, generating more exchange and resonance.\n\nI was very fortunate to collaborate with Senior Wang Yiyi, from whom I learned valuable lessons about planning, design, and installation. The installation process, though accompanied by setbacks and uncertainties, was ultimately successful thanks to the continuous support and encouragement from the teachers, making the entire process very fulfilling and rewarding.\n\n### Participating Artist Lyu Jingwen\n\n[IMAGE: 42]\n\nI participated in the feminist-themed exhibition "A Feast for the Other" as a creator, exhibiting three pieces from a series. This group of works, through the成长 narrative of a girl, presents the双重凝视 (both the gaze projected from the outside world and the introspection stemming from within) brought about by the symbolization of gender, thereby exploring the phenomenon of self-objectification formed by contemporary women under social discipline. This exhibition constructed an extremely artistically charged dialogue scene. The震撼力-filled creations of other participating artists added extraordinary charm and depth to this aesthetic discussion on feminism.\n\n[IMAGE: 43]\n\n[IMAGE: 54]\n\n## Concluding Words\n\nThe successful holding of this exhibition离不开 the care and support of teachers and students. We would like to specially thank Principal Zhou Hui for her strong support; Teachers Hu Jie, Ren Qiuming, and Lin Xuejiao for their guidance in planning and implementation; Teacher Wang Pengyu for his assistance in thematic deepening; and the CAFA students for their active participation. We also extend our gratitude to Ju Dui for their assistance, and to all the teachers and students who participated in the exhibition and the reading club. It is precisely because of everyone's dedication and support that this exhibition was able to be presented successfully.	## 她者的盛宴｜展览回顾\n\n从《素食者》到生态女性主义\n\n[IMAGE: 47]\n\n"她安静地吸了一口气，紧盯着路边'熊熊燃烧'的树木，它们就像无数头站立起的野兽，散发着绿光。她的眼神幽暗而执着，像是在等待着回答，不，更像是在表达抗议。"\n\n摘录来自《素食者》【韩】韩江\n\n[IMAGE: 51]\n\n"展览是一种语言，它像文学或电影一样拥有节奏、停顿和高潮。" —— Daniel Birnbaum\n\n## 前言\n\n2024 年诺贝尔文学奖授予韩国作家韩江，其代表作《素食者》以极具冲击力的笔触，描绘了一位女性在父权制社会压迫下，通过极端素食主义拒绝吃肉，到最终将自己彻底异化为一棵树的反抗故事。这部作品引发了全球范围内对生态女性主义的广泛讨论。韩江利用细腻的语言描绘了许多引人深思的意象，她的文字不禁激起读者对画面想象和创作的欲望。\n\n[IMAGE: 57]\n\n本次展览旨在通过北京中学学生、央美毕业生和艺术家的作品回应这种创作欲望，去讲述一个"他者"被社会边缘化后，自我觉醒、拒绝不公、最终主动反抗的故事。展览最后还反思了社会和他人的行为，促使观众思考那些导致社会中边缘化群体悲剧的缘由。\n\n从生态女性主义的视角出发，本次展览试图通过类比边缘化群体与生态环境所遭遇的压迫与剥削，引导观众更深刻地理解女性所面临的不公境遇，并激发对其处境的反思与共鸣。\n\n[IMAGE: 49]\n\n## 展览进行时\n\n2025 年 6 月 26 日，展览正式开幕，北中学子和老师们热情地参与了本次展览开幕式。现场还精心布置了颇受同学们喜爱的插花互动点位，策展人希望通过插花可以让大家更加深刻地感受女性与植物的潜在联系。\n\n[IMAGE: 48]\n\n开幕式环节，北京中学周慧副校长进行了致辞，表达了对此次展览的美好期待。\n\n本次展览分为三个单元：\n\n- **萌芽：含苞待放**\n- **生长：雨后春笋**\n- **回归：盘根错节**\n\n展品的艺术形式多样，包括绘画、装置以及影像。\n\n[IMAGE: 53]\n\n### 萌芽：含苞待放\n\n花苞中的花朵，被限制、被束缚，每一片脆弱的花瓣相互拥抱，彼此注视，不断进行自我的审视，积蓄冲出桎梏的强烈渴求。当认识到这一点，花苞得以自我觉醒，开始向外发散，拒绝了内在封闭的环境，开始了反抗的第一步。\n\n[IMAGE: 55]\n\n### 生长：雨后春笋\n\n雨水或是一场充满戏剧性的洗礼，或是上天的提醒。雨后，春笋突破土壤，重新见到崭新的世界。然而面对他们的或许是被人类残忍地割去，或者是成长为一群枝叶相连血脉相生的自然生态。突破土壤，逃离阴暗的地下，重建光明——反抗后他们到底会赢得胜利、继续沉默，还是迎来更残忍的悲剧？\n\n[IMAGE: 56]\n\n### 回归：盘根错节\n\n当自我、植物个体终于赢得胜利或是迎来悲剧时，对背后原因的探讨便自发展开。回归到植物复杂的根系——根系间的缠绕是否在不经意间牵连了彼此，还是在互相帮助？在看不到的地方到底发生了什么？我们是否可以解释清楚？\n\n## 读书会\n\n[IMAGE: 52]\n\n展览英文名"Synesthesia 联觉"的缘由是希望可以通过书中的文字与展览的视觉语言的融合，让思想深刻地潜入同一个话题的探讨，对现象的理解碰撞出思想的"盛宴"。\n\n因此，展览结束后，策展人举办了以《素食者》为核心的读书会，进一步探讨女性主义议题。读书会共分为三部分：\n\n1. 嘉宾分享\n2. 自由讨论\n3. 拼贴创作\n\n[IMAGE: 44]\n\n在嘉宾分享环节，大家将《素食者》中主人公的经历与《哈尔的移动城堡》进行对照，探讨了两位主人公在寻找自我过程中的共性与差异，随后讨论了二元对立、疯狂边界等主题。\n\n在自由讨论环节，大家围绕《素食者》中的人物形象与特定意象展开讨论，同时也探讨了与性少数群体相关的社会现象等内容。\n\n[IMAGE: 50]\n\n## 感想\n\n### 策展人王依依\n\n[IMAGE: 45]\n\n本次"她者的盛宴"展览于我来说，是一次申请季结束后没什么功利性的活动，一次相比于以前都更成熟的合作、以及一次对女性主义更深的探索。整个办展的过程中我和张若宸不断细化和扩展最开始粗糙的想法，读了很多相关的书和文献，并且在胡洁老师和任秋明老师的建议下不断优化效果，最终来到了完整的展览。非常感谢张若宸同学给我一次这样摆脱了申请季压力的策展体验。\n\n### 策展人张若宸\n\n[IMAGE: 46]\n\n这是我第一次尝试用"叙事"来策展，不再只是单纯围绕一个主题，而是让展览像一条故事线一样展开。这样的尝试让我对展览语言有了新的理解与探索。从最初的《素食者》，到生态女性主义的思考，再到"萌芽—生长—回归"的比喻，每一步都是一次次头脑风暴的结晶。希望这些探索不仅是对主题的深化，也能让艺术作品在展览中一步步走近观众，产生更多交流与共鸣。\n\n我非常幸运能与王依依学姐合作，从她那里学到了许多关于策划、设计与布展的宝贵经验。布展的过程虽伴随着挫折与不确定性，但在老师们的持续支持和鼓励下，展览最终成功举办，也让整个过程非常充实并且富有成就感。\n\n### 参展艺术家吕婧文\n\n[IMAGE: 42]\n\n我以创作者身份参与"她者的盛宴"女性主义主题画展，展出了三幅系列作品。这组作品通过一个女孩的成长叙事，呈现了性别符号化所带来的双重凝视（既来自外界的目光投射，也源于内在的自我审视），由此探讨当代女性在社会规训下形成的自我客体化现象。本次展览构建了一个极具艺术张力的对话场景，其他参展艺术家充满震撼力的创作，更为这场关于女性主义的美学探讨增添非凡的魅力色彩。\n\n[IMAGE: 43]\n\n[IMAGE: 54]\n\n## 写在最后的话\n\n本次展览的顺利举办，离不开老师和同学们的关心与支持。在此特别鸣谢周慧校长的大力支持，胡捷老师、任秋明老师、林雪娇老师对策划和落地的辅导，王鹏宇老师在主题深化上的帮助，以及央美同学们的积极参与。同时感谢鞠队的协助，以及所有参与展览与读书会的老师和同学们。正因有大家的付出与支持，才使本次展览得以圆满呈现。	57	57	3406762	2025-08-29 00:00:00	2025-10-14 09:26:10.757	\N	\N	\N	\N	\N	\N
