36	page	Clubs	社团	Clubs	社团	life/clubs	{"root":{"props":{"title":"社团"},"type":"root"},"content":[{"type":"SpacerConfig","props":{"height":"5rem","id":"SpacerConfig-864680df-189c-4e8b-a17a-8695f39d7555"}},{"type":"HorizontalTopTextConfig","props":{"title":"Find your love","text":"With over 50 student-led clubs, the campus is filled opportunities—engaging, meaningful, waiting for you to explore.\\n","id":"HorizontalTopTextConfig-9acbb5bc-aaa9-48d7-8348-abf0fd9d51dc"}},{"type":"SpacerConfig","props":{"height":"5rem","id":"SpacerConfig-830f3fc4-f0cf-4349-b953-b423597407bf"}},{"type":"HeroConfig","props":{"title":"Clubs","backgroundColor":"#ffffff","lightText":false,"topPadding":false,"id":"HeroConfig-6cf8930f-1176-4f48-9295-e35dfbb5d63b","resolvedImage":{"id":65,"sha1":"29587e370b2cc9463b8858e7c81b0f51418f5759","name":"Student Projects","altText":"BAID students' ocean protection project","width":1920,"height":1039,"sizeKB":102,"uploaderId":3406762,"createdAt":"2025-12-22T13:31:36.244Z"},"resolvedUploadPrefix":"/uploads","image":"65"}},{"type":"SpacerConfig","props":{"height":"64px","id":"SpacerConfig-9fea8741-a102-4f4d-af6c-7860b3600772"}},{"type":"TopTextConfig","props":{"title":"There's something just for you","text":"With more than 300 students and nearly 50 clubs to choose from, it's so easy to find people who share your interests. From art to programming, our clubs cover a wide range of passions, with new ones forming each year to reflect what students care about most.","to":"","linkText":"","id":"TopTextConfig-c2bcc11d-234b-4bd5-a339-43a421f43dea"}},{"type":"StatisticsConfig","props":{"title":"Clubs by the numbers","content":[{"name":"student clubs from BAID students","value":"34"},{"name":"student clubs across campus","value":"50+"},{"name":"club periods every semester","value":"1000+"},{"name":"projects operated by clubs","value":"20+"}],"id":"StatisticsConfig-24415564-595f-44ba-b5db-5b4fe042296b"}},{"type":"ImageGalleryConfig","props":{"title":"Image Slideshow","