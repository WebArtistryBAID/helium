ncy","categoryEN":null,"categoryZH":null,"coverImagePublished":{"id":34,"sha1":"81ee4a676470619c4b74ed973a1c904b1bd9cef0","name":"微信导入","altText":"由微信文章导入","width":1080,"height":720,"sizeKB":74,"uploaderId":3406762,"createdAt":"2025-10-14T05:46:36.813Z"},"coverImageDraft":{"id":34,"sha1":"81ee4a676470619c4b74ed973a1c904b1bd9cef0","name":"微信导入","altText":"由微信文章导入","width":1080,"height":720,"sizeKB":74,"uploaderId":3406762,"createdAt":"2025-10-14T05:46:36.813Z"},"creator":{"id":3406762,"name":"蔺东来 Lin","pinyin":"Lin Donglai","roles":["admin","writer","editor"],"type":"student","gender":"male","createdAt":"2025-10-09T00:27:24.124Z","updatedAt":"2025-12-22T12:22:16.336Z"},"createdAt":"2025-09-30T00:00:00.000Z","updatedAt":"2025-10-14T05:58:10.629Z"},{"id":2,"type":"post","titlePublishedEN":"Beijing Academy Successfully Passes CIS Re-Accreditation","titlePublishedZH":"北京中学顺利通过CIS再认证","titleDraftEN":"Beijing Academy Successfully Passes CIS Re-Accreditation","titleDraftZH":"北京中学顺利通过CIS再认证","shortContentPublishedEN":null,"shortContentPublishedZH":null,"shortContentDraftEN":null,"shortContentDraftZH":null,"slug":"beijing-academy-successfully-passes-cis-re-accreditation","categoryEN":null,"categoryZH":null,"coverImagePublished":{"id":4,"sha1":"c2e98080659a77fec584fd446984b5915b100d0f","name":"微信导入","altText":"由微信文章导入","width":1080,"height":810,"sizeKB":60,"uploaderId":3406762,"createdAt":"2025-10-14T00:55:42.633Z"},"coverImageDraft":{"id":4,"sha1":"c2e98080659a77fec584fd446984b5915b100d0f","name":"微信导入","altText":"由微信文章导入","width":1080,"height":810,"sizeKB":60,"uploaderId":3406762,"createdAt":"2025-10-14T00:55:42.633Z"},"creator":{"id":3406762,"name":"蔺东来 Lin","pinyin":"Lin Donglai","roles":["admin","writer","editor"],"type":"student","gender":"male","createdAt":"2025-10-09T00:27:24.124Z","updatedAt":"2025-12-22T12:22:16.336Z"},"createdAt":"2025-09-29T00:00:00.000Z","updatedAt":"2026-03-31T00:32:41.057Z"},{"id":21,"type":"post","titlePublishedEN":"#BAIDer | Exhibition Review: A Feast for the Other – From 'The Vegetarian' to Ecofeminism","titlePublishedZH":"BAIDer | 展览回顾——她者的盛宴：从《素食者》到生态女性主义","titleDraftEN":"#BAIDer | Exhibition Review: A Feast for the Other – From 'The Vegetarian' to Ecofeminism","titleDraftZH":"BAIDer | 展览回顾——她者的盛宴：从《素食者》到生态女性主义","shortContentPublishedEN":null,"shortContentPublishedZH":null,"shortContentDraftEN":null,"shortContentDraftZH":null,"slug":"baider-exhibition-review-a-feast-for-the-other-from-the-vegetarian-to-ecofeminism","categoryEN":null,"categoryZH":null,"coverImagePublished":{"id":57,"sha1":"703fad80fa70a720ce00cf5a6ea5483f4203ea41","name":"微信导入","altText":"由微信文章导入","width":886,"height":886,"sizeKB":73,"uploaderId":3406762,"createdAt":"2025-10-14T09:25:35.537Z"},"coverImageDraft":{"id":57,"sha1":"703fad80fa70a720ce00cf5a6ea5483f4203ea41","name":"微信导入","altText":"由微信文章导入","width":886,"height":886,"sizeKB":73,"uploaderId":3406762,"createdAt":"2025-10-14T09:25:35.537Z"},"creator":{"id":3406762,"name":"蔺东来 Lin","pinyin":"Lin Donglai","roles":["admin","writer","editor"],"type":"student","gender":"male","createdAt":"2025-10-09T00:27:24.124Z","updatedAt":"2025-12-22T12:22:16.336Z"},"createdAt":"2025-08-29T00:00:00.000Z","updatedAt":"2025-10-14T09:26:10.757Z"}],"page":0,"pages":1},"resolvedUploadPrefix":"/uploads"}}],"zones":{}}	\N	\N	3406762	2026-03-23 05:34:45.359	2026-04-05 03:55:21.746	\N	\N	\N	\N	\N	\N
32	page	High School Program	高中项目	High School Program	高中项目	academics/high-school	{"root":{"props":{"title":"High School Program"},"type":"root"},"content":[{"type":"SpacerConfig","props":{"height":"5rem","id":"SpacerConfig-e12f4c1c-c3af-4015-a3c0-b91ec606c0fd"}},{"type":"HorizontalTopTextConfig","props":{"title":"Globally minded. Ambitious. Ready for more.","text":"Rooted in strong academic training, BAID's high school program fosters critical thinking, research ability, and global citizenship, empowering students to keep growing through challenge and step into a bigger future.","id":"HorizontalTopTextConfig-a7d971e6-5985-4d50-8356-4eb0fa0de6ac"}},{"type":"SpacerConfig","props":{"height":"5rem","id":"SpacerConfig-c0002f93-1056-403a-8d25-b1489b48f419"}},{"type":"HeroConfig","props":{"title":"High School","backgroundColor":"#ffffff","lightText":false,"topPadding":false,"id":"HeroConfig-e1962621-e25d-4462-94b0-fa5e17648a35","resolvedImage":{"id":58,"sha1":"bf11bcc1a751cd8727e990649683c7963fffb0ca","name":"Academics Hero","altText":"People studying around a table","width":3000,"height":2000,"sizeKB":172,"uploaderId":3406762,"createdAt":"2025-12-22T12:44:30.095Z"},"resolvedUploadPrefix":"/uploads","image":"58"}},{"type":"SpacerConfig","props":{"height":"64px","id":"SpacerConfig-22471c1a-fba3-4ce6-beb7-917e45407b27"}},{"type":"TopTextConfig","props":{"title":"Become who you want to be","text":"At BAID, learning and growth mark the beginning of something bigger. By bringing together China's national curriculum and the Advanced Placement (AP) program, BAID offers a richer way to learn. Students aim high, think deeply, and look ahead. They discover their strengths, engage with the world around them, and grow in a dynamic, diverse community full of possibility.\\n","to":"","linkText":"","id":"TopTextConfig-3e213486-6cd3-489d-9428-e06ce7e5aa8d"}},{"type":"StatisticsConfig","props":{"title":"An Environment with Both Challenge and Opportunity","content":[{"name":"teacher-student ratio","value":"1:7"},{"name":"postgraduate faculty","value":"93%"},{"name":"average homeroom size","value":"~20"},{"name":"Advanced Placement (AP) courses","value":"22"},{"name":"academic courses","value":"72"},{"name":"freshmen join AP courses","value":"100%"}],"id":"StatisticsConfig-4668b201-5035-4e22-b10a-5f8f409f30ab"}},{"type":"CoursesConfig","props":{"title":"Courses Overview","id":"CoursesConfig-dbbfd94c-6efe-4285-a952-ff3709eed36c","resolvedCourses":{"National Curriculum":[{"id":23,"type":"course","titlePublishedEN":"Chinese Literature","titlePublishedZH":"语文","titleDraftEN":"Chinese Literature","titleDraftZH":"语文","shortContentPublishedEN":null,"shortContentPublishedZH":null,"shortContentDraftEN":null,"shortContentDraftZH":null,"slug":"chinese-literature","categoryEN":"National Curriculum","categoryZH":"国家课程","coverImagePublished":null,"coverImageDraft":null,"creator":{"id":3406762,"name":"蔺东来 Lin","pinyin":"Lin Donglai","roles":["admin","writer","editor"],"type":"student","gender":"male","createdAt":"2025-10-09T00:27:24.124Z","updatedAt":"2025-12-22T12:22:16.336Z"},"createdAt":"2025-12-22T13:02:04.088Z","updatedAt":"2025-12-22T13:02:20.092Z"}],"AP":[{"id":24,"type":"course","titlePublishedEN":"AP Biology","titlePublishedZH":"AP 生物","titleDraftEN":"AP Biology","titleDraftZH":"AP 生物","shortContentPublishedEN":null,"shortContentPublishedZH":null,"shortContentDraftEN":null,"shortContentDraftZH":null,"slug":"ap-biology","categoryEN":"AP","categoryZH":"AP","coverImagePublished":null,"coverImageDraft":null,"creator":{"id":3406762,"name":"蔺东来 Lin","pinyin":"Lin Donglai","roles":["admin","writer","editor"],"type":"student","gender":"male","createdAt":"2025-10-09T00:27:24.124Z","updatedAt":"2025-12-22T12:22:16.336Z"},"createdAt":"2025-12-22T13:02:27.629Z","updatedAt":"2025-12-22T13:02:46.782Z"}]}}},{"type":"ImageTextLayoutConfig","props":{"lightText":false,"inverseOrder":false,"id":"ImageTextLayoutConfig-7ba73f58-3bba-4cb3-a4a5-4d28973570e7","resolvedImage":{"id":66,"sha1":"7a822d9377fc189c33d4b60980ca3cf841c646b8","name":"Admssons","altText":"ppl plang basketball","width":4000,"height":2667,"sizeKB":321,"uploaderId":3406762,"createdAt":"2025-12-22T13:52:58.599Z"},"resolvedUploadPrefix":"/uploads","image":"66","topText":"Core Curriculum","title":"Personalized Academic Growth, Powered by AP","text":"BAID brings together China's national curriculum and the Advanced Placement (AP) program, giving students academic choice with both range and depth. With 22 AP courses across mathematics, English, the sciences, and the humanities, students can pursue their interests with clarity and challenge. Beginning in Grade 9, they can step into AP coursework early and build both academic strength and independent learning over time. Year after year, BAID students earn AP scores of 5 at rates well above both the global and China averages."}},{"type":"ImageTextLayoutConfig","props":{"lightText":true,"inverseOrder":true,"id":"ImageTextLayoutConfig-e012be5f-fd9f-4c91-a9e5-7bdd3283eb46","resolvedImage":{"id":65,"sha1":"29587e370b2cc9463b8858e7c81b0f51418f5759","name":"Student Projects","altText":"BAID students' ocean protection project","width":1920,"height":1039,"sizeKB":102,"uploaderId":3406762,"createdAt":"2025-12-22T13:31:36.244Z"},"resolvedUploadPrefix":"/uploads","image":"65","backgroundColor":"#9f0612","title":"Bilingual Learning, Global Fluency","topText":"Bilingual Classroom","text":"At BAID, bilingual learning is part of everyday classroom and campus life. Our students and teachers come from 7 countries and regions, bringing diverse perspectives into every class. Moving naturally between Chinese and English, students learn to express ideas clearly, work across cultures, and develop the confidence and openness to thrive in a global setting."}},{"type":"ImageTextLayoutConfig","props":{"lightText":true,"inverseOrder":false,"id":"ImageTextLayoutConfig-4a1f908c-4cc8-426c-8d74-40dfa34f86b6","resolvedImage":{"id":66,"sha1":"7a822d9377fc189c33d4b60980ca3cf841c646b8","name":"Admssons","altText":"ppl plang basketball","width":4000,"height":2667,"sizeKB":321,"uploaderId":3406762,"createdAt":"2025-12-22T13:52:58.599Z"},"resolvedUploadPrefix":"/uploads","backgroundColor":"#4f5b74","image":"66","topText":"Leadership","title":"Leadership, Built Through Action","text":"BAID believes leadership grows through real responsibility. Every student has opportunities to step forward, contribute, and lead. Whether in the Student Council, the classroom, clubs, electives, or projects, students take on meaningful roles and learn by doing. Through each experience, they build judgment, collaboration, and grow into people ready to listen, decide, and take responsibility."}},{"type":"ImageTextLayoutConfig","props":{"lightText":true,"inverseOrder":true,"id":"ImageTextLayoutConfig-2e73849b-68ac-41a8-9289-c2721effaa40","resolvedImage":{"id":45,"sha1":"77f4b800de9217193844ea2f3bbe6b7e33a886b4","name":"微信导入","altText":"由微信文章导入","width":832,"height":554,"sizeKB":38,"uploaderId":3406762,"createdAt":"2025-10-14T09:25:34.464Z"},"resolvedUploadPrefix":"/uploads","backgroundColor":"#103c74","image":"45","title":"The World in My Heart","topText":"Project-Based Learning","text":"At BAID, knowledge is meant to be used. Students are constantly invited to apply what they learn to real questions, real problems, and real outcomes. The Major Foundation Program, dedicated courses on research, and partnerships with top universities open an even wider world of academic practice.","link":"/academics/pbl","linkText":"Discover project-based learning opportunities at BAID"}},{"type":"ImageTextLayoutConfig","props":{"lightText":false,"inverseOrder":false,"id":"ImageTextLayoutConfig-22254b5d-775b-45f2-865f-b10aa41cc153","resolvedImage":{"id":63,"sha1":"eca52c9f86f2410f111503f970426e6a0c2bd94b","name":"Bejng Culture Exploration Program","altText":"Test","width":1280,"height":853,"sizeKB":85,"uploaderId":3406762,"createdAt":"2025-12-22T12:50:56.539Z"},"resolvedUploadPrefix":"/uploads","image":"63","title":"Chinese Foundations, Global Dialogue","topText":"From China to the World","text":"At BAID, we are first and foremost a Chinese school. Through programs such as the Beijing Cultural Exploration Program and the Chinese Cultural Roots Journey, students strengthen their cultural identity as Chinese peoples. At the same time, BAID continues to expand the classroom beyond borders, with opportunities for students to study and connect with schools overseas, broaden their perspective, and engage the world with greater understanding.","link":"/academics/pbl","linkText":"Discover global opportunities at BAID"}},{"type":"ImageTextLayoutConfig","props":{"lightText":true,"inverseOrder":true,"id":"ImageTextLayoutConfig-f5a7be9b-ee17-4643-8fcb-0fa647c7fe6c","resolvedImage":{"id":62,"sha1":"073e82273837daeeaeec0f2e8a4603b962cbb875","name":"BA World School","altText":"Test","width":1280,"height":960,"sizeKB":316,"uploaderId":3406762,"createdAt":"2025-12-22T12:50:43.209Z"},"resolvedUploadPrefix":"/uploads","backgroundColor":"#9f0612","image":"62","topText":"Beyond the Classroom","title":"More to Try, More to Love","text":"Through a rich mix of courses, activities, and platforms, students are encouraged to explore widely and grow with purpose. More than 40 electives and over 50 student-led clubs span music, visual arts, performing arts, science, the humanities, and athletics. Programs and activities such as Into Nature, BAID Stage, and BAID Speaker give students infinite possibilities to design, express, and discover.","link":"/life","linkText":"Learn about life beyond the classroom at BAID"}},{"type":"ImageTextLayoutConfig","props":{"lightText":true,"inverseOrder":false,"id":"ImageTextLayoutConfig-ff128149-cfd9-4dfa-baec-e4f20b12d9b7","resolvedImage":{"id":59,"sha1":"dfdbae4816a16dd1a41563aac9cf52ecfdf204ee","name":"BA Lectures","altText":"olympics gold medalist Yang Yang at an event","width":1080,"height":720,"sizeKB":68,"uploaderId":3406762,"createdAt":"2025-12-22T12:49:50.419Z"},"resolvedUploadPrefix":"/uploads","image":"59","title":"Better Me, Better World","text":"At BAID, service is a meaningful way students live out their role as active global citizens. BAID students support left-behind children in urban villages, design navigation software for people with visual impairments, organize charity concerts, and bring greater attention to issues such as global hunger. Through real actions, our belief of \\"Better Me, Better World\\" becomes our way of living.","backgroundColor":"#4f5b74","topText":"Global Citizenship","link":"/projects","linkText":"Visit our student projects gallery"}},{"type":"ImageTextLayoutConfig","props":{"lightText":true,"inverseOrder":true,"id":"ImageTextLayoutConfig-136ef1aa-8594-4144-9d55-6dfd09db92c2","resolvedImage":{"id":6,"sha1":"9942a41c5b79b01ed07566182c6e54e34b3079b7","name":"Test","altText":"Test","width":6016,"height":3384,"sizeKB":1204,"uploaderId":3406762,"createdAt":"2025-10-14T03:02:23.332Z"},"resolvedUploadPrefix":"/uploads","backgroundColor":"#103c74","topText":"College Counseling","title":"Dream Far, Start Here","text":"BAID students have earned offers from world-renowned universities including Harvard, Stanford, Oxford, Cambridge, the University of Hong Kong, the University of Tokyo, and the University of Toronto. Guided by a healthy, rational approach to college counseling, students receive sustained support from the moment they arrive at BAID. Weekly seminars, one-on-one guidance, and events all help students and families move toward the universities that fit them best.","image":"6","link":"/academics/college-counseling","linkText":"Learn about our approach to college counseling"}},{"type":"SpacerConfig","props":{"height":"5rem","id":"SpacerConfig-10c317bb-02ff-4944-ad52-666181baf7b2"}},{"type":"ButtonConfig","props":{"text":"Learn more about BAID's high school admissions","link":"/admissions/baid","blank":false,"color":"blue","size":"md","align":"center","id":"ButtonConfig-e57f985c-c81b-4a32-a373-eee17495ef9e"}},{"type":"SpacerConfig","props":{"height":"5rem","id":"SpacerConfig-ed794a30-1fdf-40e3-8a8c-69ec49936f76"}}],"zones":{}}	{"root":{"props":{"title":"高中项目"},"type":"root"},"content":[{"type":"SpacerConfig","props":{"height":"5rem","id":"SpacerConfig-e12f4c1c-c3af-4015-a3c0-b91ec606c0fd"}},{"type":"HorizontalTopTextConfig","props":{"title":"胸怀天下、追求卓越的时代青年","text":"高中课程体系以扎实的学术训练为核心，兼顾思辨能力、研究素养与国际视野，支持学生在挑战中不断拓展潜能，迈向更广阔的未来。","id":"HorizontalTopTextConfig-a7d971e6-5985-4d50-8356-4eb0fa0de6ac"}},{"type":"SpacerConfig","props":{"height":"5rem","id":"SpacerConfig-c0002f93-1056-403a-8d25-b1489b48f419"}},{"type":"HeroConfig","props":{"title":"High School","backgroundColor":"#ffffff","lightText":false,"topPadding":false,"id":"HeroConfig-e1962621-e25d-4462-94b0-fa5e17648a35","resolvedImage":{"id":58,"sha1":"bf11bcc1a751cd8727e990649683c7963fffb0ca","name":"Academics Hero","altText":"People studying around a table","width":3000,"height":2000,"sizeKB":172,"uploaderId":3406762,"createdAt":"2025-12-22T12:44:30.095Z"},"resolvedUploadPrefix":"/uploads","image":"58"}},{"type":"SpacerConfig","props":{"height":"64px","id":"SpacerConfig-22471c1a-fba3-4ce6-beb7-917e45407b27"}},{"type":"TopTextConfig","props":{"title":"成为理想中的自己","text":"在 BAID 的学习与成长经历，将成为学生人生中的重要新起点。我们结合了中国国家课程与美国大学先修 (AP) 课程，创造了一种更开阔、更充实的学习生活方式。这里的学生追求优异的学术表现，也怀抱长远目标；他们积极探索自身潜能，关注真实世界，期待在充满活力的多元社区中不断成长，并为未来创造更多可能。","to":"","linkText":"","id":"TopTextConfig-3e213486-6cd3-489d-9428-e06ce7e5aa8d"}},{"type":"StatisticsConfig","props":{"title":"兼具挑战与特色的学习","content":[{"name":"师生比","value":"1:7"},{"name":"硕博教师比","value":"93%"},{"name":"平均班级人数","value":"~20"},{"name":"美国大学先修 (AP) 课程","value":"22"},{"name":"学术课程","value":"72"},{"name":"新生第一年即参加 AP 课程","value":"100%"}],"id":"StatisticsConfig-4668b201-5035-4e22-b10a-5f8f409f30ab"}},{"type":"CoursesConfig","props":{"title":"课程概览","id":"CoursesConfig-dbbfd94c-6efe-4285-a952-ff3709eed36c","resolvedCourses":{"National Curriculum":[{"id":23,"type":"course","titlePublishedEN":"Chinese Literature","titlePublishedZH":"语文","titleDraftEN":"Chinese Literature","titleDraftZH":"语文","shortContentPublishedEN":null,"shortContentPublishedZH":null,"shortContentDraftEN":null,"shortContentDraftZH":null,"slug":"chinese-literature","categoryEN":"National Curriculum","categoryZH":"国家课程","coverImagePublished":null,"coverImageDraft":null,"creator":{"id":3406762,"name":"蔺东来 Lin","pinyin":"Lin Donglai","roles":["admin","writer","editor"],"type":"student","gender":"male","createdAt":"2025-10-09T00:27:24.124Z","updatedAt":"2025-12-22T12:22:16.336Z"},"createdAt":"2025-12-22T13:02:04.088Z","updatedAt":"2025-12-22T13:02:20.092Z"}],"AP":[{"id":24,"type":"course","titlePublishedEN":"AP Biology","titlePublishedZH":"AP 生物","titleDraftEN":"AP Biology","titleDraftZH":"AP 生物","shortContentPublishedEN":null,"shortContentPublishedZH":null,"shortContentDraftEN":null,"shortContentDraftZH":null,"slug":"ap-biology","categoryEN":"AP","categoryZH":"AP","coverImagePublished":null,"coverImageDraft":null,"creator":{"id":3406762,"name":"蔺东来 Lin","pinyin":"Lin Donglai","roles":["admin","writer","editor"],"type":"student","gender":"male","createdAt":"2025-10-09T00:27:24.124Z","updatedAt":"2025-12-22T12:22:16.336Z"},"createdAt":"2025-12-22T13:02:27.629Z","updatedAt":"2025-12-22T13:02:46.782Z"}]}}},{"type":"ImageTextLayoutConfig","props":{"lightText":false,"inverseOrder":false,"id":"ImageTextLayoutConfig-7ba73f58-3bba-4cb3-a4a5-4d28973570e7","resolvedImage":{"id":66,"sha1":"7a822d9377fc189c33d4b60980ca3cf841c646b8","name":"Admssons","altText":"ppl plang basketball","width":4000,"height":2667,"sizeKB":321,"uploaderId":3406762,"createdAt":"2025-12-22T13:52:58.599Z"},"resolvedUploadPrefix":"/uploads","image":"66","topText":"核心课程","title":"以大学先修课程支撑个性化学术发展","text":"BAID 构建了融合中国国家课程与美国大学先修课程 (AP 课程) 的国际化课程体系，为学生提供兼具广度与深度的学术选择。22 门 AP 课程覆盖数学、英语、科学与人文等多个领域，支持学生结合兴趣与发展方向开展深入学习。从九年级起，学生即可修读 AP 课程，在持续挑战中提升学术能力与自主学习能力。多年来，学生在 AP 全球统考中的 5 分率显著高于全球与中国平均水平。"}},{"type":"ImageTextLayoutConfig","props":{"lightText":true,"inverseOrder":true,"id":"ImageTextLayoutConfig-e012be5f-fd9f-4c91-a9e5-7bdd3283eb46","resolvedImage":{"id":65,"sha1":"29587e370b2cc9463b8858e7c81b0f51418f5759","name":"Student Projects","altText":"BAID students' ocean protection project","width":1920,"height":1039,"sizeKB":102,"uploaderId":3406762,"createdAt":"2025-12-22T13:31:36.244Z"},"resolvedUploadPrefix":"/uploads","image":"65","backgroundColor":"#9f0612","title":"以双语课堂培养自如的跨文化表达","topText":"双语教学","text":"BAID 将双语学习融入日常课堂与校园生活，帮助学生在真实、多元的环境中提升语言能力与文化理解力。我们的学生与教师来自全球 7 个国家与地区，为课堂带来丰富的文化背景与交流视角。学生在中英文之间自然切换，在不同文化语境中清晰表达观点、开展合作，逐步形成开放包容的视野与从容自信的跨文化表达能力。\\n"}},{"type":"ImageTextLayoutConfig","props":{"lightText":true,"inverseOrder":false,"id":"ImageTextLayoutConfig-4a1f908c-4cc8-426c-8d74-40dfa34f86b6","resolvedImage":{"id":66,"sha1":"7a822d9377fc189c33d4b60980ca3cf841c646b8","name":"Admssons","altText":"ppl plang basketball","width":4000,"height":2667,"sizeKB":321,"uploaderId":3406762,"createdAt":"2025-12-22T13:52:58.599Z"},"resolvedUploadPrefix":"/uploads","backgroundColor":"#4f5b74","image":"66","topText":"领导力","title":"以实践参与锤炼卓越的领导素养","text":"我们坚信，每位学生都应在真实参与中培养责任意识、组织能力与合作精神。BAID 为每一位学生提供丰富的实践平台，学生可以在学委会、班级、社团、选修课以及各类项目答辩团队中承担正式角色，在服务集体与带领团队的过程中积累经验、增长能力。一次次实践历练，让学生逐步学会倾听、判断与担当。"}},{"type":"ImageTextLayoutConfig","props":{"lightText":true,"inverseOrder":true,"id":"ImageTextLayoutConfig-2e73849b-68ac-41a8-9289-c2721effaa40","resolvedImage":{"id":45,"sha1":"77f4b800de9217193844ea2f3bbe6b7e33a886b4","name":"微信导入","altText":"由微信文章导入","width":832,"height":554,"sizeKB":38,"uploaderId":3406762,"createdAt":"2025-10-14T09:25:34.464Z"},"resolvedUploadPrefix":"/uploads","backgroundColor":"#103c74","image":"45","title":"以跨学科项目连接知识与真实世界","topText":"项目式学习","text":"在 BAID，学生们有无限机会在真实问题中综合运用知识、开展探究、形成成果。在 Major Foundation Program (MFP) 跨学科项目中，每位学生都围绕联合国可持续发展目标完成自己的学术项目，并撰写 5000 字学术论文。AP Seminar、AP Research 等课程进一步强化学生的独立思考与研究能力。学校还与中国传媒大学、清华大学无障碍发展研究院合作开展长期项目，为学生提供更加广阔的学术实践平台。","link":"/academics/pbl","linkText":"了解 BAID 的项目式学习机会"}},{"type":"ImageTextLayoutConfig","props":{"lightText":false,"inverseOrder":false,"id":"ImageTextLayoutConfig-22254b5d-775b-45f2-865f-b10aa41cc153","resolvedImage":{"id":63,"sha1":"eca52c9f86f2410f111503f970426e6a0c2bd94b","name":"Bejng Culture Exploration Program","altText":"Test","width":1280,"height":853,"sizeKB":85,"uploaderId":3406762,"createdAt":"2025-12-22T12:50:56.539Z"},"resolvedUploadPrefix":"/uploads","image":"63","title":"以中华根基对话广阔的世界课堂","topText":"立足中华 放眼世界","text":"BAID 重视立足北京、植根中国的文化根基，也重视学生面向世界的跨文化理解。通过中华文化寻根之旅、北京文化探究项目，学生能够深入理解中华文化的深厚内涵，在真实体验与项目探究中增强文化认同。与此同时，学校积极拓展世界大课堂，组织学生赴海外学校学习交流，在跨文化互动中开阔视野，增进理解。","link":"/academics/pbl","linkText":"了解中西合璧的活动机会"}},{"type":"ImageTextLayoutConfig","props":{"lightText":true,"inverseOrder":true,"id":"ImageTextLayoutConfig-f5a7be9b-ee17-4643-8fcb-0fa647c7fe6c","resolvedImage":{"id":62,"sha1":"073e82273837daeeaeec0f2e8a4603b962cbb875","name":"BA World School","altText":"Test","width":1280,"height":960,"sizeKB":316,"uploaderId":3406762,"createdAt":"2025-12-22T12:50:43.209Z"},"resolvedUploadPrefix":"/uploads","backgroundColor":"#9f0612","image":"62","topText":"课外学习项目","title":"以多彩平台滋养真实的兴趣与热爱","text":"BAID 尊重每一位学生独特的兴趣与潜能，并通过丰富多元的课程与活动平台支持学生持续探索、自主成长。40 余门选修课、50 余个学生社团覆盖音乐、视觉艺术、表演艺术、科学、人文、运动等多个领域，为学生提供广阔的发展空间。3/28 走进自然、北中小舞台、北中小讲师等活动，让学生在自主设计、公开表达与实践体验中不断发现热爱、发展所长。","link":"/life","linkText":"了解 BAID 的课外学习项目"}},{"type":"ImageTextLayoutConfig","props":{"lightText":true,"inverseOrder":false,"id":"ImageTextLayoutConfig-ff128149-cfd9-4dfa-baec-e4f20b12d9b7","resolvedImage":{"id":59,"sha1":"dfdbae4816a16dd1a41563aac9cf52ecfdf204ee","name":"BA Lectures","altText":"olympics gold medalist Yang Yang at an event","width":1080,"height":720,"sizeKB":68,"uploaderId":3406762,"createdAt":"2025-12-22T12:49:50.419Z"},"resolvedUploadPrefix":"/uploads","image":"59","title":"以责任担当践行 \\"世界因我更美好\\" 的理念","text":"在 BAID，服务是学生承担公民义务的重要方式。我们的学生从真实问题出发，关注他人、关注社区、关注更广阔的公共议题。BAID 学生为城中村留守儿童开展关爱行动，为视障人士设计导航软件，举办慈善音乐会，推动更多人关注全球饥饿等议题。在一次次切实的参与中，\\"世界因我更美好\\" 逐渐成为学生的价值追求与自觉行动。","backgroundColor":"#4f5b74","topText":"公民、责任与担当","link":"/projects","linkText":"了解我们的学生项目"}},{"type":"ImageTextLayoutConfig","props":{"lightText":true,"inverseOrder":true,"id":"ImageTextLayoutConfig-136ef1aa-8594-4144-9d55-6dfd09db92c2","resolvedImage":{"id":6,"sha1":"9942a41c5b79b01ed07566182c6e54e34b3079b7","name":"Test","altText":"Test","width":6016,"height":3384,"sizeKB":1204,"uploaderId":3406762,"createdAt":"2025-10-14T03:02:23.332Z"},"resolvedUploadPrefix":"/uploads","backgroundColor":"#103c74","topText":"大学升学辅导","title":"在最适合自己的大学逐梦远方","text":"BAID 始终关注每一位学生的长远发展，陪伴他们走向更广阔的未来。近年来，学生已陆续收获哈佛、斯坦福、牛津、剑桥、香港大学、东京大学、多伦多大学等世界知名高校录取。学校坚持健康、理性的升学理念，专业升学指导教师从学生入学起便持续开展每周讲座，并与学生及家庭保持一对一沟通，提供细致、个性化的支持。与此同时，BAID 还经常邀请高校招生官到校交流，让学生在真实对话中加深对未来方向的理解。","image":"6","link":"/academics/college-counseling","linkText":"了解我们的大学升学指导"}},{"type":"SpacerConfig","props":{"height":"5rem","id":"SpacerConfig-10c317bb-02ff-4944-ad52-666181baf7b2"}},{"type":"ButtonConfig","props":{"text":"了解 BAID 的高中招生项目","link":"/admissions/baid","blank":false,"color":"blue","size":"md","align":"center","id":"ButtonConfig-e57f985c-c81b-4a32-a373-eee17495ef9e"}},{"type":"SpacerConfig","props":{"height":"5rem","id":"SpacerConfig-ed794a30-1fdf-40e3-8a8c-69ec49936f76"}}],"zones":{}}	{"root":{"props":{"title":"High School Program"},"type":"root"},"content":[{"type":"SpacerConfig","props":{"height":"5rem","id":"SpacerConfig-e12f4c1c-c3af-4015-a3c0-b91ec606c0fd"}},{"type":"HorizontalTopTextConfig","props":{"title":"Globally minded. Ambitious. Ready for more.","text":"Rooted in strong academic training, BAID's high school program fosters critical thinking, research ability, and global citizenship, empowering students to keep growing through challenge and step into a bigger future.","id":"HorizontalTopTextConfig-a7d971e6-5985-4d50-8356-4eb0fa0de6ac"}},{"type":"SpacerConfig","props":{"height":"5rem","id":"SpacerConfig-c0002f93-1056-403a-8d25-b1489b48f419"}},{"type":"HeroConfig","props":{"title":"High School","backgroundColor":"#ffffff","lightText":false,"topPadding":false,"id":"HeroConfig-e1962621-e25d-4462-94b0-fa5e17648a35","resolvedImage":{"id":58,"sha1":"bf11bcc1a751cd8727e990649683c7963fffb0ca","name":"Academics Hero","altText":"People studying around a table","width":3000,"height":2000,"sizeKB":172,"uploaderId":3406762,"createdAt":"2025-12-22T12:44:30.095Z"},"resolvedUploadPrefix":"/uploads","image":"58"}},{"type":"SpacerConfig","props":{"height":"64px","id":"SpacerConfig-22471c1a-fba3-4ce6-beb7-917e45407b27"}},{"type":"TopTextConfig","props":{"title":"Become who you want to be","text":"At BAID, learning and growth mark the beginning of something bigger. By bringing together China's national curriculum and the Advanced Placement (AP) program, BAID offers a richer way to learn. Students aim high, think deeply, and look ahead. They discover their strengths, engage with the world around them, and grow in a dynamic, diverse community full of possibility.\\n","to":"","linkText":"","id":"TopTextConfig-3e213486-6cd3-489d-9428-e06ce7e5aa8d"}},{"type":"StatisticsConfig","props":{"title":"An Environment with Both Challenge and Opportunity","content":[{"name":"teacher-student ratio","value":"1:7"},{"name":"postgraduate faculty","value":"93%"},{"name":"average homeroom size","value":"~20"},{"name":"Advanced Placement (AP) courses","value":"22"},{"name":"academic courses","value":"72"},{"name":"freshmen join AP courses","value":"100%"}],"id":"StatisticsConfig-4668b201-5035-4e22-b10a-5f8f409f30ab"}},{"type":"CoursesConfig","props":{"title":"Courses Overview","id":"CoursesConfig-dbbfd94c-6efe-4285-a952-ff3709eed36c","resolvedCourses":{"National Curriculum":[{"id":23,"type":"course","titlePublishedEN":"Chinese Literature","titlePublishedZH":"语文","titleDraftEN":"Chinese Literature","titleDraftZH":"语文","shortContentPublishedEN":null,"shortContentPublishedZH":null,"shortContentDraftEN":null,"shortContentDraftZH":null,"slug":"chinese-literature","categoryEN":"National Curriculum","categoryZH":"国家课程","coverImagePublished":null,"coverImageDraft":null,"creator":{"id":3406762,"name":"蔺东来 Lin","pinyin":"Lin Donglai","roles":["admin","writer","editor"],"type":"student","gender":"male","createdAt":"2025-10-09T00:27:24.124Z","updatedAt":"2025-12-22T12:22:16.336Z"},"createdAt":"2025-12-22T13:02:04.088Z","updatedAt":"2025-12-22T13:02:20.092Z"}],"AP":[{"id":24,"type":"course","titlePublishedEN":"AP Biology","titlePublishedZH":"AP 生物","titleDraftEN":"AP Biology","titleDraftZH":"AP 生物","shortContentPublishedEN":null,"shortContentPublishedZH":null,"shortContentDraftEN":null,"shortContentDraftZH":null,"slug":"ap-biology","categoryEN":"AP","categoryZH":"AP","coverImagePublished":null,"coverImageDraft":null,"creator":{"id":3406762,"name":"蔺东来 Lin","pinyin":"Lin Donglai","roles":["admin","writer","editor"],"type":"student","gender":"male","createdAt":"2025-10-09T00:27:24.124Z","updatedAt":"2025-12-22T12:22:16.336Z"},"createdAt":"2025-12-22T13:02:27.629Z","updatedAt":"2025-12-22T13:02:46.782Z"}]}}},{"type":"ImageTextLayoutConfig","props":{"lightText":false,"inverseOrder":false,"id":"ImageTextLayoutConfig-7ba73f58-3bba-4cb3-a4a5-4d28973570e7","resolvedImage":{"id":66,"sha1":"7a822d9377fc189c33d4b60980ca3cf841c646b8","name":"Admssons","altText":"ppl plang basketball","width":4000,"height":2667,"sizeKB":321,"uploaderId":3406762,"createdAt":"2025-12-22T13:52:58.599Z"},"resolvedUploadPrefix":"/uploads","image":"66","topText":"Core Curriculum","title":"Personalized Academic Growth, Powered by AP","text":"BAID brings together China's national curriculum and the Advanced Placement (AP) program, giving students academic choice with both range and depth. With 22 AP courses across mathematics, English, the sciences, and the humanities, students can pursue their interests with clarity and challenge. Beginning in Grade 9, they can step into AP coursework early and build both academic strength and independent learning over time. Year after year, BAID students earn AP scores of 5 at rates well above both the global and China averages."}},{"type":"ImageTextLayoutConfig","props":{"lightText":true,"inverseOrder":true,"id":"ImageTextLayoutConfig-e012be5f-fd9f-4c91-a9e5-7bdd3283eb46","resolvedImage":{"id":65,"sha1":"29587e370b2cc9463b8858e7c81b0f51418f5759","name":"Student Projects","altText":"BAID students' ocean protection project","width":1920,"height":1039,"sizeKB":102,"uploaderId":3406762,"createdAt":"2025-12-22T13:31:36.244Z"},"resolvedUploadPrefix":"/uploads","image":"65","backgroundColor":"#9f0612","title":"Bilingual Learning, Global Fluency","topText":"Bilingual Classroom","text":"At BAID, bilingual learning is part of everyday classroom and campus life. Our students and teachers come from 7 countries and regions, bringing diverse perspectives into every class. Moving naturally between Chinese and English, students learn to express ideas clearly, work across cultures, and develop the confidence and openness to thrive in a global setting."}},{"type":"ImageTextLayoutConfig","props":{"lightText":true,"inverseOrder":false,"id":"ImageTextLayoutConfig-4a1f908c-4cc8-426c-8d74-40dfa34f86b6","resolvedImage":{"id":66,"sha1":"7a822d9377fc189c33d4b60980ca3cf841c646b8","name":"Admssons","altText":"ppl plang basketball","width":4000,"height":2667,"sizeKB":321,"uploaderId":3406762,"createdAt":"2025-12-22T13:52:58.599Z"},"resolvedUploadPrefix":"/uploads","backgroundColor":"#4f5b74","image":"66","topText":"Leadership","title":"Leadership, Built Through Action","text":"BAID believes leadership grows through real responsibility. Every student has opportunities to step forward, contribute, and lead. Whether in the Student Council, the classroom, clubs, electives, or projects, students take on meaningful roles and learn by doing. Through each experience, they build judgment, collaboration, and grow into people ready to listen, decide, and take responsibility."}},{"type":"ImageTextLayoutConfig","props":{"lightText":true,"inverseOrder":true,"id":"ImageTextLayoutConfig-2e73849b-68ac-41a8-9289-c2721effaa40","resolvedImage":{"id":45,"sha1":"77f4b800de9217193844ea2f3bbe6b7e33a886b4","name":"微信导入","altText":"由微信文章导入","width":832,"height":554,"sizeKB":38,"uploaderId":3406762,"createdAt":"2025-10-14T09:25:34.464Z"},"resolvedUploadPrefix":"/uploads","backgroundColor":"#103c74","image":"45","title":"The World in My Heart","topText":"Project-Based Learning","text":"At BAID, knowledge is meant to be used. Students are constantly invited to apply what they learn to real questions, real problems, and real outcomes. The Major Foundation Program, dedicated courses on research, and partnerships with top universities open an even wider world of academic practice.","link":"/academics/pbl","linkText":"Discover project-based learning opportunities at BAID"}},{"type":"ImageTextLayoutConfig","props":{"lightText":false,"inverseOrder":false,"id":"ImageTextLayoutConfig-22254b5d-775b-45f2-865f-b10aa41cc153","resolvedImage":{"id":63,"sha1":"eca52c9f86f2410f111503f970426e6a0c2bd94b","name":"Bejng Culture Exploration Program","altText":"Test","width":1280,"height":853,"sizeKB":85,"uploaderId":3406762,"createdAt":"2025-12-22T12:50:56.539Z"},"resolvedUploadPrefix":"/uploads","image":"63","title":"Chinese Foundations, Global Dialogue","topText":"From China to the World","text":"At BAID, we are first and foremost a Chinese school. Through programs such as the Beijing Cultural Exploration Program and the Chinese Cultural Roots Journey, students strengthen their cultural identity as Chinese peoples. At the same time, BAID continues to expand the classroom beyond borders, with opportunities for students to study and connect with schools overseas, broaden their perspective, and engage the world with greater understanding.","link":"/academics/pbl","linkText":"Discover global opportunities at BAID"}},{"type":"ImageTextLayoutConfig","props":{"lightText":true,"inverseOrder":true,"id":"ImageTextLayoutConfig-f5a7be9b-ee17-4643-8fcb-0fa647c7fe6c","resolvedImage":{"id":62,"sha1":"073e82273837daeeaeec0f2e8a4603b962cbb875","name":"BA World School","altText":"Test","width":1280,"height":960,"sizeKB":316,"uploaderId":3406762,"createdAt":"2025-12-22T12:50:43.209Z"},"resolvedUploadPrefix":"/uploads","backgroundColor":"#9f0612","image":"62","topText":"Beyond the Classroom","title":"More to Try, More to Love","text":"Through a rich mix of courses, activities, and platforms, students are encouraged to explore widely and grow with purpose. More than 40 electives and over 50 student-led clubs span music, visual arts, performing arts, science, the humanities, and athletics. Programs and activities such as Into Nature, BAID Stage, and BAID Speaker give students infinite possibilities to design, express, and discover.","link":"/life","linkText":"Learn about life beyond the classroom at BAID"}},{"type":"ImageTextLayoutConfig","props":{"lightText":true,"inverseOrder":false,"id":"ImageTextLayoutConfig-ff128149-cfd9-4dfa-baec-e4f20b12d9b7","resolvedImage":{"id":59,"sha1":"dfdbae4816a16dd1a41563aac9cf52ecfdf204ee","name":"BA Lectures","altText":"olympics gold medalist Yang Yang at an event","width":1080,"height":720,"sizeKB":68,"uploaderId":3406762,"createdAt":"2025-12-22T12:49:50.419Z"},"resolvedUploadPrefix":"/uploads","image":"59","title":"Better Me, Better World","text":"At BAID, service is a meaningful way students live out their role as active global citizens. BAID students support left-behind children in urban villages, design navigation software for people with visual impairments, organize charity concerts, and bring greater attention to issues such as global hunger. Through real actions, our belief of \\"Better Me, Better World\\" becomes our way of living.","backgroundColor":"#4f5b74","topText":"Global Citizenship","link":"/projects","linkText":"Visit our student projects gallery"}},{"type":"ImageTextLayoutConfig","props":{"lightText":true,"inverseOrder":true,"id":"ImageTextLayoutConfig-136ef1aa-8594-4144-9d55-6dfd09db92c2","resolvedImage":{"id":6,"sha1":"9942a41c5b79b01ed07566182c6e54e34b3079b7","name":"Test","altText":"Test","width":6016,"height":3384,"sizeKB":1204,"uploaderId":3406762,"createdAt":"2025-10-14T03:02:23.332Z"},"resolvedUploadPrefix":"/uploads","backgroundColor":"#103c74","topText":"College Counseling","title":"Dream Far, Start Here","text":"BAID students have earned offers from world-renowned universities including Harvard, Stanford, Oxford, Cambridge, the University of Hong Kong, the University of Tokyo, and the University of Toronto. Guided by a healthy, rational approach to college counseling, students receive sustained support from the moment they arrive at BAID. Weekly seminars, one-on-one guidance, and events all help students and families move toward the universities that fit them best.","image":"6","link":"/academics/college-counseling","linkText":"Learn about our approach to college counseling"}},{"type":"SpacerConfig","props":{"height":"5rem","id":"SpacerConfig-10c317bb-02ff-4944-ad52-666181baf7b2"}},{"type":"ButtonConfig","props":{"text":"Learn more about BAID's high school admissions","link":"/admissions/baid","blank":false,"color":"blue","size":"md","align":"center","id":"ButtonConfig-e57f985c-c81b-4a32-a373-eee17495ef9e"}},{"type":"SpacerConfig","props":{"height":"5rem","id":"SpacerConfig-ed794a30-1fdf-40e3-8a8c-69ec49936f76"}}],"zones":{}}	{"root":{"props":{"title":"高中项目"},"type":"root"},"content":[{"type":"SpacerConfig","props":{"height":"5rem","id":"SpacerConfig-e12f4c1c-c3af-4015-a3c0-b91ec606c0fd"}},{"type":"HorizontalTopTextConfig","props":{"title":"胸怀天下、追求卓越的时代青年","text":"高中课程体系以扎实的学术训练为核心，兼顾思辨能力、研究素养与国际视野，支持学生在挑战中不断拓展潜能，迈向更广阔的未来。","id":"HorizontalTopTextConfig-a7d971e6-5985-4d50-8356-4eb0fa0de6ac"}},{"type":"SpacerConfig","props":{"height":"5rem","id":"SpacerConfig-c0002f93-1056-403a-8d25-b1489b48f419"}},{"type":"HeroConfig","props":{"title":"High School","backgroundColor":"#ffffff","lightText":false,"topPadding":false,"id":"HeroConfig-e1962621-e25d-4462-94b0-fa5e17648a35","resolvedImage":{"id":58,"sha1":"bf11bcc1a751cd8727e990649683c7963fffb0ca","name":"Academics Hero","altText":"People studying around a table","width":3000,"height":2000,"sizeKB":172,"uploaderId":3406762,"createdAt":"2025-12-22T12:44:30.095Z"},"resolvedUploadPrefix":"/uploads","image":"58"}},{"type":"SpacerConfig","props":{"height":"64px","id":"SpacerConfig-22471c1a-fba3-4ce6-beb7-917e45407b27"}},{"type":"TopTextConfig","props":{"title":"成为理想中的自己","text":"在 BAID 的学习与成长经历，将成为学生人生中的重要新起点。我们结合了中国国家课程与美国大学先修 (AP) 课程，创造了一种更开阔、更充实的学习生活方式。这里的学生追求优异的学术表现，也怀抱长远目标；他们积极探索自身潜能，关注真实世界，期待在充满活力的多元社区中不断成长，并为未来创造更多可能。","to":"","linkText":"","id":"TopTextConfig-3e213486-6cd3-489d-9428-e06ce7e5aa8d"}},{"type":"StatisticsConfig","props":{"title":"兼具挑战与特色的学习","content":[{"name":"师生比","value":"1:7"},{"name":"硕博教师比","value":"93%"},{"name":"平均班级人数","value":"~20"},{"name":"美国大学先修 (AP) 课程","value":"22"},{"name":"学术课程","value":"72"},{"name":"新生第一年即参加 AP 课程","value":"100%"}],"id":"StatisticsConfig-4668b201-5035-4e22-b10a-5f8f409f30ab"}},{"type":"CoursesConfig","props":{"title":"课程概览","id":"CoursesConfig-dbbfd94c-6efe-4285-a952-ff3709eed36c","resolvedCourses":{"National Curriculum":[{"id":23,"type":"course","titlePublishedEN":"Chinese Literature","titlePublishedZH":"语文","titleDraftEN":"Chinese Literature","titleDraftZH":"语文","shortContentPublishedEN":null,"shortContentPublishedZH":null,"shortContentDraftEN":null,"shortContentDraftZH":null,"slug":"chinese-literature","categoryEN":"National Curriculum","categoryZH":"国家课程","coverImagePublished":null,"coverImageDraft":null,"creator":{"id":3406762,"name":"蔺东来 Lin","pinyin":"Lin Donglai","roles":["admin","writer","editor"],"type":"student","gender":"male","createdAt":"2025-10-09T00:27:24.124Z","updatedAt":"2025-12-22T12:22:16.336Z"},"createdAt":"2025-12-22T13:02:04.088Z","updatedAt":"2025-12-22T13:02:20.092Z"}],"AP":[{"id":24,"type":"course","titlePublishedEN":"AP Biology","titlePublishedZH":"AP 生物","titleDraftEN":"AP Biology","titleDraftZH":"AP 生物","shortContentPublishedEN":null,"shortContentPublishedZH":null,"shortContentDraftEN":null,"shortContentDraftZH":null,"slug":"ap-biology","categoryEN":"AP","categoryZH":"AP","coverImagePublished":null,"coverImageDraft":null,"creator":{"id":3406762,"name":"蔺东来 Lin","pinyin":"Lin Donglai","roles":["admin","writer","editor"],"type":"student","gender":"male","createdAt":"2025-10-09T00:27:24.124Z","updatedAt":"2025-12-22T12:22:16.336Z"},"createdAt":"2025-12-22T13:02:27.629Z","updatedAt":"2025-12-22T13:02:46.782Z"}]}}},{"type":"ImageTextLayoutConfig","props":{"lightText":false,"inverseOrder":false,"id":"ImageTextLayoutConfig-7ba73f58-3bba-4cb3-a4a5-4d28973570e7","resolvedImage":{"id":66,"sha1":"7a822d9377fc189c33d4b60980ca3cf841c646b8","name":"Admssons","altText":"ppl plang basketball","width":4000,"height":2667,"sizeKB":321,"uploaderId":3406762,"createdAt":"2025-12-22T13:52:58.599Z"},"resolvedUploadPrefix":"/uploads","image":"66","topText":"核心课程","title":"以大学先修课程支撑个性化学术发展","text":"BAID 构建了融合中国国家课程与美国大学先修课程 (AP 课程) 的国际化课程体系，为学生提供兼具广度与深度的学术选择。22 门 AP 课程覆盖数学、英语、科学与人文等多个领域，支持学生结合兴趣与发展方向开展深入学习。从九年级起，学生即可修读 AP 课程，在持续挑战中提升学术能力与自主学习能力。多年来，学生在 AP 全球统考中的 5 分率显著高于全球与中国平均水平。"}},{"type":"ImageTextLayoutConfig","props":{"lightText":true,"inverseOrder":true,"id":"ImageTextLayoutConfig-e012be5f-fd9f-4c91-a9e5-7bdd3283eb46","resolvedImage":{"id":65,"sha1":"29587e370b2cc9463b8858e7c81b0f51418f5759","name":"Student Projects","altText":"BAID students' ocean protection project","width":1920,"height":1039,"sizeKB":102,"uploaderId":3406762,"createdAt":"2025-12-22T13:31:36.244Z"},"resolvedUploadPrefix":"/uploads","image":"65","backgroundColor":"#9f0612","title":"以双语课堂培养自如的跨文化表达","topText":"双语教学","text":"BAID 将双语学习融入日常课堂与校园生活，帮助学生在真实、多元的环境中提升语言能力与文化理解力。我们的学生与教师来自全球 7 个国家与地区，为课堂带来丰富的文化背景与交流视角。学生在中英文之间自然切换，在不同文化语境中清晰表达观点、开展合作，逐步形成开放包容的视野与从容自信的跨文化表达能力。\\n"}},{"type":"ImageTextLayoutConfig","props":{"lightText":true,"inverseOrder":false,"id":"ImageTextLayoutConfig-4a1f908c-4cc8-426c-8d74-40dfa34f86b6","resolvedImage":{"id":66,"sha1":"7a822d9377fc189c33d4b60980ca3cf841c646b8","name":"Admssons","altText":"ppl plang basketball","width":4000,"height":2667,"sizeKB":321,"uploaderId":3406762,"createdAt":"2025-12-22T13:52:58.599Z"},"resolvedUploadPrefix":"/uploads","backgroundColor":"#4f5b74","image":"66","topText":"领导力","title":"以实践参与锤炼卓越的领导素养","text":"我们坚信，每位学生都应在真实参与中培养责任意识、组织能力与合作精神。BAID 为每一位学生提供丰富的实践平台，学生可以在学委会、班级、社团、选修课以及各类项目答辩团队中承担正式角色，在服务集体与带领团队的过程中积累经验、增长能力。一次次实践历练，让学生逐步学会倾听、判断与担当。"}},{"type":"ImageTextLayoutConfig","props":{"lightText":true,"inverseOrder":true,"id":"ImageTextLayoutConfig-2e73849b-68ac-41a8-9289-c2721effaa40","resolvedImage":{"id":45,"sha1":"77f4b800de9217193844ea2f3bbe6b7e33a886b4","name":"微信导入","altText":"由微信文章导入","width":832,"height":554,"sizeKB":38,"uploaderId":3406762,"createdAt":"2025-10-14T09:25:34.464Z"},"resolvedUploadPrefix":"/uploads","backgroundColor":"#103c74","image":"45","title":"以跨学科项目连接知识与真实世界","topText":"项目式学习","text":"在 BAID，学生们有无限机会在真实问题中综合运用知识、开展探究、形成成果。在 Major Foundation Program (MFP) 跨学科项目中，每位学生都围绕联合国可持续发展目标完成自己的学术项目，并撰写 5000 字学术论文。AP Seminar、AP Research 等课程进一步强化学生的独立思考与研究能力。学校还与中国传媒大学、清华大学无障碍发展研究院合作开展长期项目，为学生提供更加广阔的学术实践平台。","link":"/academics/pbl","linkText":"了解 BAID 的项目式学习机会"}},{"type":"ImageTextLayoutConfig","props":{"lightText":false,"inverseOrder":false,"id":"ImageTextLayoutConfig-22254b5d-775b-45f2-865f-b10aa41cc153","resolvedImage":{"id":63,"sha1":"eca52c9f86f2410f111503f970426e6a0c2bd94b","name":"Bejng Culture Exploration Program","altText":"Test","width":1280,"height":853,"sizeKB":85,"uploaderId":3406762,"createdAt":"2025-12-22T12:50:56.539Z"},"resolvedUploadPrefix":"/uploads","image":"63","title":"以中华根基对话广阔的世界课堂","topText":"立足中华 放眼世界","text":"BAID 重视立足北京、植根中国的文化根基，也重视学生面向世界的跨文化理解。通过中华文化寻根之旅、北京文化探究项目，学生能够深入理解中华文化的深厚内涵，在真实体验与项目探究中增强文化认同。与此同时，学校积极拓展世界大课堂，组织学生赴海外学校学习交流，在跨文化互动中开阔视野，增进理解。","link":"/academics/pbl","linkText":"了解中西合璧的活动机会"}},{"type":"ImageTextLayoutConfig","props":{"lightText":true,"inverseOrder":true,"id":"ImageTextLayoutConfig-f5a7be9b-ee17-4643-8fcb-0fa647c7fe6c","resolvedImage":{"id":62,"sha1":"073e82273837daeeaeec0f2e8a4603b962cbb875","name":"BA World School","altText":"Test","width":1280,"height":960,"sizeKB":316,"uploaderId":3406762,"createdAt":"2025-12-22T12:50:43.209Z"},"resolvedUploadPrefix":"/uploads","backgroundColor":"#9f0612","image":"62","topText":"课外学习项目","title":"以多彩平台滋养真实的兴趣与热爱","text":"BAID 尊重每一位学生独特的兴趣与潜能，并通过丰富多元的课程与活动平台支持学生持续探索、自主成长。40 余门选修课、50 余个学生社团覆盖音乐、视觉艺术、表演艺术、科学、人文、运动等多个领域，为学生提供广阔的发展空间。3/28 走进自然、北中小舞台、北中小讲师等活动，让学生在自主设计、公开表达与实践体验中不断发现热爱、发展所长。","link":"/life","linkText":"了解 BAID 的课外学习项目"}},{"type":"ImageTextLayoutConfig","props":{"lightText":true,"inverseOrder":false,"id":"ImageTextLayoutConfig-ff128149-cfd9-4dfa-baec-e4f20b12d9b7","resolvedImage":{"id":59,"sha1":"dfdbae4816a16dd1a41563aac9cf52ecfdf204ee","name":"BA Lectures","altText":"olympics gold medalist Yang Yang at an event","width":1080,"height":720,"sizeKB":68,"uploaderId":3406762,"createdAt":"2025-12-22T12:49:50.419Z"},"resolvedUploadPrefix":"/uploads","image":"59","title":"以责任担当践行 \\"世界因我更美好\\" 的理念","text":"在 BAID，服务是学生承担公民义务的重要方式。我们的学生从真实问题出发，关注他人、关注社区、关注更广阔的公共议题。BAID 学生为城中村留守儿童开展关爱行动，为视障人士设计导航软件，举办慈善音乐会，推动更多人关注全球饥饿等议题。在一次次切实的参与中，\\"世界因我更美好\\" 逐渐成为学生的价值追求与自觉行动。","backgroundColor":"#4f5b74","topText":"公民、责任与担当","link":"/projects","linkText":"了解我们的学生项目"}},{"type":"ImageTextLayoutConfig","props":{"lightText":true,"inverseOrder":true,"id":"ImageTextLayoutConfig-136ef1aa-8594-4144-9d55-6dfd09db92c2","resolvedImage":{"id":6,"sha1":"9942a41c5b79b01ed07566182c6e54e34b3079b7","name":"Test","altText":"Test","width":6016,"height":3384,"sizeKB":1204,"uploaderId":3406762,"createdAt":"2025-10-14T03:02:23.332Z"},"resolvedUploadPrefix":"/uploads","backgroundColor":"#103c74","topText":"大学升学辅导","title":"在最适合自己的大学逐梦远方","text":"BAID 始终关注每一位学生的长远发展，陪伴他们走向更广阔的未来。近年来，学生已陆续收获哈佛、斯坦福、牛津、剑桥、香港大学、东京大学、多伦多大学等世界知名高校录取。学校坚持健康、理性的升学理念，专业升学指导教师从学生入学起便持续开展每周讲座，并与学生及家庭保持一对一沟通，提供细致、个性化的支持。与此同时，BAID 还经常邀请高校招生官到校交流，让学生在真实对话中加深对未来方向的理解。","image":"6","link":"/academics/college-counseling","linkText":"了解我们的大学升学指导"}},{"type":"SpacerConfig","props":{"height":"5rem","id":"SpacerConfig-10c317bb-02ff-4944-ad52-666181baf7b2"}},{"type":"ButtonConfig","props":{"text":"了解 BAID 的高中招生项目","link":"/admissions/baid","blank":false,"color":"blue","size":"md","align":"center","id":"ButtonConfig-e57f985c-c81b-4a32-a373-eee17495ef9e"}},{"type":"SpacerConfig","props":{"height":"5rem","id":"SpacerConfig-ed794a30-1fdf-40e3-8a8c-69ec49936f76"}}],"zones":{}}	\N	\N	3406762	2026-03-20 03:12:17.796	2026-04-05 03:55:21.966	\N	\N	\N	\N	\N	\N
38	page	Dining	用餐	Dining	用餐	life/dining	{"root":{"props":{"title":"Dining"},"type":"root"},"content":[{"type":"SpacerConfig","props":{"height":"5rem","id":"SpacerConfig-40d9b079-d90f-469c-8f54-d09081349e4d"}},{"type":"HorizontalTopTextConfig","props":{"title":"There's always something you'd love!","text":"With three dining halls and two cafés, we've got options for every mood—build-your-own meals, Cantonese roast, Western bites, regional flavors, and more. Every day, there's something to crave for.\\n","id":"HorizontalTopTextConfig-a2461122-1d8e-496c-a49f-7451076ccd2b"}},{"type":"SpacerConfig","props":{"height":"5rem","id":"SpacerConfig-4d5058f9-fd6b-421e-ae64-c6645a9d585e"}},{"type":"HeroConfig","props":{"title":"Dining","backgroundColor":"#ffffff","lightText":false,"topPadding":false,"id":"HeroConfig-a62950ac-6823-4192-9783-8117c36a6848","resolvedImage":{"id":67,"sha1":"97e9fc13e8bc414ec93c58b64d599ba5ca85b7df","name":"Buldng of Dongba Campus","altText":"Buldng of Dongba Campus","width":3840,"height":2560,"sizeKB":1108,"uploaderId":3406762,"createdAt":"2025-12-22T13:57:44.403Z"},"resolvedUploadPrefix":"/uploads","image":"67"}},{"type":"StatisticsConfig","props":{"title":"Dining at BAID","content":[{"name":"meticulously crafted meals","value":"200+"},{"name":"food stalls throughout campus","value":"14"},{"name":"all-you-can-eat","value":"¥20"},{"name":"or pay per 50 grams of food","value":"¥2.38"},{"name":"of staff receive training on nutrition and dietary needs","value":"100%"},{"name":"cafés for drinks and desserts","value":"2"}],"id":"StatisticsConfig-e2a80e0a-1b37-42d8-b736-a1cca3d1dc20"}},{"type":"HighlightsConfig","props":{"id":"HighlightsConfig-4fcd6014-ccfe-453c-8f2d-a9b4913978f0","resolvedHighlights":[{"title":"Nutrition for Everyone","text":"Our standards go beyond Beijing student nutrition guidelines. At BAID, we offer a wide range of balanced choices, plus options for diverse dietary needs.","image":{"id":64,"sha1":"15f6901d80775583c340abba2d020f0ce28fbeb6","name":"Life at BAID","altText":"People playing football on the playground","width":3976,"height":2652,"sizeKB":431,"uploaderId":3406762,"createdAt":"2025-12-22T13:05:12.808Z"}},{"title":"Dining for the Earth","text":"From source to service, we always try to reduce our footprint. Each meal is prepared with sustainability in mind.","image":{"id":62,"sha1":"073e82273837daeeaeec0f2e8a4603b962cbb875","name":"BA World School","altText":"Test","width":1280,"height":960,"sizeKB":316,"uploaderId":3406762,"createdAt":"2025-12-22T12:50:43.209Z"}},{"title":"Fuel, Anytime","text":"Our cafés and snack spots offer drinks and quick bites, so students can recharge between classes or activities.","image":{"id":63,"sha1":"eca52c9f86f2410f111503f970426e6a0c2bd94b","name":"Bejng Culture Exploration Program","altText":"Test","width":1280,"height":853,"sizeKB":85,"uploaderId":3406762,"createdAt":"2025-12-22T12:50:56.539Z"}}],"resolvedUploadPrefix":"/uploads","highlights":[{"title":"Nutrition for Everyone","image":"64","text":"Our standards go beyond Beijing student nutrition guidelines. At BAID, we offer a wide range of balanced choices, plus options for diverse dietary needs."},{"title":"Dining for the Earth","image":"62","text":"From source to service, we always try to reduce our footprint. Each meal is prepared with sustainability in mind."},{"image":"63","title":"Fuel, Anytime","text":"Our cafés and snack spots offer drinks and quick bites, so students can recharge between classes or activities."}]}},{"type":"GridTextConfig","props":{"title":"The Story of Our Food","texts":[{"text":"Food at BAID isn't just about tasting good (though it does!) The dining program sources all ingredients fresh. With daily preparation, we reduce intermediate steps to ensure freshness and safety. Each station selects appropriate ingredients and unique methods for each dish so students can rely on each meal."},{"text":"Alongside a wide range of options, we pay special attention to nutritional balance. Clear labeling helps students make informed choices based on their needs—whether for daily meals, post-training recovery, or specific dietary needs—while supporting the development of healthier eating habits."},{"text":"The three dining halls and two cafés are distributed across campus, with spacious and comfortable environments that are among the best across China. These spaces also serve as places for conversation, collaboration, and short breaks."}],"id":"GridTextConfig-67b33592-4422-4d17-bf16-7aed20f94cff"}},{"type":"ImageGalleryConfig","props":{"title":"Image Slideshow","slides":[{"title":"Yanxiangyuan Caféteria","content":"Something something. Something something. Something something. Something something. Something something. Something something. Something something. Something something. ","image":"67"}],"id":"ImageGalleryConfig-5bedb60c-4688-4016-80e9-1220921cf3e2","resolvedSlides":[{"title":"Yanxiangyuan Caféteria","content":"Something something. Something something. Something something. Something something. Something something. Something something. Something something. Something something. ","image":{"id":67,"sha1":"97e9fc13e8bc414ec93c58b64d599ba5ca85b7df","name":"Buldng of Dongba Campus","altText":"Buldng of Dongba Campus","width":3840,"height":2560,"sizeKB":1108,"uploaderId":3406762,"createdAt":"2025-12-22T13:57:44.403Z"}}],"resolvedUploadPrefix":"/uploads"}}],"zones":{}}	{"root":{"props":{"title":"用餐"},"type":"root"},"content":[{"type":"SpacerConfig","props":{"height":"5rem","id":"SpacerConfig-40d9b079-d90f-469c-8f54-d09081349e4d"}},{"type":"HorizontalTopTextConfig","props":{"title":"总有你想吃的!","text":"三个食堂、两个咖啡馆，从称重自选到广式烧腊，从西式简餐到兰疆风味，各种选择一应俱全，每天都能吃到合自己胃口的那一份。","id":"HorizontalTopTextConfig-a2461122-1d8e-496c-a49f-7451076ccd2b"}},{"type":"SpacerConfig","props":{"height":"5rem","id":"SpacerConfig-4d5058f9-fd6b-421e-ae64-c6645a9d585e"}},{"type":"HeroConfig","props":{"title":"Dining","backgroundColor":"#ffffff","lightText":false,"topPadding":false,"id":"HeroConfig-a62950ac-6823-4192-9783-8117c36a6848","resolvedImage":{"id":67,"sha1":"97e9fc13e8bc414ec93c58b64d599ba5ca85b7df","name":"Buldng of Dongba Campus","altText":"Buldng of Dongba Campus","width":3840,"height":2560,"sizeKB":1108,"uploaderId":3406762,"createdAt":"2025-12-22T13:57:44.403Z"},"resolvedUploadPrefix":"/uploads","image":"67"}},{"type":"StatisticsConfig","props":{"title":"BAID 的餐饮","content":[{"name":"菜式选择","value":"200"},{"name":"特色档口","value":"1"},{"name":"即可任选自助餐","value":"¥20"},{"name":"每 50 克的称重自助","value":"¥2.38"},{"name":"服务人员接受宗教与过敏原培训","value":"100%"},{"name":"提供饮品与甜点的咖啡馆","value":"2"}],"id":"StatisticsConfig-e2a80e0a-1b37-42d8-b736-a1cca3d1dc20"}},{"type":"HighlightsConfig","props":{"id":"HighlightsConfig-4fcd6014-ccfe-453c-8f2d-a9b4913978f0","resolvedHighlights":[{"title":"每个人的营养选择","text":"我们的餐饮标准高于《学生餐营养指南》，提供多样化的饮食搭配选择，同时提供清真与无过敏原食品，满足每位同学的需求。","image":{"id":64,"sha1":"15f6901d80775583c340abba2d020f0ce28fbeb6","name":"Life at BAID","altText":"People playing football on the playground","width":3976,"height":2652,"sizeKB":431,"uploaderId":3406762,"createdAt":"2025-12-22T13:05:12.808Z"}},{"title":"尊重地球的绿色餐饮","text":"从食材选择到供应方式，我们尽可能减少餐饮带来的碳足迹，让每一餐都更可持续。","image":{"id":62,"sha1":"073e82273837daeeaeec0f2e8a4603b962cbb875","name":"BA World School","altText":"Test","width":1280,"height":960,"sizeKB":316,"uploaderId":3406762,"createdAt":"2025-12-22T12:50:43.209Z"}},{"title":"随时补充能量","text":"咖啡馆与餐饮点提供丰富的饮品与小食，课间或活动间隙，都能轻松补充能量。","image":{"id":63,"sha1":"eca52c9f86f2410f111503f970426e6a0c2bd94b","name":"Bejng Culture Exploration Program","altText":"Test","width":1280,"height":853,"sizeKB":85,"uploaderId":3406762,"createdAt":"2025-12-22T12:50:56.539Z"}}],"resolvedUploadPrefix":"/uploads","highlights":[{"title":"每个人的营养选择","image":"64","text":"我们的餐饮标准高于《学生餐营养指南》，提供多样化的饮食搭配选择，同时提供清真与无过敏原食品，满足每位同学的需求。"},{"title":"尊重地球的绿色餐饮","image":"62","text":"从食材选择到供应方式，我们尽可能减少餐饮带来的碳足迹，让每一餐都更可持续。"},{"image":"63","title":"随时补充能量","text":"咖啡馆与餐饮点提供丰富的饮品与小食，课间或活动间隙，都能轻松补充能量。"}]}},{"type":"GridTextConfig","props":{"title":"食物的故事","texts":[{"text":"从源头把控食材品质，餐厅坚持高频次新鲜采购、当日加工制作，尽量减少中间环节，保证食材的新鲜度与安全性。不同档口根据菜品特点选择合适的食材与做法，让口味与品质都保持稳定，让学生每天都能吃到安心、可靠的一餐。"},{"text":"在丰富选择的基础上更加注重营养搭配，餐品提供清晰的信息标识，方便学生根据自身需求进行选择。无论是日常均衡饮食、运动训练后的补充，还是特殊饮食需求，都能在这里找到合适的组合，同时也帮助学生逐步建立更科学的饮食习惯。"},{"text":"三个食堂与两个咖啡馆分布在校园不同区域，空间宽敞、环境舒适，满足不同时间段的用餐与停留需求。这里不仅是用餐的地方，也常常成为同学交流、讨论或短暂放松的空间。"}],"id":"GridTextConfig-67b33592-4422-4d17-bf16-7aed20f94cff"}},{"type":"ImageGalleryConfig","props":{"title":"图片轮播","slides":[{"title":"燕翔园食堂","content":"这是食堂的介绍，这是食堂的介绍。这是食堂的介绍，这是食堂的介绍。这是食堂的介绍，这是食堂的介绍。这是食堂的介绍，这是食堂的介绍。","image":"67"}],"id":"ImageGalleryConfig-5bedb60c-4688-4016-80e9-1220921cf3e2","resolvedSlides":[{"title":"燕翔园食堂","content":"这是食堂的介绍，这是食堂的介绍。这是食堂的介绍，这是食堂的介绍。这是食堂的介绍，这是食堂的介绍。这是食堂的介绍，这是食堂的介绍。","image":{"id":67,"sha1":"97e9fc13e8bc414ec93c58b64d599ba5ca85b7df","name":"Buldng of Dongba Campus","altText":"Buldng of Dongba Campus","width":3840,"height":2560,"sizeKB":1108,"uploaderId":3406762,"createdAt":"2025-12-22T13:57:44.403Z"}}],"resolvedUploadPrefix":"/uploads"}}],"zones":{}}	{"root":{"props":{"title":"Dining"},"type":"root"},"content":[{"type":"SpacerConfig","props":{"height":"5rem","id":"SpacerConfig-40d9b079-d90f-469c-8f54-d09081349e4d"}},{"type":"HorizontalTopTextConfig","props":{"title":"There's always something you'd love!","text":"With three dining halls and two cafés, we've got options for every mood—build-your-own meals, Cantonese roast, Western bites, regional flavors, and more. Every day, there's something to crave for.\\n","id":"HorizontalTopTextConfig-a2461122-1d8e-496c-a49f-7451076ccd2b"}},{"type":"SpacerConfig","props":{"height":"5rem","id":"SpacerConfig-4d5058f9-fd6b-421e-ae64-c6645a9d585e"}},{"type":"HeroConfig","props":{"title":"Dining","backgroundColor":"#ffffff","lightText":false,"topPadding":false,"id":"HeroConfig-a62950ac-6823-4192-9783-8117c36a6848","resolvedImage":{"id":67,"sha1":"97e9fc13e8bc414ec93c58b64d599ba5ca85b7df","name":"Buldng of Dongba Campus","altText":"Buldng of Dongba Campus","width":3840,"height":2560,"sizeKB":1108,"uploaderId":3406762,"createdAt":"2025-12-22T13:57:44.403Z"},"resolvedUploadPrefix":"/uploads","image":"67"}},{"type":"StatisticsConfig","props":{"title":"Dining at BAID","content":[{"name":"meticulously crafted meals","value":"200+"},{"name":"food stalls throughout campus","value":"14"},{"name":"all-you-can-eat","value":"¥20"},{"name":"or pay per 50 grams of food","value":"¥2.38"},{"name":"of staff receive training on nutrition and dietary needs","value":"100%"},{"name":"cafés for drinks and desserts","value":"2"}],"id":"StatisticsConfig-e2a80e0a-1b37-42d8-b736-a1cca3d1dc20"}},{"type":"HighlightsConfig","props":{"id":"HighlightsConfig-4fcd6014-ccfe-453c-8f2d-a9b4913978f0","resolvedHighlights":[{"title":"Nutrition for Everyone","text":"Our standards go beyond Beijing student nutrition guidelines. At BAID, we offer a wide range of balanced choices, plus options for diverse dietary needs.","image":{"id":64,"sha1":"15f6901d80775583c340abba2d020f0ce28fbeb6","name":"Life at BAID","altText":"People playing football on the playground","width":3976,"height":2652,"sizeKB":431,"uploaderId":3406762,"createdAt":"2025-12-22T13:05:12.808Z"}},{"title":"Dining for the Earth","text":"From source to service, we always try to reduce our footprint. Each meal is prepared with sustainability in mind.","image":{"id":62,"sha1":"073e82273837daeeaeec0f2e8a4603b962cbb875","name":"BA World School","altText":"Test","width":1280,"height":960,"sizeKB":316,"uploaderId":3406762,"createdAt":"2025-12-22T12:50:43.209Z"}},{"title":"Fuel, Anytime","text":"Our cafés and snack spots offer drinks and quick bites, so students can recharge between classes or activities.","image":{"id":63,"sha1":"eca52c9f86f2410f111503f970426e6a0c2bd94b","name":"Bejng Culture Exploration Program","altText":"Test","width":1280,"height":853,"sizeKB":85,"uploaderId":3406762,"createdAt":"2025-12-22T12:50:56.539Z"}}],"resolvedUploadPrefix":"/uploads","highlights":[{"title":"Nutrition for Everyone","image":"64","text":"Our standards go beyond Beijing student nutrition guidelines. At BAID, we offer a wide range of balanced choices, plus options for diverse dietary needs."},{"title":"Dining for the Earth","image":"62","text":"From source to service, we always try to reduce our footprint. Each meal is prepared with sustainability in mind."},{"image":"63","title":"Fuel, Anytime","text":"Our cafés and snack spots offer drinks and quick bites, so students can recharge between classes or activities."}]}},{"type":"GridTextConfig","props":{"title":"The Story of Our Food","texts":[{"text":"Food at BAID isn't just about tasting good (though it does!) The dining program sources all ingredients fresh. With daily preparation, we reduce intermediate steps to ensure freshness and safety. Each station selects appropriate ingredients and unique methods for each dish so students can rely on each meal."},{"text":"Alongside a wide range of options, we pay special attention to nutritional balance. Clear labeling helps students make informed choices based on their needs—whether for daily meals, post-training recovery, or specific dietary needs—while supporting the development of healthier eating habits."},{"text":"The three dining halls and two cafés are distributed across campus, with spacious and comfortable environments that are among the best across China. These spaces also serve as places for conversation, collaboration, and short breaks."}],"id":"GridTextConfig-67b33592-4422-4d17-bf16-7aed20f94cff"}},{"type":"ImageGalleryConfig","props":{"title":"Image Slideshow","slides":[{"title":"Yanxiangyuan Caféteria","content":"Something something. Something something. Something something. Something something. Something something. Something something. Something something. Something something. ","image":"67"}],"id":"ImageGalleryConfig-5bedb60c-4688-4016-80e9-1220921cf3e2","resolvedSlides":[{"title":"Yanxiangyuan Caféteria","content":"Something something. Something something. Something something. Something something. Something something. Something something. Something something. Something something. ","image":{"id":67,"sha1":"97e9fc13e8bc414ec93c58b64d599ba5ca85b7df","name":"Buldng of Dongba Campus","altText":"Buldng of Dongba Campus","width":3840,"height":2560,"sizeKB":1108,"uploaderId":3406762,"createdAt":"2025-12-22T13:57:44.403Z"}}],"resolvedUploadPrefix":"/uploads"}}],"zones":{}}	{"root":{"props":{"title":"用餐"},"type":"root"},"content":[{"type":"SpacerConfig","props":{"height":"5rem","id":"SpacerConfig-40d9b079-d90f-469c-8f54-d09081349e4d"}},{"type":"HorizontalTopTextConfig","props":{"title":"总有你想吃的!","text":"三个食堂、两个咖啡馆，从称重自选到广式烧腊，从西式简餐到兰疆风味，各种选择一应俱全，每天都能吃到合自己胃口的那一份。","id":"HorizontalTopTextConfig-a2461122-1d8e-496c-a49f-7451076ccd2b"}},{"type":"SpacerConfig","props":{"height":"5rem","id":"SpacerConfig-4d5058f9-fd6b-421e-ae64-c6645a9d585e"}},{"type":"HeroConfig","props":{"title":"Dining","backgroundColor":"#ffffff","lightText":false,"topPadding":false,"id":"HeroConfig-a62950ac-6823-4192-9783-8117c36a6848","resolvedImage":{"id":67,"sha1":"97e9fc13e8bc414ec93c58b64d599ba5ca85b7df","name":"Buldng of Dongba Campus","altText":"Buldng of Dongba Campus","width":3840,"height":2560,"sizeKB":1108,"uploaderId":3406762,"createdAt":"2025-12-22T13:57:44.403Z"},"resolvedUploadPrefix":"/uploads","image":"67"}},{"type":"StatisticsConfig","props":{"title":"BAID 的餐饮","content":[{"name":"菜式选择","value":"200"},{"name":"特色档口","value":"1"},{"name":"即可任选自助餐","value":"¥20"},{"name":"每 50 克的称重自助","value":"¥2.38"},{"name":"服务人员接受宗教与过敏原培训","value":"100%"},{"name":"提供饮品与甜点的咖啡馆","value":"2"}],"id":"StatisticsConfig-e2a80e0a-1b37-42d8-b736-a1cca3d1dc20"}},{"type":"HighlightsConfig","props":{"id":"HighlightsConfig-4fcd6014-ccfe-453c-8f2d-a9b4913978f0","resolvedHighlights":[{"title":"每个人的营养选择","text":"我们的餐饮标准高于《学生餐营养指南》，提供多样化的饮食搭配选择，同时提供清真与无过敏原食品，满足每位同学的需求。","image":{"id":64,"sha1":"15f6901d80775583c340abba2d020f0ce28fbeb6","name":"Life at BAID","altText":"People playing football on the playground","width":3976,"height":2652,"sizeKB":431,"uploaderId":3406762,"createdAt":"2025-12-22T13:05:12.808Z"}},{"title":"尊重地球的绿色餐饮","text":"从食材选择到供应方式，我们尽可能减少餐饮带来的碳足迹，让每一餐都更可持续。","image":{"id":62,"sha1":"073e82273837daeeaeec0f2e8a4603b962cbb875","name":"BA World School","altText":"Test","width":1280,"height":960,"sizeKB":316,"uploaderId":3406762,"createdAt":"2025-12-22T12:50:43.209Z"}},{"title":"随时补充能量","text":"咖啡馆与餐饮点提供丰富的饮品与小食，课间或活动间隙，都能轻松补充能量。","image":{"id":63,"sha1":"eca52c9f86f2410f111503f970426e6a0c2bd94b","name":"Bejng Culture Exploration Program","altText":"Test","width":1280,"height":853,"sizeKB":85,"uploaderId":3406762,"createdAt":"2025-12-22T12:50:56.539Z"}}],"resolvedUploadPrefix":"/uploads","highlights":[{"title":"每个人的营养选择","image":"64","text":"我们的餐饮标准高于《学生餐营养指南》，提供多样化的饮食搭配选择，同时提供清真与无过敏原食品，满足每位同学的需求。"},{"title":"尊重地球的绿色餐饮","image":"62","text":"从食材选择到供应方式，我们尽可能减少餐饮带来的碳足迹，让每一餐都更可持续。"},{"image":"63","title":"随时补充能量","text":"咖啡馆与餐饮点提供丰富的饮品与小食，课间或活动间隙，都能轻松补充能量。"}]}},{"type":"GridTextConfig","props":{"title":"食物的故事","texts":[{"text":"从源头把控食材品质，餐厅坚持高频次新鲜采购、当日加工制作，尽量减少中间环节，保证食材的新鲜度与安全性。不同档口根据菜品特点选择合适的食材与做法，让口味与品质都保持稳定，让学生每天都能吃到安心、可靠的一餐。"},{"text":"在丰富选择的基础上更加注重营养搭配，餐品提供清晰的信息标识，方便学生根据自身需求进行选择。无论是日常均衡饮食、运动训练后的补充，还是特殊饮食需求，都能在这里找到合适的组合，同时也帮助学生逐步建立更科学的饮食习惯。"},{"text":"三个食堂与两个咖啡馆分布在校园不同区域，空间宽敞、环境舒适，满足不同时间段的用餐与停留需求。这里不仅是用餐的地方，也常常成为同学交流、讨论或短暂放松的空间。"}],"id":"GridTextConfig-67b33592-4422-4d17-bf16-7aed20f94cff"}},{"type":"ImageGalleryConfig","props":{"title":"图片轮播","slides":[{"title":"燕翔园食堂","content":"这是食堂的介绍，这是食堂的介绍。这是食堂的介绍，这是食堂的介绍。这是食堂的介绍，这是食堂的介绍。这是食堂的介绍，这是食堂的介绍。","image":"67"}],"id":"ImageGalleryConfig-5bedb60c-4688-4016-80e9-1220921cf3e2","resolvedSlides":[{"title":"燕翔园食堂","content":"这是食堂的介绍，这是食堂的介绍。这是食堂的介绍，这是食堂的介绍。这是食堂的介绍，这是食堂的介绍。这是食堂的介绍，这是食堂的介绍。","image":{"id":67,"sha1":"97e9fc13e8bc414ec93c58b64d599ba5ca85b7df","name":"Buldng of Dongba Campus","altText":"Buldng of Dongba Campus","width":3840,"height":2560,"sizeKB":1108,"uploaderId":3406762,"createdAt":"2025-12-22T13:57:44.403Z"}}],"resolvedUploadPrefix":"/uploads"}}],"zones":{}}	\N	\N	3406762	2026-03-23 05:34:07.99	2026-04-05 03:55:22.303	\N	\N	\N	\N	\N	\N
25	page	Life @ BAID	学生生活	Life @ BAID	学生生活	life	{"root":{"props":{"title":"Life @ BAID"},"type":"root"},"content":[{"type":"HeroConfig","props":{"title":"Life @ BAID","backgroundColor":"#9f0612","lightText":true,"id":"HeroConfig-2ff512a4-395b-4fe4-98d7-1222bd2ad56d","resolvedImage":{"id":64,"sha1":"15f6901d80775583c340abba2d020f0ce28fbeb6","name":"Life at BAID","altText":"People playing football on the playground","width":3976,"height":2652,"sizeKB":431,"uploaderId":3406762,"createdAt":"2025-12-22T13:05:12.808Z"},"resolvedUploadPrefix":"/uploads","image":"64","topPadding":true}},{"type":"SpacerConfig","props":{"height":"5rem","id":"SpacerConfig-1efe85f8-ceeb-4b87-a48d-4269f4992e3f"}},{"type":"TopTextConfig","props":{"title":"Live the best years of your life","text":" BAID knows academics well—it's kind of our thing. But life here goes far beyond the classroom. Projects, clubs, teams—and of course our friends—fill each day with energy, connection, and the kind of community that makes school life the best years of your life.","to":"","linkText":"","id":"TopTextConfig-7e613c0a-c6de-4dfd-ae18-10eecff965e9"}},{"type":"SpacerConfig","props":{"height":"5rem","id":"SpacerConfig-2f0aaed8-28e3-440f-b30a-d50d2f2e8b0d"}},{"type":"HighlightsConfig","props":{"id":"HighlightsConfig-ecfd2806-53d9-41ea-95ab-f4e35baa1f81","resolvedHighlights":[{"title":"Clubs","text":"With more than 50 student-led clubs and organizations, the only hard part is choosing.","image":{"id":61,"sha1":"aa7cee5aa085f8478b0287b3615fe7ab61a0800e","name":"Career Exploraton","altText":"Career","width":1080,"height":721,"sizeKB":42,"uploaderId":3406762,"createdAt":"2025-12-22T12:50:31.021Z"},"link":"/life/clubs","linkText":"Clubs"},{"title":"Electives","text":"More than 40 electives, taught by people from all walks of life. Robotics, art, science, culture… there is always something to love.","image":{"id":59,"sha1":"dfdbae4816a16dd1a41563aac9cf52ecfdf204ee","name":"BA Lectures","altText":"olympics gold medalist Yang Yang at an event","width":1080,"height":720,"sizeKB":68,"uploaderId":3406762,"createdAt":"2025-12-22T12:49:50.419Z"},"link":"/life/electives","linkText":"Electives"},{"title":"Student Projects","text":"\\"Better me, better world\\" is our motto—and a call to action for every BAID student.","image":{"id":65,"sha1":"29587e370b2cc9463b8858e7c81b0f51418f5759","name":"Student Projects","altText":"BAID students' ocean protection project","width":1920,"height":1039,"sizeKB":102,"uploaderId":3406762,"createdAt":"2025-12-22T13:31:36.244Z"},"link":"/projects","linkText":"Projects Gallery"}],"resolvedUploadPrefix":"/uploads","highlights":[{"title":"Clubs","link":"/life/clubs","linkText":"Clubs","image":"61","text":"With more than 50 student-led clubs and organizations, the only hard part is choosing."},{"title":"Electives","link":"/life/electives","linkText":"Electives","image":"59","text":"More than 40 electives, taught by people from all walks of life. Robotics, art, science, culture… there is always something to love."},{"title":"Student Projects","link":"/projects","linkText":"Projects Gallery","image":"65","text":"\\"Better me, better world\\" is our motto—and a call to action for every BAID student."}]}},{"type":"SpacerConfig","props":{"height":"3rem","id":"SpacerConfig-852b409b-9f5f-4398-a578-d4bed0a18a57"}},{"type":"HighlightsConfig","props":{"id":"HighlightsConfig-3a4f57b9-3a33-497b-ac34-ce42052b4a2f","resolvedHighlights":[{"title":"Dining","text":"We really, really love food. With three dining halls, two cafés, and plenty of choices in between, you will never go hungry.","image":{"id":62,"sha1":"073e82273837daeeaeec0f2e8a4603b962cbb875","name":"BA World School","altText":"Test","width":1280,"height":960,"sizeKB":316,"uploaderId":3406762,"createdAt":"2025-12-22T12:50:43.209Z"},"link":"/life/dining","linkText":"Dining"},{"title":"Athletics","text":"Tennis, baseball, gym, soccer, basketball, dance, volleyball, archery… try something new, or keep doing what you already love—there's always a sport for you.","image":{"id":64,"sha1":"15f6901d80775583c340abba2d020f0ce28fbeb6","name":"Life at BAID","altText":"People playing football on the playground","width":3976,"height":2652,"sizeKB":431,"uploaderId":3406762,"createdAt":"2025-12-22T13:05:12.808Z"},"link":"/life/athletics","linkText":"Athletics"},{"title":"Activities","text":"BAID Speaker, BAID Stage, Into Nature, and experiential courses—these are spaces for expression, exploration, and getting a little closer to nature and culture along the way.","image":{"id":60,"sha1":"9cfa20529bb0b0d4037f790528b1045ad23b49a2","name":"Experental Program","altText":"Test","width":800,"height":600,"sizeKB":129,"uploaderId":3406762,"createdAt":"2025-12-22T12:50:17.892Z"},"link":"/life/activities","linkText":"Activities"}],"resolvedUploadPrefix":"/uploads","highlights":[{"title":"Dining","text":"We really, really love food. With three dining halls, two cafés, and plenty of choices in between, you will never go hungry.","link":"/life/dining","linkText":"Dining","image":"62"},{"title":"Athletics","link":"/life/athletics","linkText":"Athletics","image":"64","text":"Tennis, baseball, gym, soccer, basketball, dance, volleyball, archery… try something new, or keep doing what you already love—there's always a sport for you."},{"title":"Activities","link":"/life/activities","linkText":"Activities","image":"60","text":"BAID Speaker, BAID Stage, Into Nature, and experiential courses—these are spaces for expression, exploration, and getting a little closer to nature and culture along the way."}]}},{"type":"SpacerConfig","props":{"height":"5rem","id":"SpacerConfig-7ccfc091-03de-476a-9b32-503658b1e169"}},{"type":"ImageGalleryConfig","props":{"title":"Image Slideshow","slides":[{"title":"Beijing Academy Main Campus","content":"Opened in September 2025, the main campus of Beijing Academy spans approximately 50,000 square meters and is made up of 11 beautifully arranged buildings, each named after a place in Beijing. Here, learning, activity, and daily life flow naturally together. With every step across campus, students can feel its openness and rhythm—and slowly find a corner that feels like their own.","image":"83"},{"image":"85","content":"Opened in September 2025, the main campus of Beijing Academy spans approximately 50,000 square meters and is made up of 11 beautifully arranged buildings, each named after a place in Beijing. Here, learning, activity, and daily life flow naturally together. With every step across campus, students can feel its openness and rhythm—and slowly find a corner that feels like their own.","title":"Beijing Academy Main Campus"},{"image":"84","title":"Better Me, Better World","content":"\\"Better me, better world\\" is the direction that guides every Beijing Academy student. It begins with attention to the people and needs around us, and grows through real service and real action. Through experience, reflection, and effort, students come to understand responsibility, learn to contribute, and make a true difference in the lives of others."}],"id":"ImageGalleryConfig-ee46552b-82e9-41ee-96ed-732d2a3c957e","resolvedSlides":[{"title":"Beijing Academy Main Campus","content":"Opened in September 2025, the main campus of Beijing Academy spans approximately 50,000 square meters and is made up of 11 beautifully arranged buildings, each named after a place in Beijing. Here, learning, activity, and daily life flow naturally together. With every step across campus, students can feel its openness and rhythm—and slowly find a corner that feels like their own.","image":{"id":83,"sha1":"fcce2b7adbc66a53c773f522b686cafbf3562794","name":"北京中学本部效果图","altText":"显示了北京中学本部样式","width":1222,"height":864,"sizeKB":199,"uploaderId":3406762,"createdAt":"2026-04-01T02:47:43.075Z"}},{"title":"Beijing Academy Main Campus","content":"Opened in September 2025, the main campus of Beijing Academy spans approximately 50,000 square meters and is made up of 11 beautifully arranged buildings, each named after a place in Beijing. Here, learning, activity, and daily life flow naturally together. With every step across campus, students can feel its openness and rhythm—and slowly find a corner that feels like their own.","image":{"id":85,"sha1":"0f6713c1ec24e92ee752d69cd5e932a2425e3e67","name":"校园一角","altText":"绿荫草地中的校园一角","width":2560,"height":1708,"sizeKB":368,"uploaderId":3406762,"createdAt":"2026-04-01T02:53:30.941Z"}},{"title":"Better Me, Better World","content":"\\"Better me, better world\\" is the direction that guides every Beijing Academy student. It begins with attention to the people and needs around us, and grows through real service and real action. Through experience, reflection, and effort, students come to understand responsibility, learn to contribute, and make a true difference in the lives of others.","image":{"id":84,"sha1":"73f1b4ce105d507b82bdab99c363a2d9994b9564","name":"世界因我更美好","altText":"一块显示了「世界因我更美好」的石碑","width":2000,"height":1333,"sizeKB":490,"uploaderId":3406762,"createdAt":"2026-04-01T02:49:50.252Z"}}],"resolvedUploadPrefix":"/uploads"}},{"type":"SpacerConfig","props":{"height":"5rem","id":"SpacerConfig-09b4cf74-8a18-46be-8c17-1b5b0145b195"}},{"type":"ContainerConfig","props":{"children":[{"type":"HeadingConfig","props":{"level":2,"size":"4xl","align":"center","bold":true,"italic":false,"color":"#000000","id":"HeadingConfig-ab292a9b-2199-4e48-b739-edfbe8b06612","text":"Campus Life"}}],"contentWidth":true,"id":"ContainerConfig-bcb137f4-4082-4776-88ce-a2a611eb832b"}},{"type":"NewsListConfig","props":{"id":"NewsListConfig-a2ed2c43-2386-47ee-8c08-ceab3b358c73","resolvedEntitiesInit":{"items":[],"page":0,"pages":0},"resolvedUploadPrefix":"/uploads","category":"student-life"}},{"type":"AnonymousQuoteConfig","props":{"quote":"In 15 years, my classmates will be entrepreneurs, scientists, and people making their mark in every kind of field. I can't wait to see what that future will look like.","id":"AnonymousQuoteConfig-91336cda-92e8-4a86-aeb0-5ea788711003"}},{"type":"ContainerConfig","props":{"children":[{"type":"ButtonConfig","props":{"text":"Learn more about admissions at BAID","link":"/admissions","blank":false,"color":"blue","size":"md","align":"center","id":"ButtonConfig-6fcbd0f1-0bb8-487f-9ab7-e3350c02dc0f"}}],"contentWidth":true,"id":"ContainerConfig-286ed04c-916f-4190-8efa-f15c4128929b"}},{"type":"SpacerConfig","props":{"height":"5rem","id":"SpacerConfig-b3ab2a97-405e-4ed2-95f4-37bbcf3ea943"}}],"zones":{}}	{"root":{"props":{"title":"学生生活"},"type":"root"},"content":[{"type":"HeroConfig","props":{"title":"Life @ BAID","backgroundColor":"#9f0612","lightText":true,"id":"HeroConfig-2ff512a4-395b-4fe4-98d7-1222bd2ad56d","resolvedImage":{"id":64,"sha1":"15f6901d80775583c340abba2d020f0ce28fbeb6","name":"Life at BAID","altText":"People playing football on the playground","width":3976,"height":2652,"sizeKB":431,"uploaderId":3406762,"createdAt":"2025-12-22T13:05:12.808Z"},"resolvedUploadPrefix":"/uploads","image":"64","topPadding":true}},{"type":"SpacerConfig","props":{"height":"5rem","id":"SpacerConfig-1efe85f8-ceeb-4b87-a48d-4269f4992e3f"}},{"type":"TopTextConfig","props":{"title":"享受人生的青葱岁月","text":"BAID 很懂学术，这本来就是我们的拿手项。不过，校园生活可远不止这些。我们的项目、社团、球队—当然还有朋友—把每天都过得热热闹闹，充满一起相处的快乐和归属感。","to":"","linkText":"","id":"TopTextConfig-7e613c0a-c6de-4dfd-ae18-10eecff965e9"}},{"type":"SpacerConfig","props":{"height":"5rem","id":"SpacerConfig-2f0aaed8-28e3-440f-b30a-d50d2f2e8b0d"}},{"type":"HighlightsConfig","props":{"id":"HighlightsConfig-ecfd2806-53d9-41ea-95ab-f4e35baa1f81","resolvedHighlights":[{"title":"社团","text":"有 50 多个由学生主导的社团和组织，唯一的难题就是该选哪一个。","image":{"id":61,"sha1":"aa7cee5aa085f8478b0287b3615fe7ab61a0800e","name":"Career Exploraton","altText":"Career","width":1080,"height":721,"sizeKB":42,"uploaderId":3406762,"createdAt":"2025-12-22T12:50:31.021Z"},"link":"/life/clubs","linkText":"社团"},{"title":"选修课","text":"40 多门选修课，由来自各行各业的人开设。机器人、艺术、科学、文化… 总有你会喜欢的!","image":{"id":59,"sha1":"dfdbae4816a16dd1a41563aac9cf52ecfdf204ee","name":"BA Lectures","altText":"olympics gold medalist Yang Yang at an event","width":1080,"height":720,"sizeKB":68,"uploaderId":3406762,"createdAt":"2025-12-22T12:49:50.419Z"},"link":"/life/electives","linkText":"选修课"},{"title":"自主项目","text":"\\"世界因我更美好\\" 是我们的校训，也是每一位 BAID 学子的行动准则。","image":{"id":65,"sha1":"29587e370b2cc9463b8858e7c81b0f51418f5759","name":"Student Projects","altText":"BAID students' ocean protection project","width":1920,"height":1039,"sizeKB":102,"uploaderId":3406762,"createdAt":"2025-12-22T13:31:36.244Z"},"link":"/projects","linkText":"自主项目"}],"resolvedUploadPrefix":"/uploads","highlights":[{"title":"社团","link":"/life/clubs","linkText":"社团","image":"61","text":"有 50 多个由学生主导的社团和组织，唯一的难题就是该选哪一个。"},{"title":"选修课","link":"/life/electives","linkText":"选修课","image":"59","text":"40 多门选修课，由来自各行各业的人开设。机器人、艺术、科学、文化… 总有你会喜欢的!"},{"title":"自主项目","link":"/projects","linkText":"自主项目","image":"65","text":"\\"世界因我更美好\\" 是我们的校训，也是每一位 BAID 学子的行动准则。"}]}},{"type":"SpacerConfig","props":{"height":"3rem","id":"SpacerConfig-852b409b-9f5f-4398-a578-d4bed0a18a57"}},{"type":"HighlightsConfig","props":{"id":"HighlightsConfig-3a4f57b9-3a33-497b-ac34-ce42052b4a2f","resolvedHighlights":[{"title":"用餐","text":"我们可太爱吃了! 三家餐厅、两家咖啡馆，再加上各种各样的选择，怎么都不可能饿着。","image":{"id":62,"sha1":"073e82273837daeeaeec0f2e8a4603b962cbb875","name":"BA World School","altText":"Test","width":1280,"height":960,"sizeKB":316,"uploaderId":3406762,"createdAt":"2025-12-22T12:50:43.209Z"},"link":"/life/dining","linkText":"用餐"},{"title":"运动","text":"网球、棒球、体能、足球、篮球、舞蹈、排球、射箭……去尝试一项新运动，或者参与你本来就喜欢的—总有一项适合你。","image":{"id":64,"sha1":"15f6901d80775583c340abba2d020f0ce28fbeb6","name":"Life at BAID","altText":"People playing football on the playground","width":3976,"height":2652,"sizeKB":431,"uploaderId":3406762,"createdAt":"2025-12-22T13:05:12.808Z"},"link":"/life/athletics","linkText":"运动"},{"title":"校园活动","text":"北中小讲师、北中小舞台，还有大地课程、阅历课程—在表达、在探索，也在一点点走近自然、走近文化。","image":{"id":60,"sha1":"9cfa20529bb0b0d4037f790528b1045ad23b49a2","name":"Experental Program","altText":"Test","width":800,"height":600,"sizeKB":129,"uploaderId":3406762,"createdAt":"2025-12-22T12:50:17.892Z"},"link":"/life/activities","linkText":"校园活动"}],"resolvedUploadPrefix":"/uploads","highlights":[{"title":"用餐","text":"我们可太爱吃了! 三家餐厅、两家咖啡馆，再加上各种各样的选择，怎么都不可能饿着。","link":"/life/dining","linkText":"用餐","image":"62"},{"title":"运动","link":"/life/athletics","linkText":"运动","image":"64","text":"网球、棒球、体能、足球、篮球、舞蹈、排球、射箭……去尝试一项新运动，或者参与你本来就喜欢的—总有一项适合你。"},{"title":"校园活动","link":"/life/activities","linkText":"校园活动","image":"60","text":"北中小讲师、北中小舞台，还有大地课程、阅历课程—在表达、在探索，也在一点点走近自然、走近文化。"}]}},{"type":"SpacerConfig","props":{"height":"5rem","id":"SpacerConfig-7ccfc091-03de-476a-9b32-503658b1e169"}},{"type":"ImageGalleryConfig","props":{"title":"图片轮播","slides":[{"title":"北京中学本部","content":"2025 年 9 月启用的北京中学本部占地约 5 万平方米，由 11 栋以北京地名命名、错落有致的楼宇组成。教学、活动与生活在这里自然衔接，走在校园里，每一步都能感受到它的尺度与秩序，也能慢慢熟悉属于自己的那一方角落。","image":"83"},{"image":"85","title":"北京中学本部","content":"2025 年 9 月启用的北京中学本部占地约 5 万平方米，由 11 栋以北京地名命名、错落有致的楼宇组成。教学、活动与生活在这里自然衔接，走在校园里，每一步都能感受到它的尺度与秩序，也能慢慢熟悉属于自己的那一方角落。"},{"image":"84","content":"“世界因我更美好” 是北京中学每一位学生的行动方向。从关注身边的人与事出发，在一次次真实的服务与实践中，理解责任、学会付出。我们的学生在不断尝试与反思中，逐步形成面向社会的担当意识，用具体行动为他人带来改变。\\n","title":"世界因我更美好"}],"id":"ImageGalleryConfig-ee46552b-82e9-41ee-96ed-732d2a3c957e","resolvedSlides":[{"title":"北京中学本部","content":"2025 年 9 月启用的北京中学本部占地约 5 万平方米，由 11 栋以北京地名命名、错落有致的楼宇组成。教学、活动与生活在这里自然衔接，走在校园里，每一步都能感受到它的尺度与秩序，也能慢慢熟悉属于自己的那一方角落。","image":{"id":83,"sha1":"fcce2b7adbc66a53c773f522b686cafbf3562794","name":"北京中学本部效果图","altText":"显示了北京中学本部样式","width":1222,"height":864,"sizeKB":199,"uploaderId":3406762,"createdAt":"2026-04-01T02:47:43.075Z"}},{"title":"北京中学本部","content":"2025 年 9 月启用的北京中学本部占地约 5 万平方米，由 11 栋以北京地名命名、错落有致的楼宇组成。教学、活动与生活在这里自然衔接，走在校园里，每一步都能感受到它的尺度与秩序，也能慢慢熟悉属于自己的那一方角落。","image":{"id":85,"sha1":"0f6713c1ec24e92ee752d69cd5e932a2425e3e67","name":"校园一角","altText":"绿荫草地中的校园一角","width":2560,"height":1708,"sizeKB":368,"uploaderId":3406762,"createdAt":"2026-04-01T02:53:30.941Z"}},{"title":"世界因我更美好","content":"“世界因我更美好” 是北京中学每一位学生的行动方向。从关注身边的人与事出发，在一次次真实的服务与实践中，理解责任、学会付出。我们的学生在不断尝试与反思中，逐步形成面向社会的担当意识，用具体行动为他人带来改变。\\n","image":{"id":84,"sha1":"73f1b4ce105d507b82bdab99c363a2d9994b9564","name":"世界因我更美好","altText":"一块显示了「世界因我更美好」的石碑","width":2000,"height":1333,"sizeKB":490,"uploaderId":3406762,"createdAt":"2026-04-01T02:49:50.252Z"}}],"resolvedUploadPrefix":"/uploads"}},{"type":"SpacerConfig","props":{"height":"5rem","id":"SpacerConfig-09b4cf74-8a18-46be-8c17-1b5b0145b195"}},{"type":"ContainerConfig","props":{"children":[{"type":"HeadingConfig","props":{"level":2,"size":"4xl","align":"center","bold":true,"italic":false,"color":"#000000","id":"HeadingConfig-ab292a9b-2199-4e48-b739-edfbe8b06612","text":"校园生活"}}],"contentWidth":true,"id":"ContainerConfig-bcb137f4-4082-4776-88ce-a2a611eb832b"}},{"type":"NewsListConfig","props":{"id":"NewsListConfig-a2ed2c43-2386-47ee-8c08-ceab3b358c73","resolvedEntitiesInit":{"items":[],"page":0,"pages":0},"resolvedUploadPrefix":"/uploads","category":"student-life"}},{"type":"AnonymousQuoteConfig","props":{"quote":"15 年后，我的同学们会成为企业家、科学家，也会成为各行各业的很多人，我很期待看到那会是一番什么样的景象。","id":"AnonymousQuoteConfig-91336cda-92e8-4a86-aeb0-5ea788711003"}},{"type":"ContainerConfig","props":{"children":[{"type":"ButtonConfig","props":{"text":"了解 BAID 的招生项目","link":"/admissions","blank":false,"color":"blue","size":"md","align":"center","id":"ButtonConfig-6fcbd0f1-0bb8-487f-9ab7-e3350c02dc0f"}}],"contentWidth":true,"id":"ContainerConfig-286ed04c-916f-4190-8efa-f15c4128929b"}},{"type":"SpacerConfig","props":{"height":"5rem","id":"SpacerConfig-b3ab2a97-405e-4ed2-95f4-37bbcf3ea943"}}],"zones":{}}	{"root":{"props":{"title":"Life @ BAID"},"type":"root"},"content":[{"type":"HeroConfig","props":{"title":"Life @ BAID","backgroundColor":"#9f0612","lightText":true,"id":"HeroConfig-2ff512a4-395b-4fe4-98d7-1222bd2ad56d","resolvedImage":{"id":64,"sha1":"15f6901d80775583c340abba2d020f0ce28fbeb6","name":"Life at BAID","altText":"People playing football on the playground","width":3976,"height":2652,"sizeKB":431,"uploaderId":3406762,"createdAt":"2025-12-22T13:05:12.808Z"},"resolvedUploadPrefix":"/uploads","image":"64","topPadding":true}},{"type":"SpacerConfig","props":{"height":"5rem","id":"SpacerConfig-1efe85f8-ceeb-4b87-a48d-4269f4992e3f"}},{"type":"TopTextConfig","props":{"title":"Live the best years of your life","text":" BAID knows academics well—it's kind of our thing. But life here goes far beyond the classroom. Projects, clubs, teams—and of course our friends—fill each day with energy, connection, and the kind of community that makes school life the best years of your life.","to":"","linkText":"","id":"TopTextConfig-7e613c0a-c6de-4dfd-ae18-10eecff965e9"}},{"type":"SpacerConfig","props":{"height":"5rem","id":"SpacerConfig-2f0aaed8-28e3-440f-b30a-d50d2f2e8b0d"}},{"type":"HighlightsConfig","props":{"id":"HighlightsConfig-ecfd2806-53d9-41ea-95ab-f4e35baa1f81","resolvedHighlights":[{"title":"Clubs","text":"With more than 50 student-led clubs and organizations, the only hard part is choosing.","image":{"id":61,"sha1":"aa7cee5aa085f8478b0287b3615fe7ab61a0800e","name":"Career Exploraton","altText":"Career","width":1080,"height":721,"sizeKB":42,"uploaderId":3406762,"createdAt":"2025-12-22T12:50:31.021Z"},"link":"/life/clubs","linkText":"Clubs"},{"title":"Electives","text":"More than 40 electives, taught by people from all walks of life. Robotics, art, science, culture… there is always something to love.","image":{"id":59,"sha1":"dfdbae4816a16dd1a41563aac9cf52ecfdf204ee","name":"BA Lectures","altText":"olympics gold medalist Yang Yang at an event","width":1080,"height":720,"sizeKB":68,"uploaderId":3406762,"createdAt":"2025-12-22T12:49:50.419Z"},"link":"/life/electives","linkText":"Electives"},{"title":"Student Projects","text":"\\"Better me, better world\\" is our motto—and a call to action for every BAID student.","image":{"id":65,"sha1":"29587e370b2cc9463b8858e7c81b0f51418f5759","name":"Student Projects","altText":"BAID students' ocean protection project","width":1920,"height":1039,"sizeKB":102,"uploaderId":3406762,"createdAt":"2025-12-22T13:31:36.244Z"},"link":"/projects","linkText":"Projects Gallery"}],"resolvedUploadPrefix":"/uploads","highlights":[{"title":"Clubs","link":"/life/clubs","linkText":"Clubs","image":"61","text":"With more than 50 student-led clubs and organizations, the only hard part is choosing."},{"title":"Electives","link":"/life/electives","linkText":"Electives","image":"59","text":"More than 40 electives, taught by people from all walks of life. Robotics, art, science, culture… there is always something to love."},{"title":"Student Projects","link":"/projects","linkText":"Projects Gallery","image":"65","text":"\\"Better me, better world\\" is our motto—and a call to action for every BAID student."}]}},{"type":"SpacerConfig","props":{"height":"3rem","id":"SpacerConfig-852b409b-9f5f-4398-a578-d4bed0a18a57"}},{"type":"HighlightsConfig","props":{"id":"HighlightsConfig-3a4f57b9-3a33-497b-ac34-ce42052b4a2f","resolvedHighlights":[{"title":"Dining","text":"We really, really love food. With three dining halls, two cafés, and plenty of choices in between, you will never go hungry.","image":{"id":62,"sha1":"073e82273837daeeaeec0f2e8a4603b962cbb875","name":"BA World School","altText":"Test","width":1280,"height":960,"sizeKB":316,"uploaderId":3406762,"createdAt":"2025-12-22T12:50:43.209Z"},"link":"/life/dining","linkText":"Dining"},{"title":"Athletics","text":"Tennis, baseball, gym, soccer, basketball, dance, volleyball, archery… try something new, or keep doing what you already love—there's always a sport for you.","image":{"id":64,"sha1":"15f6901d80775583c340abba2d020f0ce28fbeb6","name":"Life at BAID","altText":"People playing football on the playground","width":3976,"height":2652,"sizeKB":431,"uploaderId":3406762,"createdAt":"2025-12-22T13:05:12.808Z"},"link":"/life/athletics","linkText":"Athletics"},{"title":"Activities","text":"BAID Speaker, BAID Stage, Into Nature, and experiential courses—these are spaces for expression, exploration, and getting a little closer to nature and culture along the way.","image":{"id":60,"sha1":"9cfa20529bb0b0d4037f790528b1045ad23b49a2","name":"Experental Program","altText":"Test","width":800,"height":600,"sizeKB":129,"uploaderId":3406762,"createdAt":"2025-12-22T12:50:17.892Z"},"link":"/life/activities","linkText":"Activities"}],"resolvedUploadPrefix":"/uploads","highlights":[{"title":"Dining","text":"We really, really love food. With three dining halls, two cafés, and plenty of choices in between, you will never go hungry.","link":"/life/dining","linkText":"Dining","image":"62"},{"title":"Athletics","link":"/life/athletics","linkText":"Athletics","image":"64","text":"Tennis, baseball, gym, soccer, basketball, dance, volleyball, archery… try something new, or keep doing what you already love—there's always a sport for you."},{"title":"Activities","link":"/life/activities","linkText":"Activities","image":"60","text":"BAID Speaker, BAID Stage, Into Nature, and experiential courses—these are spaces for expression, exploration, and getting a little closer to nature and culture along the way."}]}},{"type":"SpacerConfig","props":{"height":"5rem","id":"SpacerConfig-7ccfc091-03de-476a-9b32-503658b1e169"}},{"type":"ImageGalleryConfig","props":{"title":"Image Slideshow","slides":[{"title":"Beijing Academy Main Campus","content":"Opened in September 2025, the main campus of Beijing Academy spans approximately 50,000 square meters and is made up of 11 beautifully arranged buildings, each named after a place in Beijing. Here, learning, activity, and daily life flow naturally together. With every step across campus, students can feel its openness and rhythm—and slowly find a corner that feels like their own.","image":"83"},{"image":"85","content":"Opened in September 2025, the main campus of Beijing Academy spans approximately 50,000 square meters and is made up of 11 beautifully arranged buildings, each named after a place in Beijing. Here, learning, activity, and daily life flow naturally together. With every step across campus, students can feel its openness and rhythm—and slowly find a corner that feels like their own.","title":"Beijing Academy Main Campus"},{"image":"84","title":"Better Me, Better World","content":"\\"Better me, better world\\" is the direction that guides every Beijing Academy student. It begins with attention to the people and needs around us, and grows through real service and real action. Through experience, reflection, and effort, students come to understand responsibility, learn to contribute, and make a true difference in the lives of others."}],"id":"ImageGalleryConfig-ee46552b-82e9-41ee-96ed-732d2a3c957e","resolvedSlides":[{"title":"Beijing Academy Main Campus","content":"Opened in September 2025, the main campus of Beijing Academy spans approximately 50,000 square meters and is made up of 11 beautifully arranged buildings, each named after a place in Beijing. Here, learning, activity, and daily life flow naturally together. With every step across campus, students can feel its openness and rhythm—and slowly find a corner that feels like their own.","image":{"id":83,"sha1":"fcce2b7adbc66a53c773f522b686cafbf3562794","name":"北京中学本部效果图","altText":"显示了北京中学本部样式","width":1222,"height":864,"sizeKB":199,"uploaderId":3406762,"createdAt":"2026-04-01T02:47:43.075Z"}},{"title":"Beijing Academy Main Campus","content":"Opened in September 2025, the main campus of Beijing Academy spans approximately 50,000 square meters and is made up of 11 beautifully arranged buildings, each named after a place in Beijing. Here, learning, activity, and daily life flow naturally together. With every step across campus, students can feel its openness and rhythm—and slowly find a corner that feels like their own.","image":{"id":85,"sha1":"0f6713c1ec24e92ee752d69cd5e932a2425e3e67","name":"校园一角","altText":"绿荫草地中的校园一角","width":2560,"height":1708,"sizeKB":368,"uploaderId":3406762,"createdAt":"2026-04-01T02:53:30.941Z"}},{"title":"Better Me, Better World","content":"\\"Better me, better world\\" is the direction that guides every Beijing Academy student. It begins with attention to the people and needs around us, and grows through real service and real action. Through experience, reflection, and effort, students come to understand responsibility, learn to contribute, and make a true difference in the lives of others.","image":{"id":84,"sha1":"73f1b4ce105d507b82bdab99c363a2d9994b9564","name":"世界因我更美好","altText":"一块显示了「世界因我更美好」的石碑","width":2000,"height":1333,"sizeKB":490,"uploaderId":3406762,"createdAt":"2026-04-01T02:49:50.252Z"}}],"resolvedUploadPrefix":"/uploads"}},{"type":"SpacerConfig","props":{"height":"5rem","id":"SpacerConfig-09b4cf74-8a18-46be-8c17-1b5b0145b195"}},{"type":"ContainerConfig","props":{"children":[{"type":"HeadingConfig","props":{"level":2,"size":"4xl","align":"center","bold":true,"italic":false,"color":"#000000","id":"HeadingConfig-ab292a9b-2199-4e48-b739-edfbe8b06612","text":"Campus Life"}}],"contentWidth":true,"id":"ContainerConfig-bcb137f4-4082-4776-88ce-a2a611eb832b"}},{"type":"NewsListConfig","props":{"id":"NewsListConfig-a2ed2c43-2386-47ee-8c08-ceab3b358c73","resolvedEntitiesInit":{"items":[],"page":0,"pages":0},"resolvedUploadPrefix":"/uploads","category":"student-life"}},{"type":"AnonymousQuoteConfig","props":{"quote":"In 15 years, my classmates will be entrepreneurs, scientists, and people making their mark in every kind of field. I can't wait to see what that future will look like.","id":"AnonymousQuoteConfig-91336cda-92e8-4a86-aeb0-5ea788711003"}},{"type":"ContainerConfig","props":{"children":[{"type":"ButtonConfig","props":{"text":"Learn more about admissions at BAID","link":"/admissions","blank":false,"color":"blue","size":"md","align":"center","id":"ButtonConfig-6fcbd0f1-0bb8-487f-9ab7-e3350c02dc0f"}}],"contentWidth":true,"id":"ContainerConfig-286ed04c-916f-4190-8efa-f15c4128929b"}},{"type":"SpacerConfig","props":{"height":"5rem","id":"SpacerConfig-b3ab2a97-405e-4ed2-95f4-37bbcf3ea943"}}],"zones":{}}	{"root":{"props":{"title":"学生生活"},"type":"root"},"content":[{"type":"HeroConfig","props":{"title":"Life @ BAID","backgroundColor":"#9f0612","lightText":true,"id":"HeroConfig-2ff512a4-395b-4fe4-98d7-1222bd2ad56d","resolvedImage":{"id":64,"sha1":"15f6901d80775583c340abba2d020f0ce28fbeb6","name":"Life at BAID","altText":"People playing football on the playground","width":3976,"height":2652,"sizeKB":431,"uploaderId":3406762,"createdAt":"2025-12-22T13:05:12.808Z"},"resolvedUploadPrefix":"/uploads","image":"64","topPadding":true}},{"type":"SpacerConfig","props":{"height":"5rem","id":"SpacerConfig-1efe85f8-ceeb-4b87-a48d-4269f4992e3f"}},{"type":"TopTextConfig","props":{"title":"享受人生的青葱岁月","text":"BAID 很懂学术，这本来就是我们的拿手项。不过，校园生活可远不止这些。我们的项目、社团、球队—当然还有朋友—把每天都过得热热闹闹，充满一起相处的快乐和归属感。","to":"","linkText":"","id":"TopTextConfig-7e613c0a-c6de-4dfd-ae18-10eecff965e9"}},{"type":"SpacerConfig","props":{"height":"5rem","id":"SpacerConfig-2f0aaed8-28e3-440f-b30a-d50d2f2e8b0d"}},{"type":"HighlightsConfig","props":{"id":"HighlightsConfig-ecfd2806-53d9-41ea-95ab-f4e35baa1f81","resolvedHighlights":[{"title":"社团","text":"有 50 多个由学生主导的社团和组织，唯一的难题就是该选哪一个。","image":{"id":61,"sha1":"aa7cee5aa085f8478b0287b3615fe7ab61a0800e","name":"Career Exploraton","altText":"Career","width":1080,"height":721,"sizeKB":42,"uploaderId":3406762,"createdAt":"2025-12-22T12:50:31.021Z"},"link":"/life/clubs","linkText":"社团"},{"title":"选修课","text":"40 多门选修课，由来自各行各业的人开设。机器人、艺术、科学、文化… 总有你会喜欢的!","image":{"id":59,"sha1":"dfdbae4816a16dd1a41563aac9cf52ecfdf204ee","name":"BA Lectures","altText":"olympics gold medalist Yang Yang at an event","width":1080,"height":720,"sizeKB":68,"uploaderId":3406762,"createdAt":"2025-12-22T12:49:50.419Z"},"link":"/life/electives","linkText":"选修课"},{"title":"自主项目","text":"\\"世界因我更美好\\" 是我们的校训，也是每一位 BAID 学子的行动准则。","image":{"id":65,"sha1":"29587e370b2cc9463b8858e7c81b0f51418f5759","name":"Student Projects","altText":"BAID students' ocean protection project","width":1920,"height":1039,"sizeKB":102,"uploaderId":3406762,"createdAt":"2025-12-22T13:31:36.244Z"},"link":"/projects","linkText":"自主项目"}],"resolvedUploadPrefix":"/uploads","highlights":[{"title":"社团","link":"/life/clubs","linkText":"社团","image":"61","text":"有 50 多个由学生主导的社团和组织，唯一的难题就是该选哪一个。"},{"title":"选修课","link":"/life/electives","linkText":"选修课","image":"59","text":"40 多门选修课，由来自各行各业的人开设。机器人、艺术、科学、文化… 总有你会喜欢的!"},{"title":"自主项目","link":"/projects","linkText":"自主项目","image":"65","text":"\\"世界因我更美好\\" 是我们的校训，也是每一位 BAID 学子的行动准则。"}]}},{"type":"SpacerConfig","props":{"height":"3rem","id":"SpacerConfig-852b409b-9f5f-4398-a578-d4bed0a18a57"}},{"type":"HighlightsConfig","props":{"id":"HighlightsConfig-3a4f57b9-3a33-497b-ac34-ce42052b4a2f","resolvedHighlights":[{"title":"用餐","text":"我们可太爱吃了! 三家餐厅、两家咖啡馆，再加上各种各样的选择，怎么都不可能饿着。","image":{"id":62,"sha1":"073e82273837daeeaeec0f2e8a4603b962cbb875","name":"BA World School","altText":"Test","width":1280,"height":960,"sizeKB":316,"uploaderId":3406762,"createdAt":"2025-12-22T12:50:43.209Z"},"link":"/life/dining","linkText":"用餐"},{"title":"运动","text":"网球、棒球、体能、足球、篮球、舞蹈、排球、射箭……去尝试一项新运动，或者参与你本来就喜欢的—总有一项适合你。","image":{"id":64,"sha1":"15f6901d80775583c340abba2d020f0ce28fbeb6","name":"Life at BAID","altText":"People playing football on the playground","width":3976,"height":2652,"sizeKB":431,"uploaderId":3406762,"createdAt":"2025-12-22T13:05:12.808Z"},"link":"/life/athletics","linkText":"运动"},{"title":"校园活动","text":"北中小讲师、北中小舞台，还有大地课程、阅历课程—在表达、在探索，也在一点点走近自然、走近文化。","image":{"id":60,"sha1":"9cfa20529bb0b0d4037f790528b1045ad23b49a2","name":"Experental Program","altText":"Test","width":800,"height":600,"sizeKB":129,"uploaderId":3406762,"createdAt":"2025-12-22T12:50:17.892Z"},"link":"/life/activities","linkText":"校园活动"}],"resolvedUploadPrefix":"/uploads","highlights":[{"title":"用餐","text":"我们可太爱吃了! 三家餐厅、两家咖啡馆，再加上各种各样的选择，怎么都不可能饿着。","link":"/life/dining","linkText":"用餐","image":"62"},{"title":"运动","link":"/life/athletics","linkText":"运动","image":"64","text":"网球、棒球、体能、足球、篮球、舞蹈、排球、射箭……去尝试一项新运动，或者参与你本来就喜欢的—总有一项适合你。"},{"title":"校园活动","link":"/life/activities","linkText":"校园活动","image":"60","text":"北中小讲师、北中小舞台，还有大地课程、阅历课程—在表达、在探索，也在一点点走近自然、走近文化。"}]}},{"type":"SpacerConfig","props":{"height":"5rem","id":"SpacerConfig-7ccfc091-03de-476a-9b32-503658b1e169"}},{"type":"ImageGalleryConfig","props":{"title":"图片轮播","slides":[{"title":"北京中学本部","content":"2025 年 9 月启用的北京中学本部占地约 5 万平方米，由 11 栋以北京地名命名、错落有致的楼宇组成。教学、活动与生活在这里自然衔接，走在校园里，每一步都能感受到它的尺度与秩序，也能慢慢熟悉属于自己的那一方角落。","image":"83"},{"image":"85","title":"北京中学本部","content":"2025 年 9 月启用的北京中学本部占地约 5 万平方米，由 11 栋以北京地名命名、错落有致的楼宇组成。教学、活动与生活在这里自然衔接，走在校园里，每一步都能感受到它的尺度与秩序，也能慢慢熟悉属于自己的那一方角落。"},{"image":"84","content":"“世界因我更美好” 是北京中学每一位学生的行动方向。从关注身边的人与事出发，在一次次真实的服务与实践中，理解责任、学会付出。我们的学生在不断尝试与反思中，逐步形成面向社会的担当意识，用具体行动为他人带来改变。\\n","title":"世界因我更美好"}],"id":"ImageGalleryConfig-ee46552b-82e9-41ee-96ed-732d2a3c957e","resolvedSlides":[{"title":"北京中学本部","content":"2025 年 9 月启用的北京中学本部占地约 5 万平方米，由 11 栋以北京地名命名、错落有致的楼宇组成。教学、活动与生活在这里自然衔接，走在校园里，每一步都能感受到它的尺度与秩序，也能慢慢熟悉属于自己的那一方角落。","image":{"id":83,"sha1":"fcce2b7adbc66a53c773f522b686cafbf3562794","name":"北京中学本部效果图","altText":"显示了北京中学本部样式","width":1222,"height":864,"sizeKB":199,"uploaderId":3406762,"createdAt":"2026-04-01T02:47:43.075Z"}},{"title":"北京中学本部","content":"2025 年 9 月启用的北京中学本部占地约 5 万平方米，由 11 栋以北京地名命名、错落有致的楼宇组成。教学、活动与生活在这里自然衔接，走在校园里，每一步都能感受到它的尺度与秩序，也能慢慢熟悉属于自己的那一方角落。","image":{"id":85,"sha1":"0f6713c1ec24e92ee752d69cd5e932a2425e3e67","name":"校园一角","altText":"绿荫草地中的校园一角","width":2560,"height":1708,"sizeKB":368,"uploaderId":3406762,"createdAt":"2026-04-01T02:53:30.941Z"}},{"title":"世界因我更美好","content":"“世界因我更美好” 是北京中学每一位学生的行动方向。从关注身边的人与事出发，在一次次真实的服务与实践中，理解责任、学会付出。我们的学生在不断尝试与反思中，逐步形成面向社会的担当意识，用具体行动为他人带来改变。\\n","image":{"id":84,"sha1":"73f1b4ce105d507b82bdab99c363a2d9994b9564","name":"世界因我更美好","altText":"一块显示了「世界因我更美好」的石碑","width":2000,"height":1333,"sizeKB":490,"uploaderId":3406762,"createdAt":"2026-04-01T02:49:50.252Z"}}],"resolvedUploadPrefix":"/uploads"}},{"type":"SpacerConfig","props":{"height":"5rem","id":"SpacerConfig-09b4cf74-8a18-46be-8c17-1b5b0145b195"}},{"type":"ContainerConfig","props":{"children":[{"type":"HeadingConfig","props":{"level":2,"size":"4xl","align":"center","bold":true,"italic":false,"color":"#000000","id":"HeadingConfig-ab292a9b-2199-4e48-b739-edfbe8b06612","text":"校园生活"}}],"contentWidth":true,"id":"ContainerConfig-bcb137f4-4082-4776-88ce-a2a611eb832b"}},{"type":"NewsListConfig","props":{"id":"NewsListConfig-a2ed2c43-2386-47ee-8c08-ceab3b358c73","resolvedEntitiesInit":{"items":[],"page":0,"pages":0},"resolvedUploadPrefix":"/uploads","category":"student-life"}},{"type":"AnonymousQuoteConfig","props":{"quote":"15 年后，我的同学们会成为企业家、科学家，也会成为各行各业的很多人，我很期待看到那会是一番什么样的景象。","id":"AnonymousQuoteConfig-91336cda-92e8-4a86-aeb0-5ea788711003"}},{"type":"ContainerConfig","props":{"children":[{"type":"ButtonConfig","props":{"text":"了解 BAID 的招生项目","link":"/admissions","blank":false,"color":"blue","size":"md","align":"center","id":"ButtonConfig-6fcbd0f1-0bb8-487f-9ab7-e3350c02dc0f"}}],"contentWidth":true,"id":"ContainerConfig-286ed04c-916f-4190-8efa-f15c4128929b"}},{"type":"SpacerConfig","props":{"height":"5rem","id":"SpacerConfig-b3ab2a97-405e-4ed2-95f4-37bbcf3ea943"}}],"zones":{}}	\N	\N	3406762	2025-12-22 13:04:42.42	2026-04-05 03:55:22.509	\N	\N	\N	\N	\N	\N
