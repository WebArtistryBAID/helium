tedAt":{}},"creator":{"id":3406762,"name":"蔺东来 Lin","pinyin":"Lin Donglai","roles":["admin","writer","editor"],"type":"student","gender":"male","createdAt":{},"updatedAt":{}},"createdAt":{},"updatedAt":{}}},"title":"某一位教师"}]}}],"contentWidth":true,"id":"ContainerConfig-6662057a-5709-4639-84a8-6083467da430"}},{"type":"SpacerConfig","props":{"height":"64px","id":"SpacerConfig-673557ea-0d76-4658-8ba9-0fbeaf628235"}},{"type":"ImageTextLayoutConfig","props":{"lightText":true,"inverseOrder":false,"id":"ImageTextLayoutConfig-40df52cf-e9ff-46bc-aa36-13ae4601821b","resolvedImage":{"id":64,"sha1":"15f6901d80775583c340abba2d020f0ce28fbeb6","name":"Life at BAID","altText":"People playing football on the playground","width":3976,"height":2652,"sizeKB":431,"uploaderId":3406762,"createdAt":"2025-12-22T13:05:12.808Z"},"resolvedUploadPrefix":"/uploads","image":"64","backgroundColor":"#103c74","topText":"9 年级至 11 年级","title":"大学升学讲座","text":"从 9 年级起，BAID 为学生系统开设大学升学讲座，由各班指定的升学指导老师每周开展，讲座内容涵盖大学申请制度、课程与活动规划、专业探索、文书写作等多个方面，支持学生在不同阶段做好充分准备。学校也定期邀请知名大学招生官和资深升学指导老师走进校园，举办家长课堂，帮助家庭更全面地理解升学过程。"}},{"type":"ImageTextLayoutConfig","props":{"lightText":true,"inverseOrder":true,"id":"ImageTextLayoutConfig-6324bef1-dc1a-4b53-ae99-c642fcb0d0be","resolvedImage":{"id":58,"sha1":"bf11bcc1a751cd8727e990649683c7963fffb0ca","name":"Academics Hero","altText":"People studying around a table","width":3000,"height":2000,"sizeKB":172,"uploaderId":3406762,"createdAt":"2025-12-22T12:44:30.095Z"},"resolvedUploadPrefix":"/uploads","backgroundColor":"#9f0612","image":"58","topText":"9 年级至 11 年级","title":"一对一升学约谈","text":"每学期，升学指导老师都会与每一个家庭进行一对一约谈，结合学生的学业表现、活动经历、兴趣方向与发展目标，细致分析申请资料的特点与提升空间。通过持续、个性化的沟通，帮助学生明确下一阶段的规划重点，更有针对性地完善申请准备。"}},{"type":"ImageTextLayoutConfig","props":{"lightText":false,"inverseOrder":false,"id":"ImageTextLayoutConfig-29eb1175-bb2e-4878-9528-efe3d87a788b","resolvedImage":{"id":63,"sha1":"eca52c9f86f2410f111503f970426e6a0c2bd94b","name":"Bejng Culture Exploration Program","altText":"Test","width":1280,"height":853,"sizeKB":85,"uploaderId":3406762,"createdAt":"2025-12-22T12:50:56.539Z"},"resolvedUploadPrefix":"/uploads","topText":"9 年级至 11 年级","image":"63","title":"标准化考试支持","text":"每位同学都可参加「综合英语」课程，在专业教师指导下有针对性地备考托福、SAT 与 ACT 考试。课程将语言能力提升与考试训练有机结合，帮助学生在校内高效备考，更从容地迎接各项标准化考试。"}},{"type":"ImageTextLayoutConfig","props":{"lightText":true,"inverseOrder":true,"id":"ImageTextLayoutConfig-fa2d46b7-6e29-456d-af64-42814af46374","resolvedImage":{"id":63,"sha1":"eca52c9f86f2410f111503f970426e6a0c2bd94b","name":"Bejng Culture Exploration Program","altText":"Test","width":1280,"height":853,"sizeKB":85,"uploaderId":3406762,"createdAt":"2025-12-22T12:50:56.539Z"},"resolvedUploadPrefix":"/uploads","backgroundColor":"#103c74","topText":"9 年级至 11 年级","title":"丰富的活动资源","image":"63","linkText":"了解 BAID 的活动资源","link":"/academics/pbl","text":"学校开设 40 余门选修课、50 余个学生社团，并通过项目式学习、学科周、阅历课程、北京文化探究、英才学者、无障碍发展 \\"未来星\\" 培养计划等多样平台，为学生创造深入探索的机会。学生也可在学委会、班级、社团和公益项目中承担责任，在持续参与中丰富个人经历，向大学展示自己独特的一面。"}},{"type":"ImageTextLayoutConfig","props":{"lightText":true,"inverseOrder":false,"id":"ImageTextLayoutConfig-ea698bb2-93bf-4f30-aea2-8a00f1d95f63","resolvedImage":{"id":62,"sha1":"073e82273837daeeaeec0f2e8a4603b962cbb875","name":"BA World School","altText":"Test","width":1280,"height":960,"sizeKB":316,"uploaderId":3406762,"createdAt":"2025-12-22T12:50:43.209Z"},"resolvedUploadPrefix":"/uploads","topText":"11 年级至 12 年级","image":"62","backgroundColor":"#4f5b74","title":"申请季集中支持","text":"从申请年份 5 月起，每位学生都可与升学指导老师进行双向选择，进入更有针对性的申请准备阶段。在整个申请季中，学生可每周灵活约谈，与老师共同确定最终选校名单，持续完善申请文书与相关材料。升学指导老师也会在充分了解学生成长经历与个人特点的基础上，提供细致、专业的建议，并诚实地向大学推荐学生，为学生的大学申请提供有力支持。"}},{"type":"SpacerConfig","props":{"height":"5rem","id":"SpacerConfig-91fb83f5-ad12-4d59-87a6-02c10fa90d53"}},{"type":"ContainerConfig","props":{"children":[{"type":"HeadingConfig","props":{"level":1,"size":"4xl","align":"center","bold":true,"italic":false,"color":"#000000","id":"HeadingConfig-89310637-f500-428b-9a37-028ba0d292d1","text":"大学申请活动"}}],"contentWidth":true,"id":"ContainerConfig-9c58a57c-57c3-42d1-8983-1ad04cf73b23"}},{"type":"NewsListConfig","props":{"id":"NewsListConfig-2b68c040-da2d-4ecc-9550-a8f599c80bb1","resolvedEntitiesInit":{"items":[],"page":0,"pages":0},"resolvedUploadPrefix":"/uploads","category":"college-admissions"}},{"type":"SpacerConfig","props":{"height":"5rem","id":"SpacerConfig-9cf58df2-64e7-45bc-839a-85c7ce3a5cfd"}}],"zones":{}}	{"root":{"props":{"title":"College Counseling"},"type":"root"},"content":[{"type":"SpacerConfig","props":{"height":"5rem","id":"SpacerConfig-c575365b-c13f-41e1-b31a-c716a6308cc5"}},{"type":"HorizontalTopTextConfig","props":{"title":"Find the college that's right for you","text":"Where academics, life, and ambitions come together, students can discover a path that truly fits—and move forward with confidence.","id":"HorizontalTopTextConfig-5aabc7eb-d8d8-4fc4-8569-2bba5c8e11b1"}},{"type":"SpacerConfig","props":{"height":"5rem","id":"SpacerConfig-174ad903-b58b-4fcf-b74f-285bb36697df"}},{"type":"HeroConfig","props":{"title":"College Counseling","backgroundColor":"#ffffff","lightText":false,"topPadding":false,"id":"HeroConfig-753790ff-6e87-41b9-976a-ece0e306b6f1","resolvedImage":{"id":59,"sha1":"dfdbae4816a16dd1a41563aac9cf52ecfdf204ee","name":"BA Lectures","altText":"olympics gold medalist Yang Yang at an event","width":1080,"height":720,"sizeKB":68,"uploaderId":3406762,"createdAt":"2025-12-22T12:49:50.419Z"},"resolvedUploadPrefix":"/uploads","image":"59"}},{"type":"SpacerConfig","props":{"height":"64px","id":"SpacerConfig-30b4144f-2819-4caf-b975-be3d4f4088e3"}},{"type":"TopTextConfig","props":{"title":"Dream big at the universities that fit big dreams","text":"Since BAID was founded in 2017, students have received admissions offers from some of the world's leading universities, including Harvard, Stanford, the University of Pennsylvania, Caltech, Cornell, Brown, Oxford, Cambridge, the University of Melbourne, the University of Hong Kong, the University of Tokyo, and the University of Toronto.","to":"/temporary","linkText":"Our 2026 College Outcomes","id":"TopTextConfig-79a410b4-09b2-4f60-942c-4ae8a6cb737b"}},{"type":"SpacerConfig","props":{"height":"64px","id":"SpacerConfig-8947d4d0-6bea-4ace-a86f-c24867555a39"}},{"type":"ContainerConfig","props":{"children":[{"type":"HeadingConfig","props":{"level":1,"size":"4xl","align":"center","bold":true,"italic":false,"color":"#000000","id":"HeadingConfig-0c07340f-1146-4979-a4cc-78221964224c","text":"College Counseling Office"}},{"type":"SpacerConfig","props":{"height":"1.5rem","id":"SpacerConfig-c04ce276-199b-41ee-9183-544478b9aaeb"}},{"type":"PeopleConfig","props":{"id":"PeopleConfig-3980d602-7cc4-4e9f-b2cd-dcb5a2cc2b45","resolvedPeople":[{"id":35,"nameEN":"Yuan Xiaoyang","nameZH":"苑笑阳","title":"Some Teacher","descriptionEN":"Who is Yuan Xiaoyang","descriptionZH":"苑笑阳是谁","link":"","image":{"id":10,"sha1":"b32b8acdc3a560f8264489a45ab7ee48d8a4a68b","name":"xqf","altText":"xqf","width":1920,"height":2880,"sizeKB":130,"uploaderId":3406762,"createdAt":{}}},{"id":35,"nameEN":"Yuan Xiaoyang","nameZH":"苑笑阳","title":"Some Teacher","descriptionEN":"Who is Yuan Xiaoyang","descriptionZH":"苑笑阳是谁","link":"","image":{"id":10,"sha1":"b32b8acdc3a560f8264489a45ab7ee48d8a4a68b","name":"xqf","altText":"xqf","width":1920,"height":2880,"sizeKB":130,"uploaderId":3406762,"createdAt":{}}},{"id":35,"nameEN":"Yuan Xiaoyang","nameZH":"苑笑阳","title":"Some Teacher","descriptionEN":"Who is Yuan Xiaoyang","descriptionZH":"苑笑阳是谁","link":"","image":{"id":10,"sha1":"b32b8acdc3a560f8264489a45ab7ee48d8a4a68b","name":"xqf","altText":"xqf","width":1920,"height":2880,"sizeKB":130,"uploaderId":3406762,"createdAt":{}}},{"id":35,"nameEN":"Yuan Xiaoyang","nameZH":"苑笑阳","title":"Some Teacher","descriptionEN":"Who is Yuan Xiaoyang","descriptionZH":"苑笑阳是谁","link":"","image":{"id":10,"sha1":"b32b8acdc3a560f8264489a45ab7ee48d8a4a68b","name":"xqf","altText":"xqf","width":1920,"height":2880,"sizeKB":130,"uploaderId":3406762,"createdAt":{}}}]