gram)","link":"/admissions/isba","blank":false,"color":"blue","size":"md","align":"center","id":"ButtonConfig-25bd3b27-4948-416c-a58c-39c7625c3437"}}],"contentWidth":true,"id":"ContainerConfig-5892b799-8fc2-49ec-88b1-1583d2fae855"}},{"type":"SpacerConfig","props":{"height":"5rem","id":"SpacerConfig-ee434537-3f14-42ae-86fb-67391539fc3d"}},{"type":"ProgramEligibilityConfig","props":{"id":"ProgramEligibilityConfig-e12e9d06-8566-4a1b-91b3-b4a42f63b5dc"}},{"type":"ContactsConfig","props":{"title":"Contact Us","description":"We're always ready to help.","emailText":"Email:","emails":[{"text":"baid@bjacademy.com.cn"}],"phoneText":"Phone:","phones":[{"text":"+86 (10) 5095 1283"},{"text":"+86 (10) 5095 1292"},{"text":" +86 159 1052 4064 (also on WeChat)"}],"id":"ContactsConfig-a7109536-f61e-48b7-bd7e-49fea283ce50","resolvedBackgroundImage":{"id":67,"sha1":"97e9fc13e8bc414ec93c58b64d599ba5ca85b7df","name":"Buldng of Dongba Campus","altText":"Buldng of Dongba Campus","width":3840,"height":2560,"sizeKB":1108,"uploaderId":3406762,"createdAt":"2025-12-22T13:57:44.403Z"},"resolvedUploadPrefix":"/uploads","backgroundImage":"67"}}],"zones":{}}	{"root":{"props":{"title":"招生"},"type":"root"},"content":[{"type":"SpacerConfig","props":{"height":"5rem","id":"SpacerConfig-f7c849b6-67e9-4c3b-83b2-70319d595eb0"}},{"type":"HorizontalTopTextConfig","props":{"title":"加入北中","text":"书写你的故事，点亮你的热爱 — 申请 BAID，是你人生新旅程的起点。在这里，你的真实将被看见，你的独特将被珍惜。","id":"HorizontalTopTextConfig-2176290f-6c30-475e-950f-089ff41d3ed6"}},{"type":"SpacerConfig","props":{"height":"5rem","id":"SpacerConfig-ce4b2539-8913-4461-a94c-64fb59c71d5b"}},{"type":"HeroConfig","props":{"title":"Admissions","backgroundColor":"#ffffff","lightText":false,"topPadding":false,"id":"HeroConfig-5dc2d825-97f3-44ab-83c0-84b878cc0b75","resolvedImage":{"id":66,"sha1":"7a822d9377fc189c33d4b60980ca3cf841c646b8","name":"Admssons","altText":"ppl plang basketball","width":4000,"height":2667,"sizeKB":321,"uploaderId":3406762,"createdAt":"2025-12-22T13:52: